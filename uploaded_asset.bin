          targetCtx.fillStyle = col;
          targetCtx.fillRect(x, y, w, 1);
        });
        compositeLayers();
        saveHistoryState();
      }

      window.addEventListener('paste', (e) => {
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
        const items = e.clipboardData?.items;
        if (items) {
          for (let i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
              e.preventDefault();
              const blob = items[i].getAsFile();
              if (blob) {
                const reader = new FileReader();
                reader.onload = (event) => {
                  const img = new Image();
                  img.onload = () => {
                    const tempC = document.createElement('canvas');
                    tempC.width = img.width;
                    tempC.height = img.height;
                    const tCtx = tempC.getContext('2d');
                    tCtx.imageSmoothingEnabled = false;
                    tCtx.drawImage(img, 0, 0);
                    const imgData = tCtx.getImageData(0, 0, img.width, img.height);
                    localCopiedData = imgData;
                    pasteImageData(imgData);
                  };
                  img.src = event.target.result;
                };
                reader.readAsDataURL(blob);
                return;
              }
            }
          }
        }
        if (localCopiedData) {
          e.preventDefault();
          pasteImageData(localCopiedData);
        }
      });

      drawWelcomeDemo();

      // --- Studio Splash Screen & Intro Card Flow ---
      let splashSkipped = false;
      let splashTimer = null;

      function endSplashScreen() {
        if (splashSkipped) return;
        splashSkipped = true;
        if (splashTimer) clearTimeout(splashTimer);

        const splashEl = document.getElementById('splash-screen');
        if (splashEl) {
          splashEl.style.transition = 'opacity 0.4s ease-out';
          splashEl.style.opacity = '0';
          setTimeout(() => {
            splashEl.remove();
            if (modalHelp) {
              modalHelp.classList.remove('hidden');
            }
          }, 400);
        } else {
          if (modalHelp) {
            modalHelp.classList.remove('hidden');
          }
        }
      }

      const splashScreen = document.getElementById('splash-screen');
      if (splashScreen) {
        splashScreen.addEventListener('click', endSplashScreen);
        splashScreen.addEventListener('touchstart', endSplashScreen, { passive: true });
        
        // 5-second automatic animation cycle
        splashTimer = setTimeout(() => {
          endSplashScreen();
        }, 5000);

        window.addEventListener('keydown', (e) => {
          if (!splashSkipped && (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter')) {
            endSplashScreen();
          }
        });
      }


    })();
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bit Smithery - 1-Pixel Precision Pixel Art Studio</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <style>
    /* Classic Windows 95 / 98 Retro Styles */
    :root {
      --win-gray: #c0c0c0;
      --win-dark: #808080;
      --win-darker: #404040;
      --win-black: #000000;
      --win-light: #dfdfdf;
      --win-white: #ffffff;
      --win-blue: #000080;
      --win-blue-light: #1084d0;
    }

    html, body {
      background-color: #008080; /* Classic Win95 Teal desktop */
      font-family: 'MS Sans Serif', Tahoma, 'Segoe UI', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      margin: 0;
      padding: 0;
      overflow: hidden;
      width: 100%;
      height: 100%;
      height: -webkit-fill-available;
      height: 100dvh;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    #paint-app-window {
      width: 100% !important;
      max-width: 1200px !important;
      height: 100% !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      display: flex !important;
      flex-direction: column !important;
      overflow: hidden !important;
      position: relative !important;
      box-sizing: border-box !important;
    }

    @media (min-width: 640px) {
      body {
        padding: 8px !important;
      }
      #paint-app-window {
        height: 98vh !important;
        max-height: 850px !important;
      }
    }

    /* Force canvas container to shrink within available flex space so bottom bar is never pushed out */
    #canvas-container {
      flex: 1 1 0% !important;
      min-height: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    /* Bottom Control Bar: Always pinned, never clipped or pushed off screen */
    #bottom-control-bar {
      flex-shrink: 0 !important;
      height: auto !important;
      min-height: 52px !important;
      z-index: 25 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      background-color: var(--win-gray) !important;
      padding: 6px 8px !important;
      padding-bottom: max(6px, env(safe-area-inset-bottom, 8px)) !important;
      box-sizing: border-box !important;
    }

    #bottom-control-bar button {
      min-height: 38px !important;
      display: flex !important;
      align-items: center !important;
      box-sizing: border-box !important;
      touch-action: manipulation !important;
    }

    /* 3D Bevels */
    .bevel-raised {
      border-top: 2px solid var(--win-white);
      border-left: 2px solid var(--win-white);
      border-right: 2px solid var(--win-dark);
      border-bottom: 2px solid var(--win-dark);
      box-shadow: inset -1px -1px var(--win-black), inset 1px 1px var(--win-light);
    }

    .bevel-sunken {
      border-top: 2px solid var(--win-dark);
      border-left: 2px solid var(--win-dark);
      border-right: 2px solid var(--win-white);
      border-bottom: 2px solid var(--win-white);
      box-shadow: inset 1px 1px var(--win-black), inset -1px -1px var(--win-light);
    }

    .bevel-sunken-deep {
      border-top: 2px solid var(--win-darker);
      border-left: 2px solid var(--win-darker);
      border-right: 2px solid var(--win-white);
      border-bottom: 2px solid var(--win-white);
      box-shadow: inset 1px 1px var(--win-black);
    }

    .tool-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: var(--win-gray);
      border-top: 2px solid var(--win-white);
      border-left: 2px solid var(--win-white);
      border-right: 2px solid var(--win-dark);
      border-bottom: 2px solid var(--win-dark);
      box-shadow: inset -1px -1px var(--win-black), inset 1px 1px var(--win-light);
      cursor: pointer;
      position: relative;
      touch-action: manipulation;
    }

    .tool-btn:hover {
      background-color: #d4d4d4;
    }

    .tool-btn.active {
      background-color: #e0e0e0;
      border-top: 2px solid var(--win-dark);
      border-left: 2px solid var(--win-dark);
      border-right: 2px solid var(--win-white);
      border-bottom: 2px solid var(--win-white);
      box-shadow: inset 1px 1px var(--win-black);
      background-image: radial-gradient(var(--win-dark) 18%, transparent 19%);
      background-size: 3px 3px;
    }

    .tab-btn {
      padding: 6px 12px;
      font-size: 13px;
      font-weight: bold;
      background-color: var(--win-gray);
      border-top: 2px solid var(--win-white);
      border-left: 2px solid var(--win-white);
      border-right: 2px solid var(--win-dark);
      border-bottom: none;
      cursor: pointer;
      user-select: none;
      margin-bottom: -2px;
      z-index: 10;
    }

    .tab-btn.active {
      background-color: #dfdfdf;
      border-top: 2px solid var(--win-white);
      border-left: 2px solid var(--win-white);
      border-right: 2px solid var(--win-dark);
      border-bottom: 2px solid #dfdfdf;
      padding-top: 7px;
      padding-bottom: 7px;
    }

    /* Pixel crisp rendering */
    .pixelated {
      image-rendering: -moz-crisp-edges;
      image-rendering: -webkit-crisp-edges;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    /* Selection marquee dashed line */
    @keyframes marching-ants {
      0% { background-position: 0 0, 0 100%, 0 0, 100% 0; }
      100% { background-position: 16px 0, -16px 100%, 0 -16px, 100% 16px; }
    }

    @keyframes lasso-ants-anim {
      to {
        stroke-dashoffset: -16;
      }
    }
    .lasso-ants-path {
      stroke-dasharray: 4, 4;
      animation: lasso-ants-anim 0.6s linear infinite;
    }

    .marching-ants {
      background-image: 
        linear-gradient(90deg, #000 50%, #fff 50%),
        linear-gradient(90deg, #000 50%, #fff 50%),
        linear-gradient(0deg, #000 50%, #fff 50%),
        linear-gradient(0deg, #000 50%, #fff 50%);
      background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;
      background-size: 8px 1px, 8px 1px, 1px 8px, 1px 8px;
      animation: marching-ants 1s linear infinite;
    }

    /* Studio Splash Screen Keyframes & Styling */
    @keyframes studioSplashCycle {
      0% {
        opacity: 0;
        transform: scale(0.92);
      }
      15% {
        opacity: 1;
        transform: scale(1.0);
      }
      75% {
        opacity: 1;
        transform: scale(1.02);
      }
      100% {
        opacity: 0;
        transform: scale(1.04);
      }
    }

    @keyframes studioTextTopFade {
      0%, 15% {
        opacity: 0;
        transform: translateY(-10px);
      }
      30% {
        opacity: 1;
        transform: translateY(0);
      }
      75% {
        opacity: 1;
        transform: translateY(0);
      }
      100% {
        opacity: 0;
        transform: translateY(-6px);
      }
    }

    @keyframes studioTextBottomFade {
      0%, 15% {
        opacity: 0;
        transform: translateY(10px);
      }
      30% {
        opacity: 1;
        transform: translateY(0);
      }
      75% {
        opacity: 1;
        transform: translateY(0);
      }
      100% {
        opacity: 0;
        transform: translateY(6px);
      }
    }

    @keyframes ambientAuraPulse {
      0%, 100% {
        opacity: 0.25;
        transform: scale(0.95);
      }
      50% {
        opacity: 0.45;
        transform: scale(1.05);
      }
    }

    .splash-container-anim {
      animation: studioSplashCycle 5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    .splash-text-top-anim {
      animation: studioTextTopFade 5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
    .splash-text-bottom-anim {
      animation: studioTextBottomFade 5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    .splash-aura-anim {
      animation: ambientAuraPulse 3s ease-in-out infinite;
    }

  </style>
</head>
<body class="p-0 sm:p-2 flex items-center justify-center">

  <!-- Studio Introductory Splash Screen -->
  <div id="splash-screen" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#07070b] select-none overflow-hidden cursor-pointer">
    <div class="relative flex flex-col items-center justify-center max-w-[92vw] max-h-[90vh] splash-container-anim">
      <!-- Ambient Studio Backlight Aura -->
      <div class="absolute w-72 h-72 sm:w-96 sm:h-96 md:w-[420px] md:h-[420px] rounded-full bg-cyan-500/20 blur-3xl pointer-events-none splash-aura-anim"></div>
      
      <!-- Studio Name: Disembodied (Centered at Top in Aqua Blue) -->
      <div class="splash-text-top-anim z-10 pointer-events-none text-center mb-1 sm:mb-2 px-2">
        <h1 class="text-[#00ffff] text-2xl sm:text-3xl md:text-4xl font-black tracking-[0.25em] uppercase font-mono drop-shadow-[0_0_16px_rgba(0,255,255,0.6)] drop-shadow-[0_3px_10px_rgba(0,0,0,1)]">
          Disembodied
        </h1>
      </div>

      <!-- Studio Emblem Symbol -->
      <div class="relative w-56 h-56 sm:w-72 sm:h-72 md:w-80 md:h-80 flex items-center justify-center my-0 sm:my-1">
        <img id="splash-studio-symbol"
             src="data:image/jpeg;base64," 
             alt="Disembodied Interactive" 
             class="max-w-full max-h-full object-contain filter invert mix-blend-screen drop-shadow-[0_0_20px_rgba(255,255,255,0.3)] pointer-events-none" />
      </div>

      <!-- Studio Name: Interactive (Centered at Bottom in Aqua Blue) -->
      <div class="splash-text-bottom-anim z-10 pointer-events-none text-center mt-1 sm:mt-2 px-2">
        <div class="text-[#00ffff] text-xl sm:text-2xl md:text-3xl font-black tracking-[0.35em] uppercase font-mono drop-shadow-[0_0_16px_rgba(0,255,255,0.6)] drop-shadow-[0_3px_10px_rgba(0,0,0,1)]">
          Interactive
        </div>
      </div>
    </div>

    <!-- Skip Hint -->
    <div class="absolute bottom-6 sm:bottom-8 text-gray-500 text-xs font-mono tracking-wider animate-pulse flex items-center gap-1.5 pointer-events-none">
      <span>Tap anywhere to skip</span>
      <span class="text-[10px]">▶</span>
    </div>
  </div>


  <!-- Main Application Window -->
  <div id="paint-app-window" class="bevel-raised bg-[#c0c0c0] w-full max-w-[1200px] flex flex-col shadow-2xl relative overflow-hidden">
    
    <!-- Titlebar -->
    <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-2 py-1.5 flex items-center justify-between font-bold text-xs select-none shrink-0">
      <div class="flex items-center gap-1.5">
        <!-- Bit Smithery Anvil / Forge Icon -->
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="currentColor">
          <path d="M1 4h14v2c-2 0-3 1-4 3h-1v2h2v1H4v-1h2v-2H5C4 7 3 6 1 6V4z" fill="#f59e0b"/>
          <path d="M4 12h8v1H4z" fill="#d97706"/>
          <rect x="7" y="1" width="2" height="2" fill="#60a5fa"/>
        </svg>
        <span id="window-title" class="truncate">untitled - Bit Smithery</span>
        <span class="text-[9px] bg-amber-900 text-amber-200 px-1 py-0.5 rounded font-bold hidden sm:inline">Bit Smithery</span>
      </div>
      <div class="flex items-center gap-2">
        <span id="status-dimensions" class="font-mono text-[10px] text-blue-100 hidden sm:inline">64 x 64 px</span>
        <span id="status-zoom" class="font-mono text-[10px] bg-blue-900 px-1.5 py-0.5 rounded text-white font-bold">800%</span>
        <div class="flex gap-1 ml-1">
          <button id="btn-win-min" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-black leading-none hover:bg-gray-200 active:bevel-sunken" title="Zoom to 100%">_</button>
          <button id="btn-win-max" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold leading-none hover:bg-gray-200 active:bevel-sunken" title="Fit & Center View">□</button>
          <button id="btn-win-close" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold leading-none hover:bg-red-400 active:bevel-sunken" title="Clear Canvas">✕</button>
        </div>
      </div>
    </div>

    <!-- Main Canvas Viewport Area (Full screen workspace) -->
    <div class="flex-1 bevel-sunken-deep bg-[#808080] overflow-hidden relative flex items-center justify-center touch-none select-none" id="canvas-container">
      
      <!-- Top-Left Quick Color Select Bar & Live Dimensions -->
      <div id="quick-color-container" class="absolute top-2 left-2 z-20 flex flex-col items-start gap-1 select-none pointer-events-auto">
        <div id="quick-color-bar" class="bevel-raised bg-[#c0c0c0] p-1 flex items-center gap-1 shadow-md">
          <!-- Button 1: Dual Primary / Secondary Colors (tap to switch between 2 colors, default black/white) -->
          <button id="quick-color-swap" type="button" class="w-8 h-8 bevel-raised p-0.5 relative bg-[#c0c0c0] hover:bg-gray-200 active:bevel-sunken flex items-center justify-center cursor-pointer shrink-0" title="Tap to switch between Primary and Secondary colors (Black/White default)">
            <div id="quick-swatch-bg" class="w-4 h-4 absolute right-0.5 bottom-0.5 bevel-raised bg-white border border-gray-700"></div>
            <div id="quick-swatch-fg" class="w-4 h-4 absolute left-0.5 top-0.5 bevel-raised bg-black border border-gray-700 z-10"></div>
          </button>

          <div class="w-[1px] h-6 bg-gray-400 mx-0.5"></div>

          <!-- Buttons 2 to 6: 5 Preset Colors (Black, White, Red, Yellow, Blue) -->
          <button id="quick-preset-0" type="button" class="quick-preset-btn w-8 h-8 bevel-sunken p-0 cursor-pointer active:scale-95 transition-transform relative shrink-0 flex items-center justify-center" data-index="0" data-color="#000000" style="background-color: #000000;" title="Black (Tap to select, tap again to change)"></button>
          <button id="quick-preset-1" type="button" class="quick-preset-btn w-8 h-8 bevel-sunken p-0 cursor-pointer active:scale-95 transition-transform relative shrink-0 flex items-center justify-center" data-index="1" data-color="#ffffff" style="background-color: #ffffff;" title="White (Tap to select, tap again to change)"></button>
          <button id="quick-preset-2" type="button" class="quick-preset-btn w-8 h-8 bevel-sunken p-0 cursor-pointer active:scale-95 transition-transform relative shrink-0 flex items-center justify-center" data-index="2" data-color="#ff0000" style="background-color: #ff0000;" title="Red (Tap to select, tap again to change)"></button>
          <button id="quick-preset-3" type="button" class="quick-preset-btn w-8 h-8 bevel-sunken p-0 cursor-pointer active:scale-95 transition-transform relative shrink-0 flex items-center justify-center" data-index="3" data-color="#ffff00" style="background-color: #ffff00;" title="Yellow (Tap to select, tap again to change)"></button>
          <button id="quick-preset-4" type="button" class="quick-preset-btn w-8 h-8 bevel-sunken p-0 cursor-pointer active:scale-95 transition-transform relative shrink-0 flex items-center justify-center" data-index="4" data-color="#0000ff" style="background-color: #0000ff;" title="Blue (Tap to select, tap again to change)"></button>
        </div>

        <!-- Live Dimension Badge (Directly below preset color buttons on the top left) -->
        <div id="live-dimension-badge" class="hidden bevel-sunken bg-[#dfdfdf] px-2 py-0.5 text-xs font-mono font-bold text-gray-900 border border-gray-600 shadow flex items-center gap-1.5 pointer-events-auto">
          <span class="text-[10px] text-gray-600 font-bold uppercase">Size:</span>
          <span id="live-dimension-text" class="text-blue-900 font-black">8 x 1 px</span>
        </div>
      </div>

      <!-- Right Side Layers Dropdown Menu -->
      <div id="layers-control-container" class="absolute top-2 right-2 z-20 pointer-events-auto flex flex-col items-end select-none">
        <button id="btn-toggle-layers" type="button" class="bevel-raised px-2.5 py-1.5 font-bold text-xs bg-[#c0c0c0] hover:bg-gray-100 active:bevel-sunken flex items-center gap-1.5 shadow-md" title="Toggle Layers Menu">
          <span>📑 Layers</span>
          <span id="layers-count-badge" class="bg-blue-900 text-white text-[10px] px-1 rounded font-mono">1</span>
          <span id="layers-arrow">▼</span>
        </button>

        <!-- Dropdown Menu / Panel -->
        <div id="layers-panel" class="hidden mt-1 bevel-raised bg-[#c0c0c0] w-64 max-w-[85vw] p-2 flex flex-col gap-2 shadow-2xl z-30">
          <div class="flex items-center justify-between border-b border-gray-400 pb-1">
            <span class="font-bold text-xs text-gray-800">Layers Stack</span>
            <button id="btn-close-layers-panel" type="button" class="w-4 h-4 bevel-raised text-black text-[10px] flex items-center justify-center font-bold">✕</button>
          </div>

          <!-- Stack Action Buttons -->
          <div class="grid grid-cols-2 gap-1 text-[11px] font-bold">
            <button id="btn-layer-add" type="button" class="bevel-raised py-1 px-1.5 bg-gray-100 hover:bg-white active:bevel-sunken flex items-center justify-center gap-1">➕ New Layer</button>
            <button id="btn-layer-delete" type="button" class="bevel-raised py-1 px-1.5 bg-gray-100 hover:bg-white active:bevel-sunken flex items-center justify-center gap-1 text-red-900">🗑️ Delete</button>
            <button id="btn-layer-merge-down" type="button" class="bevel-raised py-1 px-1.5 bg-gray-100 hover:bg-white active:bevel-sunken flex items-center justify-center gap-1">⬇️ Merge Down</button>
            <button id="btn-layer-merge-all" type="button" class="bevel-raised py-1 px-1.5 bg-gray-100 hover:bg-white active:bevel-sunken flex items-center justify-center gap-1">⏬ Merge All</button>
          </div>

          <!-- Layer List -->
          <div id="layers-items-list" class="max-h-48 overflow-y-auto flex flex-col gap-1 p-1 bevel-sunken bg-white">
            <!-- Dynamically populated -->
          </div>

          <!-- Active Layer Opacity -->
          <div class="flex items-center justify-between text-xs pt-1 border-t border-gray-300">
            <label for="layer-opacity-slider" class="font-bold text-[11px] text-gray-700">Opacity:</label>
            <input type="range" id="layer-opacity-slider" min="0" max="100" value="100" class="w-24 cursor-pointer">
            <span id="layer-opacity-val" class="font-mono text-[10px] w-8 text-right font-bold">100%</span>
          </div>
        </div>
      </div>

      <!-- Canvas Wrapper -->
      <div id="canvas-wrapper" class="relative shadow-2xl bg-white select-none origin-center touch-none">
        <canvas id="paint-canvas" class="pixelated block cursor-crosshair touch-none"></canvas>
        <canvas id="preview-canvas" class="pixelated absolute inset-0 pointer-events-none block"></canvas>
        <canvas id="grid-canvas" class="absolute inset-0 pointer-events-none block"></canvas>
        
        <!-- Lasso Free-Form SVG Contour (Conforms exactly to user's drawn shape) -->
        <svg id="lasso-svg" class="hidden absolute inset-0 w-full h-full pointer-events-none z-10 overflow-visible">
          <polygon id="lasso-poly-fill" points="" fill="rgba(59, 130, 246, 0.15)"/>
          <polygon id="lasso-poly-black" points="" fill="none" stroke="#000000" stroke-width="1.5" class="lasso-ants-path"/>
          <polygon id="lasso-poly-white" points="" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4, 4" stroke-dashoffset="4" class="lasso-ants-path"/>
        </svg>

        <!-- Magic Wand Free-Form SVG Contour (Conforms exactly to selected pixels) -->
        <svg id="magic-svg" class="hidden absolute inset-0 w-full h-full pointer-events-none z-10 overflow-visible">
          <path id="magic-path-black" d="" fill="none" stroke="#000000" stroke-width="1.5" class="lasso-ants-path"/>
          <path id="magic-path-white" d="" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4, 4" stroke-dashoffset="4" class="lasso-ants-path"/>
        </svg>

        <div id="selection-box" class="hidden absolute pointer-events-auto cursor-pointer select-none bg-blue-500/10">
          <!-- Floating Selection Canvas for Unclipped Pre-Stamp Display -->
          <canvas id="selection-content-canvas" class="pixelated absolute inset-0 w-full h-full pointer-events-none block z-0" style="display: none;"></canvas>
          <!-- Marching Ants SVG Border for Rectangular Selection -->
          <svg id="selection-rect-svg" class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-10">
            <rect x="0" y="0" width="100%" height="100%" fill="none" stroke="#000000" stroke-width="1.5" class="lasso-ants-path"/>
            <rect x="0" y="0" width="100%" height="100%" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4, 4" stroke-dashoffset="4" class="lasso-ants-path"/>
          </svg>
          <div class="sel-handle absolute -top-1 -left-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="sel-handle absolute -top-1 -right-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="sel-handle absolute -bottom-1 -left-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="sel-handle absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <button id="btn-selection-edit" type="button" class="absolute -top-10 left-1/2 -translate-x-1/2 bg-yellow-300 hover:bg-yellow-200 active:bg-yellow-400 text-blue-950 font-bold text-xs sm:text-sm px-3.5 py-1.5 rounded-md border-2 border-blue-900 shadow-2xl z-30 flex items-center gap-1.5 pointer-events-auto cursor-pointer whitespace-nowrap active:scale-95 transition-transform" style="touch-action: manipulation;">
            <span>⚡ Selection Options</span>
          </button>
        </div>

        <!-- Staged Text Draggable Box -->
        <div id="text-drag-box" class="hidden absolute pointer-events-auto cursor-move select-none border border-dashed border-blue-600 bg-blue-500/10 z-20">
          <div class="absolute -top-1 -left-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="absolute -bottom-1 -left-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
          <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-blue-600 border border-white"></div>
        </div>

        <!-- Staged Shape Draggable Control Handles -->
        <div id="shape-handle-0" class="shape-handle hidden absolute w-4 h-4 bg-white border-2 border-blue-800 -translate-x-1/2 -translate-y-1/2 cursor-move pointer-events-auto z-20 shadow-md flex items-center justify-center" data-handle="0">
          <div class="w-1.5 h-1.5 bg-blue-800 pointer-events-none"></div>
        </div>
        <div id="shape-handle-1" class="shape-handle hidden absolute w-4 h-4 bg-white border-2 border-blue-800 -translate-x-1/2 -translate-y-1/2 cursor-move pointer-events-auto z-20 shadow-md flex items-center justify-center" data-handle="1">
          <div class="w-1.5 h-1.5 bg-blue-800 pointer-events-none"></div>
        </div>
        <div id="shape-handle-2" class="shape-handle hidden absolute w-4 h-4 bg-white border-2 border-blue-800 -translate-x-1/2 -translate-y-1/2 cursor-move pointer-events-auto z-20 shadow-md flex items-center justify-center" data-handle="2">
          <div class="w-1.5 h-1.5 bg-blue-800 pointer-events-none"></div>
        </div>
        <div id="shape-handle-3" class="shape-handle hidden absolute w-4 h-4 bg-white border-2 border-blue-800 -translate-x-1/2 -translate-y-1/2 cursor-move pointer-events-auto z-20 shadow-md flex items-center justify-center" data-handle="3">
          <div class="w-1.5 h-1.5 bg-blue-800 pointer-events-none"></div>
        </div>
      </div>

      <!-- Floating Staged Shape Toolbar (Adjust handles before baking) -->
      <div id="floating-shape-bar" class="hidden absolute top-3 left-1/2 -translate-x-1/2 bevel-raised bg-[#ffffd0] border-2 border-blue-900 p-2 z-40 flex items-center gap-2 sm:gap-4 shadow-2xl select-none">
        <div class="flex items-center gap-1.5 text-xs font-bold text-gray-900">
          <span>📐</span>
          <span>Adjust ends before baking</span>
        </div>
        <div class="flex gap-1.5">
          <button id="btn-commit-shape" type="button" class="bevel-raised px-3 py-1 font-bold text-xs bg-green-200 text-green-900 hover:bg-green-100 active:bevel-sunken">
            ✓ Bake to Layer
          </button>
          <button id="btn-cancel-shape" type="button" class="bevel-raised px-3 py-1 font-bold text-xs bg-red-200 text-red-900 hover:bg-red-100 active:bevel-sunken">
            ✕ Discard Shape
          </button>
        </div>
      </div>

      <!-- Floating Staged Text Toolbar (Drag, re-format, or stamp down) -->
      <div id="floating-text-bar" class="hidden absolute top-3 left-1/2 -translate-x-1/2 bevel-raised bg-[#ffffd0] border-2 border-black p-2 z-40 flex items-center gap-2 sm:gap-4 shadow-2xl select-none">
        <div class="flex items-center gap-1.5 text-xs font-bold text-gray-900">
          <span>🔤</span>
          <span>Drag words to position</span>
        </div>
        <div class="flex gap-1.5">
          <button id="btn-commit-text" type="button" class="bevel-raised px-3 py-1 font-bold text-xs bg-green-200 text-green-900 hover:bg-green-100 active:bevel-sunken cursor-pointer">
            ✓ Stamp Down
          </button>
          <button id="btn-edit-staged-text" type="button" class="bevel-raised px-3 py-1 font-bold text-xs bg-yellow-200 text-yellow-900 hover:bg-yellow-100 active:bevel-sunken cursor-pointer">
            ⚙️ Text Options...
          </button>
          <button id="btn-cancel-text" type="button" class="bevel-raised px-3 py-1 font-bold text-xs bg-red-200 text-red-900 hover:bg-red-100 active:bevel-sunken cursor-pointer">
            ✕ Cancel
          </button>
        </div>
      </div>

      <!-- Floating Move Toolbar (Active during Move Mode) -->
      <div id="floating-move-bar" class="hidden absolute top-3 left-1/2 -translate-x-1/2 bevel-raised bg-[#ffffd0] border-2 border-black p-2 z-40 flex items-center gap-2 sm:gap-4 shadow-2xl">
        <div class="flex items-center gap-1.5 text-xs font-bold text-gray-900">
          <span>✋</span>
          <span>Drag to Move Selection</span>
        </div>
        <div class="flex gap-1.5">
          <button id="btn-commit-move" class="bevel-raised px-3 py-1 font-bold text-xs bg-green-200 text-green-900 hover:bg-green-100 active:bevel-sunken">
            ✓ Stamp Down
          </button>
          <button id="btn-cancel-move" class="bevel-raised px-3 py-1 font-bold text-xs bg-red-200 text-red-900 hover:bg-red-100 active:bevel-sunken">
            ✕ Cancel Move
          </button>
        </div>
      </div>

      <!-- OVERLAYS BACKDROP (Overlaying directly on top of canvas) -->
      <div id="overlay-backdrop" class="hidden absolute inset-0 bg-black/40 z-30 flex items-end sm:items-center justify-center p-0 sm:p-4">
        
        <!-- 1. Menu Overlay -->
        <div id="overlay-menu" class="hidden bevel-raised bg-[#c0c0c0] w-full sm:w-[490px] max-h-[85vh] p-1 flex flex-col shadow-2xl overflow-hidden">
          <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-2 py-1 flex items-center justify-between font-bold text-xs select-none">
            <span>System Menu</span>
            <button id="btn-close-menu-overlay" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold">✕</button>
          </div>
          
          <!-- Category Tabs -->
          <div class="flex border-b-2 border-gray-400 bg-[#c0c0c0] px-2 pt-2 gap-1 overflow-x-auto select-none shrink-0">
            <button class="tab-btn active" id="menu-btn-file">File</button>
            <button class="tab-btn" id="menu-btn-edit">Edit</button>
            <button class="tab-btn" id="menu-btn-view">View</button>
            <button class="tab-btn" id="menu-btn-image">Image</button>
            <button class="tab-btn" id="menu-btn-colors">Colors</button>
            <button class="tab-btn" id="menu-btn-help">Help</button>
          </div>

          <!-- Tab Content Panels -->
          <div class="p-3 bg-[#dfdfdf] bevel-sunken flex-1 overflow-y-auto max-h-[60vh]">
            
            <!-- File Panel -->
            <div id="menu-dropdown-file" class="flex flex-col gap-2">
              <button id="action-new" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>📄 New Canvas... (Presets & Custom)</span>
                <span class="text-xs text-gray-500 font-mono">Ctrl+N</span>
              </button>
              <button id="action-open" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>📂 Open Image from Device...</span>
                <span class="text-xs text-gray-500 font-mono">Ctrl+O</span>
              </button>
              <button id="action-save" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>💾 Save PNG (Native 1x)</span>
                <span class="text-xs text-gray-500 font-mono">Ctrl+S</span>
              </button>
              <button id="action-export-upscaled" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>🔍 Export Scaled Pixel Art PNG...</span>
                <span class="text-xs text-blue-700 font-bold">2x - 16x</span>
              </button>
              <div class="border-t border-gray-400 my-1"></div>
              <button id="action-clear-canvas" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-red-100 text-red-900 active:bevel-sunken">
                🗑️ Clear Canvas (Fill Background)
              </button>
            </div>

            <!-- Edit Panel -->
            <div id="menu-dropdown-edit" class="hidden flex flex-col gap-2">
              <div class="grid grid-cols-2 gap-2">
                <button id="action-undo" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                  <span>↩ Undo</span><span class="text-xs text-gray-500 font-mono">Ctrl+Z</span>
                </button>
                <button id="action-redo" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                  <span>↪ Redo</span><span class="text-xs text-gray-500 font-mono">Ctrl+Y</span>
                </button>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <button id="action-cut" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                  <span>✂️ Cut</span><span class="text-xs text-gray-500 font-mono">Ctrl+X</span>
                </button>
                <button id="action-copy" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                  <span>📋 Copy</span><span class="text-xs text-gray-500 font-mono">Ctrl+C</span>
                </button>
              </div>
              <button id="action-paste" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>📥 Paste</span><span class="text-xs text-gray-500 font-mono">Ctrl+V</span>
              </button>
              <button id="action-select-all" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>🔲 Select All</span><span class="text-xs text-gray-500 font-mono">Ctrl+A</span>
              </button>
              <button id="action-select-all-fit" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-blue-100 hover:bg-white text-blue-900 active:bevel-sunken flex justify-between items-center">
                <span>📐 Resize Selection to Canvas</span><span class="text-xs text-blue-800 font-bold">Fit</span>
              </button>
            </div>

            <!-- View Panel -->
            <div id="menu-dropdown-view" class="hidden flex flex-col gap-2">
              <button id="action-toggle-grid" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>▦ Toggle 1-Pixel Grid Overlay</span>
                <span id="grid-check-indicator" class="font-bold text-blue-800">✓</span>
              </button>
              <button id="btn-toggle-grid" class="hidden">Grid: ON</button>
              <div class="border-t border-gray-400 my-1"></div>
              <div class="text-xs font-bold text-gray-700">Zoom Presets:</div>
              <div class="grid grid-cols-2 gap-2 mb-2">
                <button id="btn-zoom-in" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">+ Zoom In</button>
                <button id="btn-zoom-out" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">- Zoom Out</button>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <button id="action-zoom-fit" class="bevel-raised py-2 font-bold text-xs bg-blue-100 hover:bg-white active:bevel-sunken text-blue-900">Fit to Screen</button>
                <button id="action-zoom-5" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 5%</button>
                <button id="action-zoom-10" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 10%</button>
                <button id="action-zoom-25" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 25%</button>
                <button id="action-zoom-50" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 50%</button>
                <button id="action-zoom-100" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 100% (1x)</button>
                <button id="action-zoom-200" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 200% (2x)</button>
                <button id="action-zoom-400" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 400% (4x)</button>
                <button id="action-zoom-800" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 800% (8x)</button>
                <button id="action-zoom-1600" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 1600% (16x)</button>
                <button id="action-zoom-3200" class="bevel-raised py-2 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken">Zoom 3200% (32x)</button>
                <button id="btn-reset-view" class="bevel-raised py-2 font-bold text-xs bg-blue-100 hover:bg-white active:bevel-sunken text-blue-900">Reset View</button>
              </div>
            </div>

            <!-- Image Panel -->
            <div id="menu-dropdown-image" class="hidden flex flex-col gap-2">
              <div class="grid grid-cols-2 gap-2">
                <button id="action-flip-h" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                  ↔️ Flip Horizontal
                </button>
                <button id="action-flip-v" class="bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                  ↕️ Flip Vertical
                </button>
              </div>
              <button id="action-rotate-90" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                ↻ Rotate 90° Clockwise
              </button>
              <button id="action-invert" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex justify-between items-center">
                <span>☯ Invert Colors</span>
                <span class="text-xs text-gray-500 font-mono">Ctrl+I</span>
              </button>
              <div class="border-t border-gray-400 my-1"></div>
              <button id="action-resize-dialog" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                📐 Canvas Dimensions / Attributes...
              </button>
            </div>

            <!-- Colors Panel -->
            <div id="menu-dropdown-colors" class="hidden flex flex-col gap-2">
              <button id="action-edit-colors" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                🎨 Open Color Picker...
              </button>
              <button id="action-swap-colors" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                ⇄ Swap Foreground & Background
              </button>
            </div>

            <!-- Help Panel -->
            <div id="menu-dropdown-help" class="hidden flex flex-col gap-2">
              <button id="action-help-about" class="w-full bevel-raised py-2.5 px-3 text-left font-bold text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken">
                ❓ About Pixel Paint & Gestures Guide
              </button>
            </div>

          </div>

          <div class="p-2 flex justify-end bg-[#c0c0c0] border-t border-gray-400">
            <button id="btn-cancel-menu-overlay" class="bevel-raised px-4 py-1.5 font-bold text-xs bg-[#c0c0c0] hover:bg-gray-200 active:bevel-sunken">Close</button>
          </div>
        </div>

        <!-- 2. Tools Overlay -->
        <div id="overlay-tools" class="hidden bevel-raised bg-[#c0c0c0] w-full sm:w-[520px] max-h-[85vh] p-1 flex flex-col shadow-2xl overflow-hidden">
          <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-2 py-1 flex items-center justify-between font-bold text-xs select-none">
            <span>Toolbox & Settings</span>
            <button id="btn-close-tools-overlay" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold">✕</button>
          </div>

          <div class="p-2 sm:p-3 bg-[#dfdfdf] bevel-sunken flex-1 overflow-y-auto max-h-[65vh] flex flex-col gap-3">
            
            <!-- Tool Selection Grid (4 columns, large touch targets) -->
            <div>
              <div class="text-xs font-bold text-gray-700 mb-1.5">Choose Tool:</div>
              <div id="toolbox" class="grid grid-cols-4 gap-1.5">
                
                <button class="tool-btn active py-2" data-tool="pencil" title="Scribble (1px Strict)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 17c3-3 4-8 8-8s4 6 7 6 3-3 3-5"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Scribble</span>
                </button>

                <button class="tool-btn py-2" data-tool="line" title="Vector (Coordinate Line)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="5" y1="19" x2="19" y2="5" stroke="currentColor" stroke-width="2"/><line x1="1" y1="19" x2="9" y2="19" stroke="#0284c7" stroke-width="1.5"/><line x1="5" y1="15" x2="5" y2="23" stroke="#0284c7" stroke-width="1.5"/><rect x="3" y="17" width="4" height="4" fill="#ffffff" stroke="currentColor" stroke-width="1.2"/><line x1="15" y1="5" x2="23" y2="5" stroke="#0284c7" stroke-width="1.5"/><line x1="19" y1="1" x2="19" y2="9" stroke="#0284c7" stroke-width="1.5"/><rect x="17" y="3" width="4" height="4" fill="#ffffff" stroke="currentColor" stroke-width="1.2"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Vector</span>
                </button>

                <button class="tool-btn py-2" data-tool="eraser" title="Eraser">
                  <span class="text-xl">🧹</span>
                  <span class="text-[10px] font-bold mt-0.5">Eraser</span>
                </button>

                <button class="tool-btn py-2" data-tool="fill" title="Splash (Ink Splatter)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6c-1.5 0-2.5 1.5-3 2.5C7.5 10 5 11 5 13.5c0 3 3 5.5 7 5.5s7-2.5 7-5.5c0-2.5-2.5-3.5-4-5-.5-1-1.5-2.5-3-2.5z"/><circle cx="12" cy="3" r="1.5"/><circle cx="4" cy="9" r="1.2"/><circle cx="20" cy="10" r="1.2"/><circle cx="3.5" cy="16" r="1"/><circle cx="20.5" cy="16" r="1"/><circle cx="8" cy="21" r="1.2"/><circle cx="16" cy="21" r="1.2"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Splash</span>
                </button>

                <button class="tool-btn py-2" data-tool="picker" title="Sample (Chemical Glass Dropper)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14.5 3.5a3 3 0 0 0-4 0l-1 1 5 5 1-1a3 3 0 0 0-1-5z" fill="#475569" stroke="#1e293b"/><line x1="9" y1="5" x2="14" y2="10" stroke="#1e293b" stroke-width="2"/><path d="M8.5 6.5l-4 4c-.5.5-.8 1.2-.8 2l.3 2.5 4.5 4.5 2.5.3c.8 0 1.5-.3 2-.8l4-4-8.5-8.5z" fill="#e0f2fe" stroke="#0284c7"/><circle cx="2.5" cy="21.5" r="1.5" fill="#0284c7"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Sample</span>
                </button>

                <button class="tool-btn py-2" data-tool="rect" title="Rectangle">
                  <span class="text-xl">▭</span>
                  <span class="text-[10px] font-bold mt-0.5">Rect</span>
                </button>

                <button class="tool-btn py-2" data-tool="ellipse" title="Circle / Ellipse">
                  <span class="text-xl">◯</span>
                  <span class="text-[10px] font-bold mt-0.5">Circle</span>
                </button>

                <button class="tool-btn py-2" data-tool="roundrect" title="Bevel (Rounded Rectangle)">
                  <span class="text-xl">▢</span>
                  <span class="text-[10px] font-bold mt-0.5">Bevel</span>
                </button>

                <button class="tool-btn py-2" data-tool="brush" title="Brush">
                  <span class="text-xl">🖌️</span>
                  <span class="text-[10px] font-bold mt-0.5">Brush</span>
                </button>

                <button class="tool-btn py-2" data-tool="spray" title="Airbrush / Spray">
                  <span class="text-xl">💨</span>
                  <span class="text-[10px] font-bold mt-0.5">Spray</span>
                </button>

                <button class="tool-btn py-2" data-tool="text" title="Text Stamp">
                  <span class="text-xl font-black font-serif">A</span>
                  <span class="text-[10px] font-bold mt-0.5">Text</span>
                </button>

                <button class="tool-btn py-2" data-tool="select" title="Marquee Select">
                  <span class="text-xl">⬚</span>
                  <span class="text-[10px] font-bold mt-0.5">Select</span>
                </button>

                <button class="tool-btn py-2" data-tool="free-select" title="Cutout (Free-Form Select)">
                  <span class="text-xl">✂️</span>
                  <span class="text-[10px] font-bold mt-0.5">Cutout</span>
                </button>

                <button class="tool-btn py-2" data-tool="magic-select" title="Smart Select (Tone & Perimeter)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M12 2C7 6 5 11 5 16c0 3 2 5 5 6l2-20z" fill="#1e293b"/><path d="M12 2c5 4 7 9 7 14 0 3-2 5-5 6l-2-20z" fill="#93c5fd"/><path d="M12 2c5 4 7 9 7 14 0 3-2 5-5 6 L12 2Z" stroke="#000000" stroke-width="1.8" stroke-dasharray="2, 2" fill="none"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Smart Select</span>
                </button>

                <button class="tool-btn py-2" data-tool="curve" title="Spline">
                  <span class="text-xl">〰️</span>
                  <span class="text-[10px] font-bold mt-0.5">Spline</span>
                </button>

                <button class="tool-btn py-2" data-tool="polygon" title="Polygon">
                  <span class="text-xl">⬠</span>
                  <span class="text-[10px] font-bold mt-0.5">Polygon</span>
                </button>

                <button class="tool-btn py-2" data-tool="zoom" title="Focus (Desk Inspection Glass)">
                  <span class="flex items-center justify-center w-6 h-6 mx-auto">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="21" rx="6" ry="2" fill="#475569" stroke="#1e293b"/><path d="M12 19V14l-3-4" stroke="#1e293b" stroke-width="2"/><circle cx="13" cy="7" r="5.5" stroke="#1e293b" stroke-width="2" fill="#e0f2fe"/></svg>
                  </span>
                  <span class="text-[10px] font-bold mt-0.5">Focus</span>
                </button>

              </div>
            </div>

            <!-- Dynamic Tool Options / Size Section -->
            <div class="border-t-2 border-gray-300 pt-2">
              <div class="text-xs font-bold text-gray-700 mb-1.5" id="tool-options-header">Precision Size / Options:</div>
              <div id="tool-options-panel" class="p-2 bg-[#c0c0c0] bevel-sunken flex flex-wrap gap-2 items-center justify-center">
                <!-- Dynamically populated with large touch buttons -->
              </div>
            </div>

          </div>

          <div class="p-2 flex justify-between items-center bg-[#c0c0c0] border-t border-gray-400">
            <span class="text-xs text-gray-600 font-bold hidden sm:inline" id="status-hint">Scribble: Edits strictly 1 pixel at a time.</span>
            <button id="btn-done-tools-overlay" class="bevel-raised px-5 py-2 font-bold text-xs bg-blue-100 hover:bg-white text-blue-900 active:bevel-sunken ml-auto">
              Start Drawing ✓
            </button>
          </div>
        </div>

        <!-- 3. Palette Overlay -->
        <div id="overlay-palette" class="hidden bevel-raised bg-[#c0c0c0] w-full sm:w-[460px] max-h-[85vh] p-1 flex flex-col shadow-2xl overflow-hidden">
          <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-2 py-1 flex items-center justify-between font-bold text-xs select-none">
            <span>Color Palette & Swatches</span>
            <button id="btn-close-palette-overlay" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold">✕</button>
          </div>

          <div class="p-3 bg-[#dfdfdf] bevel-sunken flex-1 overflow-y-auto max-h-[65vh] flex flex-col gap-3">
            
            <!-- Active Color Box & Target Selector -->
            <div class="bevel-raised p-2 bg-[#c0c0c0] flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <div class="relative w-12 h-12 bevel-sunken bg-gray-400 shrink-0">
                  <div id="bg-color-swatch" class="absolute right-1 bottom-1 w-7 h-7 bevel-raised bg-white border border-gray-700 cursor-pointer" title="Background Color"></div>
                  <div id="fg-color-swatch" class="absolute left-1 top-1 w-7 h-7 bevel-raised bg-black border border-gray-700 z-10 cursor-pointer" title="Foreground Color"></div>
                </div>
                <div class="text-xs">
                  <div class="font-bold text-gray-800">Active Colors</div>
                  <div class="text-[10px] text-gray-600">Left: FG / Right: BG</div>
                </div>
              </div>

              <div class="flex flex-col gap-1.5 items-end">
                <button id="btn-swap-fg-bg" class="bevel-raised px-3 py-1 font-bold text-xs hover:bg-white active:bevel-sunken flex items-center gap-1">
                  <span>⇄ Swap Colors</span>
                </button>
                <div class="flex gap-1 text-[11px]">
                  <button id="target-fg-btn" class="bevel-raised px-2 py-0.5 font-bold bg-blue-100 text-blue-900 border border-blue-500">Edit FG</button>
                  <button id="target-bg-btn" class="bevel-raised px-2 py-0.5 font-bold bg-gray-200 text-gray-700">Edit BG</button>
                </div>
              </div>
            </div>

            <!-- Classic 28 Colors Palette (Large 40px touch swatches) -->
            <div>
              <div class="text-xs font-bold text-gray-700 mb-1.5 flex justify-between">
                <span>Tap a color to select & close:</span>
                <span class="text-[10px] text-blue-800 font-semibold" id="palette-target-label">Target: Foreground</span>
              </div>
              <div id="palette-grid" class="grid grid-cols-7 gap-1.5 bg-[#808080] p-1.5 bevel-sunken-deep">
                <!-- Large 40px swatches generated by JS -->
              </div>
            </div>

            <!-- Custom Color Picker & Reset Presets -->
            <div class="flex items-center justify-between pt-1 border-t border-gray-300 gap-1.5 flex-wrap">
              <label for="native-color-picker" class="bevel-raised px-2.5 py-1.5 cursor-pointer bg-[#c0c0c0] hover:bg-white active:bevel-sunken font-bold text-xs flex items-center gap-1.5">
                <span>🎨 Color Picker...</span>
                <input type="color" id="native-color-picker" value="#000000" class="w-5 h-5 cursor-pointer p-0 border-0 bg-transparent">
              </label>
              <button id="btn-reset-presets" type="button" class="bevel-raised px-2.5 py-1.5 font-bold text-xs bg-gray-200 hover:bg-white active:bevel-sunken flex items-center gap-1" title="Reset top preset colors back to Black, White, Red, Yellow, Blue">
                <span>↺ Reset Presets</span>
              </button>
              <button id="btn-done-palette-overlay" class="bevel-raised px-3.5 py-1.5 font-bold text-xs bg-blue-100 hover:bg-white text-blue-900 active:bevel-sunken">
                Done ✓
              </button>
            </div>

          </div>
        </div>

        <!-- 4. Selection Actions Overlay -->
        <div id="overlay-selection" class="hidden bevel-raised bg-[#c0c0c0] w-full sm:w-[440px] max-h-[85vh] p-1 flex flex-col shadow-2xl overflow-hidden">
          <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-2 py-1 flex items-center justify-between font-bold text-xs select-none">
            <span id="selection-overlay-title">Selection Actions (32 x 32 px)</span>
            <button id="btn-close-selection-overlay" class="w-5 h-5 bg-[#c0c0c0] text-black bevel-raised text-xs flex items-center justify-center font-bold">✕</button>
          </div>

          <div class="p-3 bg-[#dfdfdf] bevel-sunken flex-1 overflow-y-auto max-h-[65vh] flex flex-col gap-2.5">
            <!-- Top Actions: Select All & Resize Selection to Canvas -->
            <div class="grid grid-cols-2 gap-2">
              <button id="btn-sel-select-all" type="button" class="bevel-raised py-2.5 px-3 font-bold text-xs sm:text-sm bg-blue-100 hover:bg-white text-blue-900 active:bevel-sunken flex items-center justify-center gap-1.5 shadow-sm cursor-pointer" title="Select the entire canvas">
                <span>🔲</span>
                <span>Select All</span>
              </button>
              <button id="btn-sel-all-fit" type="button" class="bevel-raised py-2.5 px-3 font-bold text-xs sm:text-sm bg-gradient-to-r from-blue-100 to-yellow-100 text-blue-950 hover:bg-white active:bevel-sunken flex items-center justify-center gap-1.5 shadow-sm cursor-pointer" title="Resize the selection to the size of the canvas">
                <span>📐</span>
                <span>Fit to Canvas</span>
              </button>
            </div>

            <div class="text-xs text-gray-700 font-bold">Manipulate Selected Region:</div>

            <!-- Magic / Color Actions (Picker & Recolor Fill) -->
            <div id="selection-color-actions" class="bevel-raised p-2 bg-[#ffffd0] border border-gray-600 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-gray-900 flex items-center gap-1">
                  <span>🎨</span>
                  <span>Selection Color Tools:</span>
                </span>
                <span id="sel-sampled-color-badge" class="flex items-center gap-1.5 text-[11px] font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-400">
                  <span id="sel-color-swatch-box" class="w-3.5 h-3.5 border border-black inline-block" style="background-color: #000000;"></span>
                  <span id="sel-color-hex-text">#000000</span>
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <!-- 1. Picker: Copy Color Selected -->
                <button id="btn-sel-pick-color" type="button" class="bevel-raised p-2 font-bold text-xs bg-white hover:bg-yellow-100 active:bevel-sunken flex items-center gap-2 cursor-pointer" title="Copy the selected color into active foreground color">
                  <span class="text-lg">🧪</span>
                  <div class="text-left">
                    <div class="text-gray-900">Pick Color</div>
                    <div class="text-[9px] text-gray-500 font-normal">Copy to active color</div>
                  </div>
                </button>

                <!-- 2. Fill: Change Color Selected -->
                <button id="btn-sel-fill-color" type="button" class="bevel-raised p-2 font-bold text-xs bg-white hover:bg-yellow-100 active:bevel-sunken flex items-center gap-2 cursor-pointer" title="Fill all selected pixels with chosen active color">
                  <span class="text-lg">🪣</span>
                  <div class="text-left">
                    <div class="text-gray-900">Fill with Color</div>
                    <div class="text-[9px] text-gray-500 font-normal">Recolor to active color</div>
                  </div>
                </button>
              </div>

              <!-- Scope switch for magic select: Adjacent vs Global -->
              <div id="sel-magic-mode-row" class="flex items-center justify-between pt-1 border-t border-yellow-200 text-xs">
                <span class="text-[11px] font-bold text-gray-700">Magic Mode:</span>
                <div class="flex gap-1">
                  <button id="btn-sel-mode-adj" type="button" class="bevel-raised px-2.5 py-1 text-[11px] font-bold bg-blue-100 text-blue-900 border border-blue-500 active:bevel-sunken cursor-pointer">Adjacent</button>
                  <button id="btn-sel-mode-glob" type="button" class="bevel-raised px-2.5 py-1 text-[11px] font-bold bg-gray-100 text-gray-800 hover:bg-white active:bevel-sunken cursor-pointer">Global</button>
                </div>
              </div>
            </div>

            <!-- Secondary Color Knockout Mode -->
            <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex flex-col">
                <span class="font-bold text-xs text-gray-900">Background Color Handling:</span>
                <span class="text-[10px] text-gray-600">Choose whether secondary color is preserved or deleted</span>
              </div>
              <button id="btn-toggle-transparent-selection" type="button" class="bevel-raised px-3 py-1.5 font-bold text-xs flex items-center gap-1.5 bg-gray-200 text-gray-800 hover:bg-white active:bevel-sunken cursor-pointer select-none shrink-0" title="Toggle between Opaque and Transparent selection">
                <span id="trans-switch-icon">⚪</span>
                <span id="trans-switch-status">Opaque (Keep All Colors)</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button id="btn-sel-move" class="bevel-raised p-2.5 font-bold text-xs sm:text-sm bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex items-center gap-2">
                <span class="text-base">✋</span>
                <div class="text-left">
                  <div>Move / Reposition</div>
                  <div class="text-[10px] text-gray-500 font-normal">Pick up & drag selection</div>
                </div>
              </button>

              <button id="btn-sel-erase" class="bevel-raised p-2.5 font-bold text-xs sm:text-sm bg-[#c0c0c0] hover:bg-red-50 text-red-900 active:bevel-sunken flex items-center gap-2">
                <span class="text-base">🧹</span>
                <div class="text-left">
                  <div>Clear to Background</div>
                  <div class="text-[10px] text-gray-500 font-normal">Erase area to secondary color</div>
                </div>
              </button>
            </div>

            <!-- Resize / Scale Quick Controls -->
            <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1.5">
              <div class="text-xs font-bold text-gray-800">🔍 Resize / Scale Selection:</div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <button id="btn-sel-scale-fit-canvas" type="button" class="bevel-raised py-1.5 font-bold text-xs bg-blue-100 text-blue-900 hover:bg-white active:bevel-sunken" title="Scale selected region to fit entire canvas">Fit to Canvas</button>
                <button id="btn-sel-scale-2x" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">200% (2x Size)</button>
                <button id="btn-sel-scale-half" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">50% (Half Size)</button>
                <button id="btn-sel-scale-custom" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">Custom Size...</button>
              </div>
            </div>

            <!-- Transform Actions (Flip, Rotate, Invert) -->
            <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1.5">
              <div class="text-xs font-bold text-gray-800">Transform Orientation:</div>
              <div class="grid grid-cols-3 gap-1.5">
                <button id="btn-sel-flip-h" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">↔️ Flip Horizontal</button>
                <button id="btn-sel-flip-v" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">↕️ Flip Vertical</button>
                <button id="btn-sel-rotate" class="bevel-raised py-1.5 font-bold text-xs bg-gray-100 hover:bg-white active:bevel-sunken">↻ Rotate 90°</button>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-1">
              <button id="btn-sel-copy" type="button" class="bevel-raised py-2 px-1 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex items-center justify-center gap-1" title="Copy selection to clipboard">
                <span>📋 Copy to Clipboard</span>
              </button>
              <button id="btn-sel-cut" type="button" class="bevel-raised py-2 px-1 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex items-center justify-center gap-1" title="Cut selection to clipboard">
                <span>✂️ Cut (Copy & Clear)</span>
              </button>
              <button id="btn-sel-paste" type="button" class="bevel-raised py-2 px-1 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex items-center justify-center gap-1" title="Paste clipboard pixels">
                <span>📥 Paste from Clipboard</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button id="btn-sel-invert" class="bevel-raised py-2 px-3 font-bold text-xs bg-[#c0c0c0] hover:bg-white active:bevel-sunken flex items-center gap-1.5">
                <span>☯ Invert Pixel Colors</span>
              </button>
              <button id="btn-sel-deselect" class="bevel-raised py-2 px-3 font-bold text-xs bg-red-100 text-red-900 hover:bg-white active:bevel-sunken flex items-center gap-1.5">
                <span>✓ Done / Deselect</span>
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Consolidated Control Bar -->
    <div id="bottom-control-bar" class="bevel-raised bg-[#c0c0c0] p-1.5 flex items-center justify-between gap-1 select-none shrink-0 border-t border-[#808080]">
      
      <!-- Left 3 Consolidated Buttons -->
      <div class="flex items-center gap-1 sm:gap-2">
        <!-- 1. Menu Button -->
        <button id="btn-bottom-menu" class="bevel-raised px-2.5 sm:px-3.5 py-2 flex items-center gap-1.5 bg-[#c0c0c0] hover:bg-gray-200 active:bevel-sunken font-bold text-xs sm:text-sm text-gray-900" title="Open Menu (File, Edit, View, Image)">
          <span class="text-sm">📁</span>
          <span>Menu</span>
        </button>

        <!-- 2. Tool Button -->
        <button id="btn-bottom-tools" class="bevel-raised px-2.5 sm:px-3.5 py-2 flex items-center gap-1.5 bg-[#c0c0c0] hover:bg-gray-200 active:bevel-sunken font-bold text-xs sm:text-sm text-gray-900" title="Choose Tool & Size">
          <span id="bottom-tool-icon" class="w-4 h-4 flex items-center justify-center"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 17c3-3 4-8 8-8s4 6 7 6 3-3 3-5"/></svg></span>
          <span id="bottom-tool-name">Scribble (1px)</span>
        </button>

        <!-- 3. Palette Button -->
        <button id="btn-bottom-palette" class="bevel-raised px-2.5 sm:px-3.5 py-2 flex items-center gap-2 bg-[#c0c0c0] hover:bg-gray-200 active:bevel-sunken font-bold text-xs sm:text-sm text-gray-900" title="Choose Colors">
          <div class="relative w-5 h-5 bevel-sunken bg-gray-400 shrink-0">
            <div id="dock-bg-swatch" class="absolute right-0 bottom-0 w-3.5 h-3.5 bg-white border border-gray-600"></div>
            <div id="dock-fg-swatch" class="absolute left-0 top-0 w-3.5 h-3.5 bg-black border border-gray-600 z-10"></div>
          </div>
          <span>Colors</span>
        </button>


      </div>

      <!-- Right Quick Actions -->
      <div class="flex items-center gap-1">
        <button id="quick-undo" class="bevel-raised px-2.5 py-2 hover:bg-gray-200 active:bevel-sunken font-bold text-xs" title="Undo (Ctrl+Z)">↩</button>
        <button id="quick-redo" class="bevel-raised px-2.5 py-2 hover:bg-gray-200 active:bevel-sunken font-bold text-xs" title="Redo (Ctrl+Y)">↪</button>
        <button id="quick-reset-view" class="bevel-raised px-2.5 py-2 hover:bg-gray-200 active:bevel-sunken font-bold text-xs" title="Reset View">🔍</button>
        <span id="status-coords" class="font-mono text-[10px] text-gray-700 w-16 text-center hidden md:inline">- , -</span>
      </div>

    </div>

  </div>

  <!-- In-Page Modals (New Canvas, Export, Text Stamp, Help) -->
  
  <!-- New / Resize Canvas Modal -->
  <div id="modal-canvas-size" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-3">
    <div class="bevel-raised bg-[#c0c0c0] w-84 max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2 py-1 font-bold text-xs flex justify-between items-center">
        <span id="canvas-modal-title">New Canvas Attributes</span>
        <button id="btn-close-canvas-modal" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none">✕</button>
      </div>
      <div class="p-3 text-xs flex flex-col gap-3">
        <div>
          <label class="block font-bold mb-1">Preset Sizes:</label>
          <div class="grid grid-cols-3 gap-1">
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="16" data-h="16">16 x 16</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="32" data-h="32">32 x 32</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 bg-blue-100 font-bold" data-w="64" data-h="64">64 x 64</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="128" data-h="128">128 x 128</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="256" data-h="256">256 x 256</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="320" data-h="240">320 x 240</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-w="1024" data-h="1024">1024 x 1024</button>
            <button class="preset-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold text-blue-900 bg-blue-50" data-w="3000" data-h="3000">3000 x 3000</button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="input-canvas-width" class="block font-bold mb-0.5">Width (px):</label>
            <input type="number" id="input-canvas-width" value="64" min="4" max="4096" class="w-full bevel-sunken px-2 py-1 bg-white text-right font-mono">
          </div>
          <div>
            <label for="input-canvas-height" class="block font-bold mb-0.5">Height (px):</label>
            <input type="number" id="input-canvas-height" value="64" min="4" max="4096" class="w-full bevel-sunken px-2 py-1 bg-white text-right font-mono">
          </div>
        </div>

        <div>
          <label for="select-canvas-bg" class="block font-bold mb-0.5">Initial Background:</label>
          <select id="select-canvas-bg" class="w-full bevel-sunken px-2 py-1 bg-white">
            <option value="white">White (Classic Paint)</option>
            <option value="transparent">Transparent</option>
            <option value="black">Black</option>
            <option value="current">Current Background Color</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 mt-2">
          <button id="btn-apply-canvas-size" class="bevel-raised px-5 py-1.5 font-bold hover:bg-gray-200 active:bevel-sunken bg-blue-100 text-blue-900">OK</button>
          <button id="btn-cancel-canvas-size" class="bevel-raised px-4 py-1.5 hover:bg-gray-200 active:bevel-sunken">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Export Scaled Pixel Art Modal -->
  <div id="modal-export" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-3">
    <div class="bevel-raised bg-[#c0c0c0] w-84 max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2 py-1 font-bold text-xs flex justify-between items-center">
        <span>Export Pixel Art PNG</span>
        <button id="btn-close-export-modal" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none">✕</button>
      </div>
      <div class="p-3 text-xs flex flex-col gap-3">
        <p class="text-gray-700 leading-relaxed">
          Export at crisp nearest-neighbor scale without anti-aliasing blur:
        </p>

        <div>
          <label class="block font-bold mb-1">Scale Factor:</label>
          <div class="grid grid-cols-3 gap-1">
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-scale="1">1x (Native)</button>
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-scale="2">2x</button>
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-scale="4">4x</button>
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 bg-blue-100 font-bold text-blue-900" data-scale="8">8x (HD)</button>
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-scale="12">12x</button>
            <button class="scale-btn bevel-raised p-2 text-center hover:bg-gray-200 font-bold" data-scale="16">16x (Huge)</button>
          </div>
        </div>

        <div class="text-xs text-gray-800 bg-gray-100 p-2 bevel-sunken">
          Export Dimensions: <span id="export-calc-dimensions" class="font-bold font-mono">512 x 512 px</span>
        </div>

        <div class="flex justify-end gap-2 mt-2">
          <button id="btn-download-export-png" class="bevel-raised px-5 py-1.5 font-bold hover:bg-gray-200 active:bevel-sunken bg-blue-100 text-blue-900">Download PNG</button>
          <button id="btn-cancel-export" class="bevel-raised px-4 py-1.5 hover:bg-gray-200 active:bevel-sunken">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Text Stamp Modal & Formatting Options -->
  <div id="modal-text-stamp" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-3">
    <div class="bevel-raised bg-[#c0c0c0] w-96 max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2 py-1 font-bold text-xs flex justify-between items-center">
        <span>Pixel Text Formatting</span>
        <button id="btn-close-text-modal" type="button" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none cursor-pointer">✕</button>
      </div>
      <div class="p-3 text-xs flex flex-col gap-2.5 bg-[#dfdfdf] bevel-sunken max-h-[85vh] overflow-y-auto">
        <!-- Text Input -->
        <div>
          <label for="input-stamp-text" class="block font-bold mb-1 text-gray-800">Text Content:</label>
          <input type="text" id="input-stamp-text" value="PIXEL" maxlength="32" class="w-full bevel-sunken px-2 py-1.5 bg-white text-xs font-mono">
        </div>

        <!-- Formatting Controls Grid -->
        <div class="grid grid-cols-2 gap-2">
          <!-- Font Size (Up to 200px) -->
          <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="input-stamp-size" class="font-bold text-[11px] text-gray-800">Size:</label>
              <div class="flex items-center gap-1">
                <input type="number" id="input-stamp-size-num" min="6" max="200" value="12" class="w-12 bevel-sunken px-1 text-center font-mono font-bold text-[11px] text-blue-900 bg-white">
                <span id="label-stamp-size" class="font-mono font-bold text-[11px] text-blue-900 hidden">12px</span>
                <span class="text-[10px] text-gray-600 font-bold">px</span>
              </div>
            </div>
            <input type="range" id="input-stamp-size" min="6" max="200" step="1" value="12" class="w-full cursor-pointer">
          </div>

          <!-- Line Thickness / Stroke -->
          <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label class="font-bold text-[11px] text-gray-800">Thickness:</label>
              <span id="label-stamp-thickness" class="font-mono font-bold text-[11px] text-blue-900">1px</span>
            </div>
            <div class="flex gap-1" id="group-text-thickness">
              <button type="button" class="btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-blue-100 text-blue-900 border border-blue-500 cursor-pointer" data-thickness="1">1px</button>
              <button type="button" class="btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-gray-100 text-gray-800 cursor-pointer" data-thickness="2">2px</button>
              <button type="button" class="btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-gray-100 text-gray-800 cursor-pointer" data-thickness="3">3px</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <!-- Kerning (Letter Spacing) -->
          <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="input-stamp-kerning" class="font-bold text-[11px] text-gray-800">Kerning:</label>
              <span id="label-stamp-kerning" class="font-mono font-bold text-[11px] text-blue-900">0px</span>
            </div>
            <input type="range" id="input-stamp-kerning" min="-2" max="6" step="1" value="0" class="w-full cursor-pointer">
          </div>

          <!-- Font Family -->
          <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1">
            <label for="select-stamp-font" class="font-bold text-[11px] text-gray-800">Font Type:</label>
            <select id="select-stamp-font" class="w-full bevel-sunken px-1.5 py-1 bg-white text-xs font-mono">
              <option value="monospace">Monospace (Retro)</option>
              <option value="sans-serif">Sans-Serif (Gothic)</option>
              <option value="serif">Serif (Classic)</option>
            </select>
          </div>
        </div>

        <!-- Live 1-Bit Pixel Preview Box -->
        <div class="bevel-raised p-2 bg-[#c0c0c0] flex flex-col gap-1">
          <div class="flex items-center justify-between text-[11px] font-bold text-gray-700">
            <span>Pixel Art Preview (Zero Aura):</span>
            <span id="text-preview-dims" class="font-mono text-[10px] text-blue-800">0 x 0 px</span>
          </div>
          <div class="w-full h-16 bevel-sunken bg-white p-1 flex items-center justify-center overflow-hidden">
            <canvas id="text-modal-preview-canvas" class="pixelated block max-h-full max-w-full object-contain"></canvas>
          </div>
        </div>

        <p class="text-[10px] text-gray-600">Once placed, you can drag the words anywhere on the canvas before stamping.</p>

        <div class="flex justify-end gap-2 mt-1">
          <button id="btn-apply-stamp-text" type="button" class="bevel-raised px-4 py-1.5 font-bold hover:bg-gray-200 active:bevel-sunken bg-blue-100 text-blue-900 cursor-pointer">Stamp</button>
          <button id="btn-cancel-stamp-text" type="button" class="bevel-raised px-3 py-1.5 hover:bg-gray-200 active:bevel-sunken cursor-pointer">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Help / About / Studio Dispatch Modal -->
  <div id="modal-help" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-3 select-none">
    <div class="bevel-raised bg-[#c0c0c0] w-[540px] max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2.5 py-1.5 font-bold text-xs flex justify-between items-center">
        <div class="flex items-center gap-2">
          <span>⚔️</span>
          <span>Bit Smithery — Studio Dispatch & Manual</span>
        </div>
        <button id="btn-close-help-modal" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none hover:bg-white active:bevel-sunken font-bold">✕</button>
      </div>

      <div class="p-3.5 text-xs flex flex-col gap-3.5 max-h-[80vh] overflow-y-auto">
        <!-- Studio & App Header Banner -->
        <div class="flex items-center gap-3.5 border-b border-gray-400 pb-3">
          <div class="w-14 h-14 bevel-sunken bg-yellow-300 flex flex-col items-center justify-center font-black text-blue-900 font-mono shadow-inner shrink-0">
            <span class="text-lg leading-tight">1px</span>
            <span class="text-[9px] tracking-tighter uppercase font-bold text-blue-950">FORGE</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <h2 class="font-black text-base tracking-wide text-gray-900 font-mono">Bit Smithery</h2>
              <span class="bevel-raised px-1.5 py-0.5 text-[10px] bg-[#d4d0c8] font-mono font-bold text-blue-900">v1.0</span>
            </div>
            <div class="text-gray-700 text-[11px] font-semibold mt-0.5">
              1-Pixel Precision Creative Studio
            </div>
            <div class="text-blue-900 text-[11px] font-bold mt-0.5 flex items-center gap-1">
              <span>Presented by</span>
              <span class="underline decoration-blue-500 font-mono">Disembodied Interactive</span>
            </div>
          </div>
        </div>

        <!-- Message from Disembodied Interactive -->
        <div class="bevel-sunken bg-white p-3 border-l-4 border-[#000080] shadow-sm">
          <div class="flex items-center gap-1.5 font-bold text-blue-950 text-xs mb-1.5">
            <span>🗡️</span>
            <span>A Message from Disembodied Interactive</span>
          </div>
          <p class="text-gray-800 text-[11.5px] leading-relaxed italic">
            "Welcome to Bit Smithery! This app was forged for artists, retro game developers, and pixel purists who want precision in their image editing workflow. No blurry anti-aliasing interpolation or unintentional color feathering, this digital studio mixes crisp pixel editing with fluid multi-touch panning and zooming. Whether you're forging tiny 16x16 sprites or massive game world backgrounds, this tool was crafted for your hands. Thank you for creating with us."
          </p>
          <div class="text-right text-[11px] font-bold text-gray-600 mt-2">
            — Disembodied Interactive
          </div>
        </div>

        <!-- The 9 Master Tools -->
        <div>
          <h4 class="font-bold text-blue-950 text-xs mb-1.5 flex items-center gap-1">
            <span>🛠️</span>
            <span>Tools of the Forge</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-gray-800">
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Scribble (P):</strong> 1-pixel freehand stylus with pure Bresenham rasterization.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Vector (L):</strong> 2-point geometric straight lines.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Splash (F):</strong> Rapid contiguous flood bucket fill.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Sample (I):</strong> Chemical glass dropper for picking colors.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Focus (Z / +):</strong> Desk inspection glass for deep magnification.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Bevel (R):</strong> Bordered geometric rectangles and frames.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Cutout:</strong> Freehand lasso selection marquee.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300">
              <strong class="text-blue-900">Smart Select (M):</strong> 8-way adjacent & global color selection.
            </div>
            <div class="bg-gray-100 p-1.5 rounded border border-gray-300 sm:col-span-2">
              <strong class="text-blue-900">Spline:</strong> Multi-node smooth curved lines.
            </div>
          </div>
        </div>

        <!-- Touch, Gestures & Workflow -->
        <div>
          <h4 class="font-bold text-blue-950 text-xs mb-1.5 flex items-center gap-1">
            <span>📱</span>
            <span>Touch Navigation & Mobile Gestures</span>
          </h4>
          <ul class="list-disc pl-4 text-gray-800 space-y-1 text-[11px]">
            <li><strong>Two-Finger Pinch:</strong> Smoothly zoom in and out centered directly on your fingertips.</li>
            <li><strong>Two-Finger Drag:</strong> Pan and scroll the canvas across the workbench.</li>
            <li><strong>One-Finger Background Drag:</strong> Dragging the gray workspace outside the canvas also pans.</li>
            <li><strong>Protected Single-Finger Taps:</strong> Splash, Sample, and Text Stamp activate strictly on stationary taps, preventing accidental triggers during gestures.</li>
            <li><strong>Text Tool Staging:</strong> Type in custom text, preview sharp 1-bit thresholding, and drag the bounding box anywhere on canvas before stamping.</li>
          </ul>
        </div>

        <!-- Modal Actions & Copyright -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 pt-3 border-t border-gray-400">
          <div class="flex flex-col text-left">
            <span class="text-[11px] text-gray-800 font-bold font-mono">
              © 2026 Disembodied Interactive. All rights reserved.
            </span>
            <span class="text-[10px] text-gray-500 font-mono">
              Reopen anytime via Menu &gt; ❓ Help
            </span>
          </div>
          <button id="btn-ok-help" class="bevel-raised px-6 py-2 font-black hover:bg-white active:bevel-sunken bg-blue-100 text-blue-900 text-xs tracking-wider uppercase shadow shrink-0">
            Enter the Forge
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Selection Custom Resize Modal -->
  <div id="modal-sel-custom-size" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-3">
    <div class="bevel-raised bg-[#c0c0c0] w-72 max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2 py-1 font-bold text-xs flex justify-between items-center">
        <span>Resize Selection</span>
        <button id="btn-close-sel-size-modal" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none">✕</button>
      </div>
      <div class="p-3 text-xs flex flex-col gap-3">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="input-sel-width" class="block font-bold mb-0.5">Width (px):</label>
            <input type="number" id="input-sel-width" min="1" max="4096" class="w-full bevel-sunken px-2 py-1 bg-white text-right font-mono">
          </div>
          <div>
            <label for="input-sel-height" class="block font-bold mb-0.5">Height (px):</label>
            <input type="number" id="input-sel-height" min="1" max="4096" class="w-full bevel-sunken px-2 py-1 bg-white text-right font-mono">
          </div>
        </div>
        <div class="flex justify-end gap-2 mt-1">
          <button id="btn-apply-sel-size" class="bevel-raised px-4 py-1.5 font-bold hover:bg-gray-200 active:bevel-sunken bg-blue-100 text-blue-900">Resize</button>
          <button id="btn-cancel-sel-size" class="bevel-raised px-3 py-1.5 hover:bg-gray-200 active:bevel-sunken">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Layer Rename Modal -->
  <div id="modal-layer-rename" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-3">
    <div class="bevel-raised bg-[#c0c0c0] w-72 max-w-full p-1 flex flex-col shadow-2xl">
      <div class="bg-[#000080] text-white px-2 py-1 font-bold text-xs flex justify-between items-center">
        <span>Rename Layer</span>
        <button id="btn-close-rename-modal" type="button" class="w-5 h-5 bevel-raised bg-[#c0c0c0] text-black text-xs leading-none">✕</button>
      </div>
      <div class="p-3 text-xs flex flex-col gap-3">
        <div>
          <label for="input-layer-name" class="block font-bold mb-1">Layer Name:</label>
          <input type="text" id="input-layer-name" maxlength="24" class="w-full bevel-sunken px-2 py-1 bg-white text-xs font-mono">
        </div>
        <div class="flex justify-end gap-2 mt-1">
          <button id="btn-apply-layer-name" type="button" class="bevel-raised px-4 py-1.5 font-bold hover:bg-gray-200 active:bevel-sunken bg-blue-100 text-blue-900">OK</button>
          <button id="btn-cancel-layer-name" type="button" class="bevel-raised px-3 py-1.5 hover:bg-gray-200 active:bevel-sunken">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden File Input for Opening Images -->
  <input type="file" id="file-input-image" accept="image/*" class="hidden">

  <!-- Application Logic -->
  <script>
    (function () {
      'use strict';

      // --- State ---
      const state = {
        tool: 'pencil', // pencil, line, eraser, fill, picker, zoom, rect, ellipse, roundrect, spray, brush, select, text, curve, polygon
        pencilSize: 1, // STRICTLY 1 pixel default!
        lineThickness: 1, // STRICTLY 1 pixel default!
        eraserSize: 4,
        brushSize: 3,
        brushShape: 'circle', // circle, square, slash-f, slash-b
        sprayRadius: 6,
        shapeMode: 'outline', // outline, outline-fill, fill
        selectTransparent: false, // Default OFF (keeps secondary color intact)
        magicMode: 'adjacent', // 'adjacent' or 'global'
        lastMagicClickX: null,
        lastMagicClickY: null,

        fgColor: '#000000',
        bgColor: '#ffffff',
        activePaletteTarget: 'fg', // 'fg' or 'bg'
        presetColors: ['#000000', '#ffffff', '#ff0000', '#ffff00', '#0000ff'],
        selectedPresetIndex: 0, // Slot 0 (Black) selected by default
        editingPresetIndex: null,

        width: 64,
        height: 64,
        zoom: 8, // 800% default
        panX: 0,
        panY: 0,
        showGrid: true,

        isDrawing: false,
        mouseButton: 0, // 0 = left (fg), 2 = right (bg)
        lastX: null,
        lastY: null,
        startX: null,
        startY: null,

        history: [],
        historyIndex: -1,
        maxHistory: 30,

        // Selection state
        selection: null,
        pendingStampX: 0,
        pendingStampY: 0,

        // Curve, Polygon, and Lasso tool states
        curveStep: 0, // 0 = line, 1 = bend 1, 2 = bend 2
        curveP0: null,
        curveP1: null,
        curveP2: null,
        curveP3: null,
        polygonPoints: [],
        lassoPoints: [],

        // Staged shape and handles state
        stagedShape: null,
        draggingHandleIndex: null,

        // Staged text state
        stagedText: null,
        textThickness: 1,

        // Layers state
        layers: [],
        activeLayerIndex: 0,
        layerCounter: 1,
        renamingLayerIndex: null
      };

      // --- DOM Elements ---
      const paintCanvas = document.getElementById('paint-canvas');
      const paintCtx = paintCanvas.getContext('2d', { willReadFrequently: true });
      const previewCanvas = document.getElementById('preview-canvas');
      const previewCtx = previewCanvas.getContext('2d');
      const gridCanvas = document.getElementById('grid-canvas');
      const gridCtx = gridCanvas.getContext('2d');
      const canvasWrapper = document.getElementById('canvas-wrapper');
      const canvasContainer = document.getElementById('canvas-container');

      // Overlays and Backdrop
      const overlayBackdrop = document.getElementById('overlay-backdrop');
      const overlayMenu = document.getElementById('overlay-menu');
      const overlayTools = document.getElementById('overlay-tools');
      const overlayPalette = document.getElementById('overlay-palette');
      const overlaySelection = document.getElementById('overlay-selection');
      const selectionOverlayTitle = document.getElementById('selection-overlay-title');
      const btnCloseSelectionOverlay = document.getElementById('btn-close-selection-overlay');
      const btnSelectionEdit = document.getElementById('btn-selection-edit');
      const selectionContentCanvas = document.getElementById('selection-content-canvas');
      const floatingMoveBar = document.getElementById('floating-move-bar');
      const btnCommitMove = document.getElementById('btn-commit-move');
      const btnCancelMove = document.getElementById('btn-cancel-move');
      const btnToggleTransparentSelection = document.getElementById('btn-toggle-transparent-selection');
      const transSwitchIcon = document.getElementById('trans-switch-icon');
      const transSwitchStatus = document.getElementById('trans-switch-status');
      const btnSelMove = document.getElementById('btn-sel-move');
      const btnSelErase = document.getElementById('btn-sel-erase');
      const btnSelScale2x = document.getElementById('btn-sel-scale-2x');
      const btnSelScaleHalf = document.getElementById('btn-sel-scale-half');
      const btnSelScaleCustom = document.getElementById('btn-sel-scale-custom');
      const btnSelFlipH = document.getElementById('btn-sel-flip-h');
      const btnSelFlipV = document.getElementById('btn-sel-flip-v');
      const btnSelRotate = document.getElementById('btn-sel-rotate');
      const btnSelSelectAll = document.getElementById('btn-sel-select-all');
      const btnSelAllFit = document.getElementById('btn-sel-all-fit');
      const btnSelScaleFitCanvas = document.getElementById('btn-sel-scale-fit-canvas');
      const actionSelectAllFit = document.getElementById('action-select-all-fit');
      const btnSelCopy = document.getElementById('btn-sel-copy');
      const btnSelCut = document.getElementById('btn-sel-cut');
      const btnSelPaste = document.getElementById('btn-sel-paste');
      const lassoSvg = document.getElementById('lasso-svg');
      const lassoPolyFill = document.getElementById('lasso-poly-fill');
      const lassoPolyBlack = document.getElementById('lasso-poly-black');
      const lassoPolyWhite = document.getElementById('lasso-poly-white');
      const magicSvg = document.getElementById('magic-svg');
      const magicPathBlack = document.getElementById('magic-path-black');
      const magicPathWhite = document.getElementById('magic-path-white');
      const btnSelInvert = document.getElementById('btn-sel-invert');
      const btnSelDeselect = document.getElementById('btn-sel-deselect');
      const modalSelCustomSize = document.getElementById('modal-sel-custom-size');
      const inputSelWidth = document.getElementById('input-sel-width');
      const inputSelHeight = document.getElementById('input-sel-height');
      const btnApplySelSize = document.getElementById('btn-apply-sel-size');
      const btnCancelSelSize = document.getElementById('btn-cancel-sel-size');
      const btnCloseSelSizeModal = document.getElementById('btn-close-sel-size-modal');
      const btnSelPickColor = document.getElementById('btn-sel-pick-color');
      const btnSelFillColor = document.getElementById('btn-sel-fill-color');
      const btnSelModeAdj = document.getElementById('btn-sel-mode-adj');
      const btnSelModeGlob = document.getElementById('btn-sel-mode-glob');
      const selColorSwatchBox = document.getElementById('sel-color-swatch-box');
      const selColorHexText = document.getElementById('sel-color-hex-text');
      const selMagicModeRow = document.getElementById('sel-magic-mode-row');

      // Live Dimensions Badge Elements
      const liveDimensionBadge = document.getElementById('live-dimension-badge');
      const liveDimensionText = document.getElementById('live-dimension-text');

      // Staged Shape Elements
      const handle0 = document.getElementById('shape-handle-0');
      const handle1 = document.getElementById('shape-handle-1');
      const handle2 = document.getElementById('shape-handle-2');
      const handle3 = document.getElementById('shape-handle-3');
      const floatingShapeBar = document.getElementById('floating-shape-bar');
      const btnCommitShape = document.getElementById('btn-commit-shape');
      const btnCancelShape = document.getElementById('btn-cancel-shape');

      // Layers Elements
      const btnToggleLayers = document.getElementById('btn-toggle-layers');
      const layersPanel = document.getElementById('layers-panel');
      const btnCloseLayersPanel = document.getElementById('btn-close-layers-panel');
      const btnLayerAdd = document.getElementById('btn-layer-add');
      const btnLayerDelete = document.getElementById('btn-layer-delete');
      const btnLayerMergeDown = document.getElementById('btn-layer-merge-down');
      const btnLayerMergeAll = document.getElementById('btn-layer-merge-all');
      const layersItemsList = document.getElementById('layers-items-list');
      const layersCountBadge = document.getElementById('layers-count-badge');
      const layersArrow = document.getElementById('layers-arrow');
      const layerOpacitySlider = document.getElementById('layer-opacity-slider');
      const layerOpacityVal = document.getElementById('layer-opacity-val');

      // Layer Rename Modal Elements
      const modalLayerRename = document.getElementById('modal-layer-rename');
      const inputLayerName = document.getElementById('input-layer-name');
      const btnApplyLayerName = document.getElementById('btn-apply-layer-name');
      const btnCancelLayerName = document.getElementById('btn-cancel-layer-name');
      const btnCloseRenameModal = document.getElementById('btn-close-rename-modal');

      // Bottom Bar Buttons
      const btnBottomMenu = document.getElementById('btn-bottom-menu');
      const btnBottomTools = document.getElementById('btn-bottom-tools');
      const btnBottomPalette = document.getElementById('btn-bottom-palette');
      const bottomToolIcon = document.getElementById('bottom-tool-icon');
      const bottomToolName = document.getElementById('bottom-tool-name');
      const dockFgSwatch = document.getElementById('dock-fg-swatch');
      const dockBgSwatch = document.getElementById('dock-bg-swatch');
      const quickColorBar = document.getElementById('quick-color-bar');
      const quickColorSwap = document.getElementById('quick-color-swap');
      const quickSwatchFg = document.getElementById('quick-swatch-fg');
      const quickSwatchBg = document.getElementById('quick-swatch-bg');
      const presetButtons = document.querySelectorAll('.quick-preset-btn');

      // Overlay Close Buttons
      const btnCloseMenuOverlay = document.getElementById('btn-close-menu-overlay');
      const btnCancelMenuOverlay = document.getElementById('btn-cancel-menu-overlay');
      const btnCloseToolsOverlay = document.getElementById('btn-close-tools-overlay');
      const btnDoneToolsOverlay = document.getElementById('btn-done-tools-overlay');
      const btnClosePaletteOverlay = document.getElementById('btn-close-palette-overlay');
      const btnDonePaletteOverlay = document.getElementById('btn-done-palette-overlay');

      // Quick Actions
      const quickUndo = document.getElementById('quick-undo');
      const quickRedo = document.getElementById('quick-redo');
      const quickResetView = document.getElementById('quick-reset-view');

      // Menu Tabs
      const menuTabs = [
        { btn: document.getElementById('menu-btn-file'), panel: document.getElementById('menu-dropdown-file') },
        { btn: document.getElementById('menu-btn-edit'), panel: document.getElementById('menu-dropdown-edit') },
        { btn: document.getElementById('menu-btn-view'), panel: document.getElementById('menu-dropdown-view') },
        { btn: document.getElementById('menu-btn-image'), panel: document.getElementById('menu-dropdown-image') },
        { btn: document.getElementById('menu-btn-colors'), panel: document.getElementById('menu-dropdown-colors') },
        { btn: document.getElementById('menu-btn-help'), panel: document.getElementById('menu-dropdown-help') }
      ];

      // Palette overlay elements
      const targetFgBtn = document.getElementById('target-fg-btn');
      const targetBgBtn = document.getElementById('target-bg-btn');
      const paletteTargetLabel = document.getElementById('palette-target-label');
      const fgColorSwatch = document.getElementById('fg-color-swatch');
      const bgColorSwatch = document.getElementById('bg-color-swatch');
      const paletteGrid = document.getElementById('palette-grid');
      const nativeColorPicker = document.getElementById('native-color-picker');
      const btnSwapFgBg = document.getElementById('btn-swap-fg-bg');
      const btnResetPresets = document.getElementById('btn-reset-presets');

      // Tools overlay elements
      const toolbox = document.getElementById('toolbox');
      const toolOptionsPanel = document.getElementById('tool-options-panel');
      const toolOptionsHeader = document.getElementById('tool-options-header');

      // Status elements
      const statusHint = document.getElementById('status-hint');
      const statusCoords = document.getElementById('status-coords');
      const statusDimensions = document.getElementById('status-dimensions');
      const statusZoom = document.getElementById('status-zoom');

      const btnResetView = document.getElementById('btn-reset-view');
      const btnToggleGrid = document.getElementById('btn-toggle-grid');
      const gridCheckIndicator = document.getElementById('grid-check-indicator');
      const selectionBox = document.getElementById('selection-box');
      const fileInputImage = document.getElementById('file-input-image');

      // Modals
      const modalCanvasSize = document.getElementById('modal-canvas-size');
      const inputCanvasWidth = document.getElementById('input-canvas-width');
      const inputCanvasHeight = document.getElementById('input-canvas-height');
      const selectCanvasBg = document.getElementById('select-canvas-bg');
      const btnApplyCanvasSize = document.getElementById('btn-apply-canvas-size');
      const btnCancelCanvasSize = document.getElementById('btn-cancel-canvas-size');
      const btnCloseCanvasModal = document.getElementById('btn-close-canvas-modal');

      const modalExport = document.getElementById('modal-export');
      const exportCalcDimensions = document.getElementById('export-calc-dimensions');
      const btnDownloadExportPng = document.getElementById('btn-download-export-png');
      const btnCancelExport = document.getElementById('btn-cancel-export');
      const btnCloseExportModal = document.getElementById('btn-close-export-modal');
      let currentExportScale = 8;

      const modalTextStamp = document.getElementById('modal-text-stamp');
      const inputStampText = document.getElementById('input-stamp-text');
      const inputStampSize = document.getElementById('input-stamp-size');
      const inputStampSizeNum = document.getElementById('input-stamp-size-num');
      const labelStampSize = document.getElementById('label-stamp-size');
      const inputStampKerning = document.getElementById('input-stamp-kerning');
      const labelStampKerning = document.getElementById('label-stamp-kerning');
      const selectStampFont = document.getElementById('select-stamp-font');
      const labelStampThickness = document.getElementById('label-stamp-thickness');
      const textModalPreviewCanvas = document.getElementById('text-modal-preview-canvas');
      const textPreviewDims = document.getElementById('text-preview-dims');
      const btnApplyStampText = document.getElementById('btn-apply-stamp-text');
      const btnCancelStampText = document.getElementById('btn-cancel-stamp-text');
      const btnCloseTextModal = document.getElementById('btn-close-text-modal');

      const textDragBox = document.getElementById('text-drag-box');
      const floatingTextBar = document.getElementById('floating-text-bar');
      const btnCommitText = document.getElementById('btn-commit-text');
      const btnEditStagedText = document.getElementById('btn-edit-staged-text');
      const btnCancelText = document.getElementById('btn-cancel-text');

      const modalHelp = document.getElementById('modal-help');
      const btnCloseHelpModal = document.getElementById('btn-close-help-modal');
      const btnOkHelp = document.getElementById('btn-ok-help');

      // Disable default canvas context menu for right-click drawing
      paintCanvas.addEventListener('contextmenu', e => e.preventDefault());
      previewCanvas.addEventListener('contextmenu', e => e.preventDefault());
      canvasWrapper.addEventListener('contextmenu', e => e.preventDefault());

      // --- Overlay Management (Consolidated Mobile UI) ---
      let lastOverlayOpenedAt = 0;

      function closeAllOverlays() {
        overlayBackdrop.classList.add('hidden');
        overlayMenu.classList.add('hidden');
        overlayTools.classList.add('hidden');
        overlayPalette.classList.add('hidden');
        if (overlaySelection) overlaySelection.classList.add('hidden');
        btnBottomMenu.classList.remove('active');
        btnBottomTools.classList.remove('active');
        btnBottomPalette.classList.remove('active');
        state.editingPresetIndex = null;
        if (paletteTargetLabel) paletteTargetLabel.textContent = 'Target: Foreground';
      }

      function openOverlay(overlay, triggerBtn) {
        const isAlreadyOpen = !overlay.classList.contains('hidden');
        const savedEditPreset = state.editingPresetIndex;
        closeAllOverlays();
        state.editingPresetIndex = savedEditPreset; // Preserve target preset
        if (!isAlreadyOpen) {
          lastOverlayOpenedAt = Date.now();
          overlayBackdrop.classList.remove('hidden');
          overlay.classList.remove('hidden');
          if (triggerBtn) triggerBtn.classList.add('active');
        }
      }

      function updateTransparentSwitchUI() {
        if (!btnToggleTransparentSelection || !transSwitchIcon || !transSwitchStatus) return;
        if (state.selectTransparent) {
          transSwitchIcon.textContent = '🟢';
          transSwitchStatus.textContent = 'Transparent (Delete Secondary)';
          btnToggleTransparentSelection.className = 'bevel-raised px-3 py-1.5 font-bold text-xs flex items-center gap-1.5 bg-green-100 text-green-900 border border-green-600 active:bevel-sunken cursor-pointer select-none';
          btnToggleTransparentSelection.title = 'Current: Matching secondary color pixels are deleted / transparent';
        } else {
          transSwitchIcon.textContent = '⚪';
          transSwitchStatus.textContent = 'Opaque (Keep All Colors)';
          btnToggleTransparentSelection.className = 'bevel-raised px-3 py-1.5 font-bold text-xs flex items-center gap-1.5 bg-gray-200 text-gray-800 hover:bg-white active:bevel-sunken cursor-pointer select-none';
          btnToggleTransparentSelection.title = 'Current: All pixels are kept solid, secondary color is not deleted';
        }
      }

      function deleteSecondaryColorFromSelection() {
        if (!state.selection) return;
        const s = state.selection;

        const tempDiv = document.createElement('div');
        tempDiv.style.color = state.bgColor;
        document.body.appendChild(tempDiv);
        const bgRgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
        document.body.removeChild(tempDiv);

        const d = s.imgData.data;
        for (let i = 0; i < d.length; i += 4) {
          if (d[i] === bgRgb[0] && d[i + 1] === bgRgb[1] && d[i + 2] === bgRgb[2]) {
            d[i + 3] = 0; // Transparent (deleted)
          }
        }

        if (state.selectionMoving) {
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          if (state.activeLayerIndex === 0) {
            targetCtx.fillStyle = state.bgColor;
            targetCtx.fillRect(s.x, s.y, s.w, s.h);
          } else {
            targetCtx.clearRect(s.x, s.y, s.w, s.h);
          }
          renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, true, state.bgColor);
          compositeLayers();
          saveHistoryState();
        }
      }

      function updateMagicSelectionMenuUI() {
        if (!state.selection) return;
        const s = state.selection;

        if (!s.sampledHexColor) {
          const d = s.imgData.data;
          let found = false;
          for (let i = 0; i < d.length; i += 4) {
            if (d[i + 3] > 0) {
              s.sampledHexColor = '#' + [d[i], d[i+1], d[i+2]].map(v => v.toString(16).padStart(2, '0')).join('');
              found = true;
              break;
            }
          }
          if (!found) s.sampledHexColor = 'transparent';
        }

        if (selColorHexText && selColorSwatchBox) {
          if (s.sampledHexColor === 'transparent') {
            selColorHexText.textContent = 'Transparent';
            selColorSwatchBox.style.backgroundColor = 'transparent';
            selColorSwatchBox.style.border = '1px dashed #888';
          } else {
            selColorHexText.textContent = s.sampledHexColor;
            selColorSwatchBox.style.backgroundColor = s.sampledHexColor;
            selColorSwatchBox.style.border = '1px solid #000';
          }
        }

        if (btnSelModeAdj && btnSelModeGlob) {
          if (state.magicMode === 'adjacent') {
            btnSelModeAdj.className = 'bevel-raised px-2.5 py-1 text-[11px] font-bold bg-blue-100 text-blue-900 border border-blue-500 active:bevel-sunken cursor-pointer';
            btnSelModeGlob.className = 'bevel-raised px-2.5 py-1 text-[11px] font-bold bg-gray-100 text-gray-800 hover:bg-white active:bevel-sunken cursor-pointer';
          } else {
            btnSelModeAdj.className = 'bevel-raised px-2.5 py-1 text-[11px] font-bold bg-gray-100 text-gray-800 hover:bg-white active:bevel-sunken cursor-pointer';
            btnSelModeGlob.className = 'bevel-raised px-2.5 py-1 text-[11px] font-bold bg-blue-100 text-blue-900 border border-blue-500 active:bevel-sunken cursor-pointer';
          }
        }

        if (selectionOverlayTitle) {
          if (s.isMagic) {
            selectionOverlayTitle.textContent = `Magic Select (${state.magicMode === 'global' ? 'Global' : 'Adjacent'} - ${s.w}x${s.h} px)`;
          } else {
            selectionOverlayTitle.textContent = `Selection Actions (${s.w} x ${s.h} px)`;
          }
        }
      }

      function openSelectionMenu() {
        if (!state.selection) return;
        updateTransparentSwitchUI();
        updateMagicSelectionMenuUI();
        openOverlay(overlaySelection);
      }

      btnBottomMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        openOverlay(overlayMenu, btnBottomMenu);
      });

      btnBottomTools.addEventListener('click', (e) => {
        e.stopPropagation();
        renderToolOptions();
        openOverlay(overlayTools, btnBottomTools);
      });

      btnBottomPalette.addEventListener('click', (e) => {
        e.stopPropagation();
        openOverlay(overlayPalette, btnBottomPalette);
      });

      // Close on backdrop tap (tapping outside the overlay)
      overlayBackdrop.addEventListener('click', (e) => {
        // Prevent ghost click immediately after opening on mobile
        if (Date.now() - lastOverlayOpenedAt < 350) return;
        if (e.target === overlayBackdrop) {
          closeAllOverlays();
        }
      });

      btnCloseMenuOverlay.addEventListener('click', closeAllOverlays);
      btnCancelMenuOverlay.addEventListener('click', closeAllOverlays);
      btnCloseToolsOverlay.addEventListener('click', closeAllOverlays);
      btnDoneToolsOverlay.addEventListener('click', closeAllOverlays);
      btnClosePaletteOverlay.addEventListener('click', closeAllOverlays);
      btnDonePaletteOverlay.addEventListener('click', closeAllOverlays);

      // Menu Tabs Switching
      menuTabs.forEach(tab => {
        tab.btn.addEventListener('click', () => {
          menuTabs.forEach(t => {
            t.btn.classList.remove('active');
            t.panel.classList.add('hidden');
          });
          tab.btn.classList.add('active');
          tab.panel.classList.remove('hidden');
        });
      });

      // --- Classic 28 MS Paint Color Palette ---
      const classicColors = [
        // Row 1
        '#000000', '#808080', '#800000', '#808000', '#008000', '#008080', '#000080', '#800080', '#808040', '#004040', '#0080ff', '#004080', '#8000ff', '#804000',
        // Row 2
        '#ffffff', '#c0c0c0', '#ff0000', '#ffff00', '#00ff00', '#00ffff', '#0000ff', '#ff00ff', '#ffff80', '#00ff80', '#80ffff', '#7f88e8', '#ff0080', '#ff8040'
      ];

      function initPalette() {
        paletteGrid.innerHTML = '';
        classicColors.forEach(hex => {
          const swatch = document.createElement('button');
          swatch.className = 'w-full h-10 bevel-sunken cursor-pointer hover:opacity-90 active:scale-95 transition-transform flex items-center justify-center';
          swatch.style.backgroundColor = hex;
          swatch.title = hex;

          swatch.addEventListener('click', (e) => {
            e.stopPropagation();
            if (state.activePaletteTarget === 'fg') {
              applyNewForegroundColor(hex);
            } else {
              state.bgColor = hex;
              updateColorDisplay();
            }
            closeAllOverlays();
          });

          paletteGrid.appendChild(swatch);
        });
      }

      function applyNewForegroundColor(hex) {
        state.fgColor = hex;
        // Only update a preset slot if the user explicitly clicked an active preset to reassign it
        if (state.editingPresetIndex !== null && state.editingPresetIndex >= 0 && state.editingPresetIndex < state.presetColors.length) {
          state.presetColors[state.editingPresetIndex] = hex;
          state.selectedPresetIndex = state.editingPresetIndex;
        }
        state.editingPresetIndex = null;
        updateColorDisplay();
      }

      function updateQuickColorBar() {
        if (!quickSwatchFg || !quickSwatchBg) return;
        quickSwatchFg.style.backgroundColor = state.fgColor;
        quickSwatchBg.style.backgroundColor = state.bgColor;

        const activeHex = state.fgColor.toLowerCase();
        presetButtons.forEach((btn, idx) => {
          const col = state.presetColors[idx];
          btn.style.backgroundColor = col;
          btn.dataset.color = col;
          btn.title = `Preset ${idx + 1}: ${col} (Tap to select, tap again to change)`;
          
          const isSelected = (state.selectedPresetIndex === idx);
          const isColorMatch = (activeHex === col.toLowerCase());

          if (isSelected || isColorMatch) {
            btn.classList.add('ring-2', 'ring-blue-700', 'ring-offset-1', 'z-10');
            const isLight = ['#ffffff', '#ffff00', '#00ffff', '#ffff80'].includes(col.toLowerCase());
            btn.innerHTML = `<span class="block w-2.5 h-2.5 rounded-full ${isLight ? 'bg-black' : 'bg-white'} shadow-sm"></span>`;
          } else {
            btn.classList.remove('ring-2', 'ring-blue-700', 'ring-offset-1', 'z-10');
            btn.innerHTML = '';
          }
        });
      }

      function onPresetClick(idx) {
        const currentColor = state.presetColors[idx].toLowerCase();
        const activeColor = state.fgColor.toLowerCase();

        if (currentColor === activeColor || state.selectedPresetIndex === idx) {
          // Already the active color/preset! Open palette to change this preset
          state.editingPresetIndex = idx;
          state.selectedPresetIndex = idx;
          state.activePaletteTarget = 'fg';
          targetFgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-blue-100 text-blue-900 border border-blue-500';
          targetBgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-gray-200 text-gray-700';
          paletteTargetLabel.textContent = `Change Preset ${idx + 1} Color`;
          openOverlay(overlayPalette, btnBottomPalette);
        } else {
          // Select this preset color
          state.editingPresetIndex = null;
          state.selectedPresetIndex = idx;
          state.fgColor = state.presetColors[idx];
          updateColorDisplay();
        }
      }

      function updateColorDisplay() {
        fgColorSwatch.style.backgroundColor = state.fgColor;
        bgColorSwatch.style.backgroundColor = state.bgColor;
        dockFgSwatch.style.backgroundColor = state.fgColor;
        dockBgSwatch.style.backgroundColor = state.bgColor;
        nativeColorPicker.value = state.fgColor;
        updateQuickColorBar();
      }

      targetFgBtn.addEventListener('click', () => {
        state.activePaletteTarget = 'fg';
        targetFgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-blue-100 text-blue-900 border border-blue-500';
        targetBgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-gray-200 text-gray-700';
        paletteTargetLabel.textContent = 'Target: Foreground';
      });

      targetBgBtn.addEventListener('click', () => {
        state.activePaletteTarget = 'bg';
        targetBgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-blue-100 text-blue-900 border border-blue-500';
        targetFgBtn.className = 'bevel-raised px-2 py-0.5 font-bold bg-gray-200 text-gray-700';
        paletteTargetLabel.textContent = 'Target: Background';
      });

      btnSwapFgBg.addEventListener('click', () => {
        const tmp = state.fgColor;
        state.fgColor = state.bgColor;
        state.bgColor = tmp;
        updateColorDisplay();
      });

      fgColorSwatch.addEventListener('click', () => {
        targetFgBtn.click();
      });

      bgColorSwatch.addEventListener('click', () => {
        targetBgBtn.click();
      });

      nativeColorPicker.addEventListener('input', (e) => {
        const hex = e.target.value;
        if (state.activePaletteTarget === 'fg') {
          applyNewForegroundColor(hex);
        } else {
          state.bgColor = hex;
          updateColorDisplay();
        }
      });

      nativeColorPicker.addEventListener('change', () => {
        closeAllOverlays();
      });

      // --- Tool Descriptions & Bottom Label ---
      const toolMeta = {
        'pencil': {
          name: 'Scribble',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 17c3-3 4-8 8-8s4 6 7 6 3-3 3-5"/></svg>`,
          icon: '〰️',
          hint: 'Scribble: Edits strictly 1 pixel at a time.'
        },
        'line': {
          name: 'Vector',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="5" y1="19" x2="19" y2="5" stroke="currentColor" stroke-width="2"/><line x1="1" y1="19" x2="9" y2="19" stroke="#0284c7" stroke-width="1.5"/><line x1="5" y1="15" x2="5" y2="23" stroke="#0284c7" stroke-width="1.5"/><rect x="3" y="17" width="4" height="4" fill="#ffffff" stroke="currentColor" stroke-width="1.2"/><line x1="15" y1="5" x2="23" y2="5" stroke="#0284c7" stroke-width="1.5"/><line x1="19" y1="1" x2="19" y2="9" stroke="#0284c7" stroke-width="1.5"/><rect x="17" y="3" width="4" height="4" fill="#ffffff" stroke="currentColor" stroke-width="1.2"/></svg>`,
          icon: '📏',
          hint: 'Vector: Integer Bresenham line. Exact 1-pixel thickness.'
        },
        'eraser': { name: 'Eraser', icon: '🧹', hint: 'Eraser: Erases pixels on active layer.' },
        'fill': {
          name: 'Splash',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6c-1.5 0-2.5 1.5-3 2.5C7.5 10 5 11 5 13.5c0 3 3 5.5 7 5.5s7-2.5 7-5.5c0-2.5-2.5-3.5-4-5-.5-1-1.5-2.5-3-2.5z"/><circle cx="12" cy="3" r="1.5"/><circle cx="4" cy="9" r="1.2"/><circle cx="20" cy="10" r="1.2"/><circle cx="3.5" cy="16" r="1"/><circle cx="20.5" cy="16" r="1"/><circle cx="8" cy="21" r="1.2"/><circle cx="16" cy="21" r="1.2"/></svg>`,
          icon: '🪣',
          hint: 'Splash: Flood fill contiguous color.'
        },
        'picker': {
          name: 'Sample',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14.5 3.5a3 3 0 0 0-4 0l-1 1 5 5 1-1a3 3 0 0 0-1-5z" fill="#475569" stroke="#1e293b"/><line x1="9" y1="5" x2="14" y2="10" stroke="#1e293b" stroke-width="2"/><path d="M8.5 6.5l-4 4c-.5.5-.8 1.2-.8 2l.3 2.5 4.5 4.5 2.5.3c.8 0 1.5-.3 2-.8l4-4-8.5-8.5z" fill="#e0f2fe" stroke="#0284c7"/><circle cx="2.5" cy="21.5" r="1.5" fill="#0284c7"/></svg>`,
          icon: '🧪',
          hint: 'Sample: Click to sample pixel color.'
        },
        'zoom': {
          name: 'Focus',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="21" rx="6" ry="2" fill="#475569" stroke="#1e293b"/><path d="M12 19V14l-3-4" stroke="#1e293b" stroke-width="2"/><circle cx="13" cy="7" r="5.5" stroke="#1e293b" stroke-width="2" fill="#e0f2fe"/></svg>`,
          icon: '🔍',
          hint: 'Focus: Click or pinch to zoom.'
        },
        'brush': { name: 'Brush', icon: '🖌️', hint: 'Brush: Paints with custom shape and size.' },
        'spray': { name: 'Airbrush', icon: '💨', hint: 'Airbrush: Sprays random pixel dots.' },
        'select': { name: 'Select', icon: '⬚', hint: 'Select: Drag box to move/copy/cut.' },
        'free-select': { name: 'Cutout', icon: '✂️', hint: 'Cutout: Drag freehand to cut out a region.' },
        'magic-select': {
          name: 'Smart Select',
          iconHtml: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 2C7 6 5 11 5 16c0 3 2 5 5 6l2-20z" fill="#1e293b"/><path d="M12 2c5 4 7 9 7 14 0 3-2 5-5 6l-2-20z" fill="#93c5fd"/><path d="M12 2c5 4 7 9 7 14 0 3-2 5-5 6 L12 2Z" stroke="#000000" stroke-width="1.8" stroke-dasharray="2, 2" fill="none"/></svg>`,
          icon: '🍃',
          hint: 'Smart Select: Click to select like colors (Adjacent or Global).'
        },
        'rect': { name: 'Rect', icon: '▭', hint: 'Rectangle: Draws single-pixel or filled box.' },
        'ellipse': { name: 'Circle', icon: '◯', hint: 'Circle / Ellipse: Crisp midpoint ellipse.' },
        'roundrect': { name: 'Bevel', icon: '▢', hint: 'Bevel: Rounded box with smooth corners.' },
        'curve': { name: 'Spline', icon: '〰️', hint: 'Spline: Draw a line, then adjust bends.' },
        'polygon': { name: 'Polygon', icon: '⬠', hint: 'Polygon: Click vertices, double click to close.' },
        'text': { name: 'Text', icon: '🔤', hint: 'Text: Stamp crisp pixel text.' }
      };

      function updateBottomToolLabel() {
        const meta = toolMeta[state.tool] || { name: 'Tool', icon: '🛠️', hint: '' };
        bottomToolIcon.innerHTML = meta.iconHtml || meta.icon;
        
        let sizeInfo = '';
        if (state.tool === 'pencil') sizeInfo = ` (${state.pencilSize}px)`;
        else if (state.tool === 'line') sizeInfo = ` (${state.lineThickness}px)`;
        else if (state.tool === 'eraser') sizeInfo = ` (${state.eraserSize}px)`;
        else if (state.tool === 'magic-select') sizeInfo = ` (${state.magicMode === 'global' ? 'Global' : 'Adjacent'})`;
        else if (state.tool === 'brush') {
          let shIcon = '●';
          if (state.brushShape === 'square') shIcon = '■';
          else if (state.brushShape === 'slash-f') shIcon = '/';
          else if (state.brushShape === 'slash-b') shIcon = '\\';
          sizeInfo = ` (${shIcon} ${state.brushSize}px)`;
        }

        bottomToolName.textContent = `${meta.name}${sizeInfo}`;
        statusHint.textContent = meta.hint;
      }

      // --- Tool Options Panel Rendering ---
      function renderToolOptions() {
        toolOptionsPanel.innerHTML = '';
        
        if (state.tool === 'pencil') {
          toolOptionsHeader.textContent = 'Scribble Size:';
          [1, 2, 3, 4].forEach(sz => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-4 py-2 font-bold text-xs flex items-center gap-2 hover:bg-white active:bevel-sunken ${state.pencilSize === sz ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            
            const dot = document.createElement('span');
            dot.className = 'bg-black inline-block';
            dot.style.width = `${sz}px`;
            dot.style.height = `${sz}px`;

            const label = document.createElement('span');
            label.textContent = `${sz} px ${sz === 1 ? '(Strict)' : ''}`;

            btn.appendChild(dot);
            btn.appendChild(label);

            btn.addEventListener('click', () => {
              state.pencilSize = sz;
              updateBottomToolLabel();
              closeAllOverlays();
            });

            toolOptionsPanel.appendChild(btn);
          });
        } else if (state.tool === 'line' || state.tool === 'curve') {
          toolOptionsHeader.textContent = 'Stroke Width:';
          [1, 2, 3, 4, 5].forEach(w => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-4 py-2 font-bold text-xs flex items-center gap-2 hover:bg-white active:bevel-sunken ${state.lineThickness === w ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            
            const line = document.createElement('span');
            line.className = 'bg-black inline-block';
            line.style.width = '16px';
            line.style.height = `${w}px`;

            const label = document.createElement('span');
            label.textContent = `${w} px ${w === 1 ? '(Strict)' : ''}`;

            btn.appendChild(line);
            btn.appendChild(label);

            btn.addEventListener('click', () => {
              state.lineThickness = w;
              updateBottomToolLabel();
              closeAllOverlays();
            });

            toolOptionsPanel.appendChild(btn);
          });
        } else if (state.tool === 'eraser') {
          toolOptionsHeader.textContent = 'Eraser Size:';
          [2, 4, 8, 16].forEach(sz => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-4 py-2 font-bold text-xs flex items-center gap-2 hover:bg-white active:bevel-sunken ${state.eraserSize === sz ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            
            const sq = document.createElement('span');
            sq.className = 'bg-white border border-black inline-block';
            sq.style.width = `${Math.min(sz, 14)}px`;
            sq.style.height = `${Math.min(sz, 14)}px`;

            const label = document.createElement('span');
            label.textContent = `${sz}x${sz} px`;

            btn.appendChild(sq);
            btn.appendChild(label);

            btn.addEventListener('click', () => {
              state.eraserSize = sz;
              updateBottomToolLabel();
              closeAllOverlays();
            });

            toolOptionsPanel.appendChild(btn);
          });
        } else if (['rect', 'ellipse', 'roundrect', 'polygon'].includes(state.tool)) {
          toolOptionsHeader.textContent = 'Fill Style:';
          const modes = [
            { id: 'outline', label: 'Outline Only', icon: '<rect x="2" y="2" width="12" height="8" fill="none" stroke="black"/>' },
            { id: 'outline-fill', label: 'Outline & Fill', icon: '<rect x="2" y="2" width="12" height="8" fill="#a0a0a0" stroke="black"/>' },
            { id: 'fill', label: 'Solid Fill', icon: '<rect x="2" y="2" width="12" height="8" fill="#a0a0a0"/>' }
          ];

          modes.forEach(m => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-3 py-2 font-bold text-xs flex items-center gap-1.5 hover:bg-white active:bevel-sunken ${state.shapeMode === m.id ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            
            btn.innerHTML = `
              <svg class="w-4 h-3 shrink-0" viewBox="0 0 16 12">${m.icon}</svg>
              <span>${m.label}</span>
            `;

            btn.addEventListener('click', () => {
              state.shapeMode = m.id;
              closeAllOverlays();
            });

            toolOptionsPanel.appendChild(btn);
          });
        } else if (state.tool === 'magic-select') {
          toolOptionsHeader.textContent = 'Smart Select Mode:';
          const modes = [
            { id: 'adjacent', label: 'Adjacent (Touching & Diagonal)', hint: 'Selects connected pixels of same color including diagonal touches' },
            { id: 'global', label: 'Global (All on Layer)', hint: 'Selects all pixels of this color everywhere on layer' }
          ];
          modes.forEach(m => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-4 py-2 font-bold text-xs flex items-center gap-2 hover:bg-white active:bevel-sunken ${state.magicMode === m.id ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            btn.textContent = m.label;
            btn.title = m.hint;
            btn.addEventListener('click', () => {
              state.magicMode = m.id;
              updateBottomToolLabel();
              renderToolOptions();
              closeAllOverlays();
            });
            toolOptionsPanel.appendChild(btn);
          });
        } else if (state.tool === 'select' || state.tool === 'free-select' || state.tool === 'magic-select') {
          toolOptionsHeader.textContent = 'Selection & Canvas Fit:';

          const btnSelAllFitOpt = document.createElement('button');
          btnSelAllFitOpt.className = 'bevel-raised px-3.5 py-2 font-bold text-xs bg-yellow-100 text-blue-950 border border-blue-500 hover:bg-white active:bevel-sunken flex items-center gap-1.5 cursor-pointer';
          btnSelAllFitOpt.innerHTML = '<span>📐</span><span>Fit Selection to Canvas</span>';
          btnSelAllFitOpt.title = 'Resize the selection to the size of the canvas';
          btnSelAllFitOpt.addEventListener('click', () => {
            fitSelectionToCanvas();
          });

          const btnSelAllOpt = document.createElement('button');
          btnSelAllOpt.className = 'bevel-raised px-3.5 py-2 font-bold text-xs bg-gray-100 text-gray-800 hover:bg-white active:bevel-sunken flex items-center gap-1.5 cursor-pointer';
          btnSelAllOpt.innerHTML = '<span>🔲</span><span>Select All (Ctrl+A)</span>';
          btnSelAllOpt.addEventListener('click', () => {
            closeAllOverlays();
            createSelection(0, 0, state.width, state.height);
          });

          const btnOpaque = document.createElement('button');
          btnOpaque.className = `bevel-raised px-3.5 py-2 font-bold text-xs hover:bg-white active:bevel-sunken ${!state.selectTransparent ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
          btnOpaque.textContent = 'Opaque (Keep All Colors)';
          btnOpaque.addEventListener('click', () => {
            state.selectTransparent = false;
            updateTransparentSwitchUI();
            closeAllOverlays();
          });

          const btnTransparent = document.createElement('button');
          btnTransparent.className = `bevel-raised px-3.5 py-2 font-bold text-xs hover:bg-white active:bevel-sunken ${state.selectTransparent ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
          btnTransparent.textContent = 'Transparent (Delete Secondary)';
          btnTransparent.addEventListener('click', () => {
            state.selectTransparent = true;
            updateTransparentSwitchUI();
            closeAllOverlays();
          });

          toolOptionsPanel.appendChild(btnSelAllFitOpt);
          toolOptionsPanel.appendChild(btnSelAllOpt);
          toolOptionsPanel.appendChild(btnOpaque);
          toolOptionsPanel.appendChild(btnTransparent);
        } else if (state.tool === 'brush') {
          toolOptionsHeader.textContent = 'Brush Shape & Tip Size:';
          const shapes = [
            { shape: 'circle', sz: 7, label: 'Circle 7px', iconSvg: '<circle cx="12" cy="12" r="6" fill="#000"/>' },
            { shape: 'circle', sz: 4, label: 'Circle 4px', iconSvg: '<circle cx="12" cy="12" r="3.5" fill="#000"/>' },
            { shape: 'circle', sz: 2, label: 'Circle 2px', iconSvg: '<circle cx="12" cy="12" r="2" fill="#000"/>' },
            { shape: 'square', sz: 7, label: 'Square 7px', iconSvg: '<rect x="6" y="6" width="12" height="12" fill="#000"/>' },
            { shape: 'square', sz: 4, label: 'Square 4px', iconSvg: '<rect x="8" y="8" width="8" height="8" fill="#000"/>' },
            { shape: 'square', sz: 2, label: 'Square 2px', iconSvg: '<rect x="10" y="10" width="4" height="4" fill="#000"/>' },
            { shape: 'slash-f', sz: 7, label: 'Slash 7px', iconSvg: '<line x1="5" y1="19" x2="19" y2="5" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>' },
            { shape: 'slash-f', sz: 5, label: 'Slash 5px', iconSvg: '<line x1="7" y1="17" x2="17" y2="7" stroke="#000" stroke-width="2" stroke-linecap="round"/>' },
            { shape: 'slash-f', sz: 3, label: 'Slash 3px', iconSvg: '<line x1="9" y1="15" x2="15" y2="9" stroke="#000" stroke-width="1.5" stroke-linecap="round"/>' },
            { shape: 'slash-b', sz: 7, label: 'Backslash 7px', iconSvg: '<line x1="5" y1="5" x2="19" y2="19" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>' },
            { shape: 'slash-b', sz: 5, label: 'Backslash 5px', iconSvg: '<line x1="7" y1="7" x2="17" y2="17" stroke="#000" stroke-width="2" stroke-linecap="round"/>' },
            { shape: 'slash-b', sz: 3, label: 'Backslash 3px', iconSvg: '<line x1="9" y1="9" x2="15" y2="15" stroke="#000" stroke-width="1.5" stroke-linecap="round"/>' }
          ];

          shapes.forEach(s => {
            const btn = document.createElement('button');
            const isActive = state.brushShape === s.shape && state.brushSize === s.sz;
            btn.className = `bevel-raised p-1 flex flex-col items-center justify-center gap-1 hover:bg-white active:bevel-sunken cursor-pointer w-20 sm:w-24 ${isActive ? 'bg-blue-100 text-blue-900 border border-blue-600' : 'bg-gray-100 text-gray-800'}`;
            btn.innerHTML = `
              <div class="w-7 h-7 bg-white border border-gray-500 bevel-sunken flex items-center justify-center pointer-events-none">
                <svg width="24" height="24" viewBox="0 0 24 24" class="block">
                  ${s.iconSvg}
                </svg>
              </div>
              <span class="text-[10px] font-bold text-center leading-tight whitespace-nowrap pointer-events-none">${s.label}</span>
            `;
            btn.addEventListener('click', () => {
              state.brushShape = s.shape;
              state.brushSize = s.sz;
              updateBottomToolLabel();
              renderToolOptions();
              closeAllOverlays();
            });
            toolOptionsPanel.appendChild(btn);
          });
        } else if (state.tool === 'spray') {
          toolOptionsHeader.textContent = 'Spray Radius:';
          [4, 8, 12].forEach(r => {
            const btn = document.createElement('button');
            btn.className = `bevel-raised px-4 py-2 font-bold text-xs hover:bg-white active:bevel-sunken ${state.sprayRadius === r ? 'bg-blue-100 text-blue-900 border border-blue-500' : 'bg-gray-100'}`;
            btn.textContent = `${r} px Radius`;
            btn.addEventListener('click', () => {
              state.sprayRadius = r;
              closeAllOverlays();
            });
            toolOptionsPanel.appendChild(btn);
          });
        } else {
          toolOptionsHeader.textContent = 'Options:';
          const msg = document.createElement('div');
          msg.className = 'text-gray-600 italic text-xs py-1';
          msg.textContent = 'Ready to draw with this tool.';
          toolOptionsPanel.appendChild(msg);
        }
      }

      // Toolbox Click Handling
      toolbox.querySelectorAll('.tool-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toolbox.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          state.tool = btn.dataset.tool;
          updateBottomToolLabel();
          renderToolOptions();

          if (state.tool !== 'select' && state.tool !== 'free-select' && state.tool !== 'magic-select' && state.selection) {
            clearSelectionBox();
          }
          state.curveStep = 0;
          state.polygonPoints = [];
          state.lassoPoints = [];
          previewCtx.clearRect(0, 0, state.width, state.height);

          // If tool doesn't require setting extra options (like Fill, Picker, Zoom, Text), auto close overlay!
          if (['fill', 'picker', 'zoom', 'text', 'free-select', 'curve', 'polygon'].includes(state.tool)) {
            closeAllOverlays();
          }
        });
      });

      // --- Layers Engine ---
      function getNextAvailableLayerName() {
        if (!state.layers || state.layers.length === 0) return 'Layer 2';
        const existingNames = new Set(state.layers.map(l => (l.name || '').trim().toLowerCase()));
        let num = 2;
        while (existingNames.has(`layer ${num}`)) {
          num++;
        }
        return `Layer ${num}`;
      }

      function createNewLayer(name) {
        const canvas = document.createElement('canvas');
        canvas.width = state.width;
        canvas.height = state.height;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.imageSmoothingEnabled = false;
        return {
          id: state.layerCounter++,
          name: name || getNextAvailableLayerName(),
          canvas: canvas,
          ctx: ctx,
          visible: true,
          opacity: 1.0
        };
      }

      function initLayers(initialBgColor = '#ffffff') {
        state.layerCounter = 1;
        const baseLayer = createNewLayer('Background');
        if (initialBgColor !== 'transparent') {
          baseLayer.ctx.fillStyle = initialBgColor;
          baseLayer.ctx.fillRect(0, 0, state.width, state.height);
        }
        state.layers = [baseLayer];
        state.activeLayerIndex = 0;
        compositeLayers();
        renderLayersList();
      }

      function getActiveLayer() {
        if (!state.layers || state.layers.length === 0) {
          initLayers();
        }
        if (state.activeLayerIndex < 0) state.activeLayerIndex = 0;
        if (state.activeLayerIndex >= state.layers.length) state.activeLayerIndex = state.layers.length - 1;
        return state.layers[state.activeLayerIndex];
      }

      function getActiveLayerCtx() {
        return getActiveLayer().ctx;
      }

      function compositeLayers() {
        paintCtx.clearRect(0, 0, state.width, state.height);
        for (let i = 0; i < state.layers.length; i++) {
          const l = state.layers[i];
          if (l.visible && l.opacity > 0) {
            paintCtx.globalAlpha = l.opacity;
            paintCtx.drawImage(l.canvas, 0, 0);
          }
        }
        paintCtx.globalAlpha = 1.0;
      }

      function renderLayersList() {
        if (!layersItemsList) return;
        if (layersCountBadge) layersCountBadge.textContent = state.layers.length;
        layersItemsList.innerHTML = '';

        // Render from top layer to bottom layer (reverse stack order)
        for (let i = state.layers.length - 1; i >= 0; i--) {
          const layer = state.layers[i];
          const isActive = (i === state.activeLayerIndex);

          const item = document.createElement('div');
          item.className = `flex items-center justify-between p-1.5 text-xs border rounded-none ${isActive ? 'bg-[#000080] text-white border-blue-900 font-bold' : 'bg-gray-100 text-gray-900 border-gray-300'} cursor-pointer select-none transition-colors`;
          
          const left = document.createElement('div');
          left.className = 'flex items-center gap-1.5 truncate flex-1';

          const visBtn = document.createElement('button');
          visBtn.type = 'button';
          visBtn.className = 'text-xs p-0.5 hover:opacity-75 leading-none';
          visBtn.innerHTML = layer.visible ? '👁️' : '🚫';
          visBtn.title = layer.visible ? 'Hide Layer' : 'Show Layer';
          visBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            layer.visible = !layer.visible;
            compositeLayers();
            renderLayersList();
          });

          const nameSpan = document.createElement('span');
          nameSpan.className = 'truncate cursor-pointer flex-1 font-mono text-[11px]';
          nameSpan.textContent = layer.name;
          nameSpan.title = 'Click to select active layer, click rename to edit';

          const renameBtn = document.createElement('button');
          renameBtn.type = 'button';
          renameBtn.className = `px-1 py-0.5 text-[9px] bevel-raised ${isActive ? 'bg-blue-200 text-blue-950' : 'bg-gray-200 text-black'} hover:bg-white active:bevel-sunken`;
          renameBtn.textContent = '✏️';
          renameBtn.title = 'Rename Layer';
          renameBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            openRenameLayerModal(i);
          });

          left.appendChild(visBtn);
          left.appendChild(nameSpan);
          left.appendChild(renameBtn);

          const right = document.createElement('div');
          right.className = 'flex items-center gap-1 shrink-0 ml-1';

          const upBtn = document.createElement('button');
          upBtn.type = 'button';
          upBtn.className = `px-1.5 py-0.5 text-[9px] bevel-raised ${isActive ? 'bg-blue-100 text-black' : 'bg-gray-200 text-black'} hover:bg-white active:bevel-sunken disabled:opacity-30`;
          upBtn.textContent = '▲';
          upBtn.title = 'Move Layer Up';
          upBtn.disabled = (i === state.layers.length - 1);
          upBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            moveLayerUp(i);
          });

          const downBtn = document.createElement('button');
          downBtn.type = 'button';
          downBtn.className = `px-1.5 py-0.5 text-[9px] bevel-raised ${isActive ? 'bg-blue-100 text-black' : 'bg-gray-200 text-black'} hover:bg-white active:bevel-sunken disabled:opacity-30`;
          downBtn.textContent = '▼';
          downBtn.title = 'Move Layer Down';
          downBtn.disabled = (i === 0);
          downBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            moveLayerDown(i);
          });

          right.appendChild(upBtn);
          right.appendChild(downBtn);

          item.appendChild(left);
          item.appendChild(right);

          item.addEventListener('click', () => {
            state.activeLayerIndex = i;
            updateLayerOpacitySlider();
            renderLayersList();
          });

          layersItemsList.appendChild(item);
        }

        updateLayerOpacitySlider();
      }

      function updateLayerOpacitySlider() {
        const activeLayer = getActiveLayer();
        if (layerOpacitySlider && activeLayer) {
          layerOpacitySlider.value = Math.round(activeLayer.opacity * 100);
        }
        if (layerOpacityVal && activeLayer) {
          layerOpacityVal.textContent = `${Math.round(activeLayer.opacity * 100)}%`;
        }
      }

      function addLayer() {
        const nextName = getNextAvailableLayerName();
        const newLayer = createNewLayer(nextName);
        state.layers.splice(state.activeLayerIndex + 1, 0, newLayer);
        state.activeLayerIndex++;
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function deleteLayer() {
        if (state.layers.length <= 1) {
          const l = getActiveLayer();
          l.ctx.clearRect(0, 0, state.width, state.height);
          compositeLayers();
          saveHistoryState();
          return;
        }
        state.layers.splice(state.activeLayerIndex, 1);
        if (state.activeLayerIndex >= state.layers.length) {
          state.activeLayerIndex = state.layers.length - 1;
        }
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function mergeDown() {
        const idx = state.activeLayerIndex;
        if (idx <= 0) return; // Cannot merge down the bottom layer
        const current = state.layers[idx];
        const below = state.layers[idx - 1];

        below.ctx.globalAlpha = current.opacity;
        below.ctx.drawImage(current.canvas, 0, 0);
        below.ctx.globalAlpha = 1.0;

        state.layers.splice(idx, 1);
        state.activeLayerIndex = idx - 1;
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function mergeAll() {
        if (state.layers.length <= 1) return;
        const temp = document.createElement('canvas');
        temp.width = state.width;
        temp.height = state.height;
        const tctx = temp.getContext('2d');
        tctx.drawImage(paintCanvas, 0, 0);

        const base = state.layers[0];
        base.ctx.clearRect(0, 0, state.width, state.height);
        base.ctx.drawImage(temp, 0, 0);
        base.opacity = 1.0;
        base.visible = true;
        base.name = 'Merged';

        state.layers = [base];
        state.activeLayerIndex = 0;
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function moveLayerUp(i) {
        if (i >= state.layers.length - 1) return;
        const temp = state.layers[i];
        state.layers[i] = state.layers[i + 1];
        state.layers[i + 1] = temp;
        if (state.activeLayerIndex === i) state.activeLayerIndex = i + 1;
        else if (state.activeLayerIndex === i + 1) state.activeLayerIndex = i;
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function moveLayerDown(i) {
        if (i <= 0) return;
        const temp = state.layers[i];
        state.layers[i] = state.layers[i - 1];
        state.layers[i - 1] = temp;
        if (state.activeLayerIndex === i) state.activeLayerIndex = i - 1;
        else if (state.activeLayerIndex === i - 1) state.activeLayerIndex = i;
        compositeLayers();
        renderLayersList();
        saveHistoryState();
      }

      function openRenameLayerModal(i) {
        state.renamingLayerIndex = i;
        if (inputLayerName) inputLayerName.value = state.layers[i].name;
        if (modalLayerRename) modalLayerRename.classList.remove('hidden');
      }

      // --- Live Dimensions & Staged Shape Engine ---
      function showLiveDimension(x0, y0, x1, y1) {
        const w = Math.abs(x1 - x0) + 1;
        const h = Math.abs(y1 - y0) + 1;
        if (liveDimensionText) {
          liveDimensionText.textContent = `${w} x ${h} px`;
        }
        if (liveDimensionBadge) {
          liveDimensionBadge.classList.remove('hidden');
        }
      }

      function hideLiveDimension() {
        if (liveDimensionBadge) {
          liveDimensionBadge.classList.add('hidden');
        }
      }

      function stageShape(shape) {
        state.stagedShape = shape;
        renderStagedShape();
        updateShapeHandles();
        if (floatingShapeBar) floatingShapeBar.classList.remove('hidden');
        if (shape.p0 && shape.p1) {
          showLiveDimension(shape.p0.x, shape.p0.y, shape.p1.x, shape.p1.y);
        }
      }

      function renderStagedShape() {
        if (!state.stagedShape) return;
        previewCtx.clearRect(0, 0, state.width, state.height);
        const s = state.stagedShape;

        if (s.type === 'line') {
          drawBresenhamLine(previewCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.thickness);
        } else if (s.type === 'rect') {
          drawBresenhamRect(previewCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'ellipse') {
          const rx = Math.abs(s.p1.x - s.p0.x) / 2;
          const ry = Math.abs(s.p1.y - s.p0.y) / 2;
          const cx = Math.min(s.p0.x, s.p1.x) + rx;
          const cy = Math.min(s.p0.y, s.p1.y) + ry;
          drawBresenhamEllipse(previewCtx, cx, cy, rx, ry, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'roundrect') {
          drawBresenhamRoundRect(previewCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'curve') {
          drawBresenhamBezier(previewCtx, s.p0, s.p1, s.p2, s.p3, s.strokeColor, s.thickness);
        }
      }

      function updateShapeHandles() {
        if (!state.stagedShape) {
          if (handle0) handle0.classList.add('hidden');
          if (handle1) handle1.classList.add('hidden');
          if (handle2) handle2.classList.add('hidden');
          if (handle3) handle3.classList.add('hidden');
          return;
        }
        const s = state.stagedShape;
        const z = state.zoom;

        function setPos(handleEl, pt) {
          if (!handleEl) return;
          handleEl.style.left = `${pt.x * z}px`;
          handleEl.style.top = `${pt.y * z}px`;
          handleEl.classList.remove('hidden');
        }

        if (s.type === 'line' || s.type === 'rect' || s.type === 'ellipse' || s.type === 'roundrect') {
          setPos(handle0, s.p0);
          setPos(handle1, s.p1);
          if (handle2) handle2.classList.add('hidden');
          if (handle3) handle3.classList.add('hidden');
        } else if (s.type === 'curve') {
          setPos(handle0, s.p0);
          setPos(handle1, s.p1);
          setPos(handle2, s.p2);
          setPos(handle3, s.p3);
        }
      }

      function commitStagedShape() {
        if (!state.stagedShape) return;
        const s = state.stagedShape;
        const targetCtx = getActiveLayerCtx();

        if (s.type === 'line') {
          drawBresenhamLine(targetCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.thickness);
        } else if (s.type === 'rect') {
          drawBresenhamRect(targetCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'ellipse') {
          const rx = Math.abs(s.p1.x - s.p0.x) / 2;
          const ry = Math.abs(s.p1.y - s.p0.y) / 2;
          const cx = Math.min(s.p0.x, s.p1.x) + rx;
          const cy = Math.min(s.p0.y, s.p1.y) + ry;
          drawBresenhamEllipse(targetCtx, cx, cy, rx, ry, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'roundrect') {
          drawBresenhamRoundRect(targetCtx, s.p0.x, s.p0.y, s.p1.x, s.p1.y, s.strokeColor, s.fillColor, s.mode);
        } else if (s.type === 'curve') {
          drawBresenhamBezier(targetCtx, s.p0, s.p1, s.p2, s.p3, s.strokeColor, s.thickness);
        }

        previewCtx.clearRect(0, 0, state.width, state.height);
        clearStagedShape();
        compositeLayers();
        saveHistoryState();
      }

      function cancelStagedShape() {
        previewCtx.clearRect(0, 0, state.width, state.height);
        clearStagedShape();
      }

      function clearStagedShape() {
        state.stagedShape = null;
        updateShapeHandles();
        if (floatingShapeBar) floatingShapeBar.classList.add('hidden');
        hideLiveDimension();
      }

      // --- Canvas Sizing & Pixel Grid Engine ---
      function resizeCanvas(newWidth, newHeight, bgColor = '#ffffff', preserveContent = false) {
        state.width = newWidth;
        state.height = newHeight;

        paintCanvas.width = newWidth;
        paintCanvas.height = newHeight;
        previewCanvas.width = newWidth;
        previewCanvas.height = newHeight;
        gridCanvas.width = newWidth;
        gridCanvas.height = newHeight;

        paintCtx.imageSmoothingEnabled = false;
        previewCtx.imageSmoothingEnabled = false;

        if (preserveContent && state.layers && state.layers.length > 0) {
          state.layers.forEach(l => {
            const oldCanvas = l.canvas;
            const newC = document.createElement('canvas');
            newC.width = newWidth;
            newC.height = newHeight;
            const nctx = newC.getContext('2d', { willReadFrequently: true });
            nctx.imageSmoothingEnabled = false;
            nctx.drawImage(oldCanvas, 0, 0);
            l.canvas = newC;
            l.ctx = nctx;
          });
          compositeLayers();
          renderLayersList();
        } else {
          initLayers(bgColor);
        }

        updateCanvasDisplaySize();
        drawGrid();
        saveHistoryState();
        statusDimensions.textContent = `${newWidth} x ${newHeight} px`;
      }

      function updateCanvasTransform() {
        canvasWrapper.style.transform = `translate(${state.panX}px, ${state.panY}px)`;
      }

      function updateCanvasDisplaySize() {
        const displayW = state.width * state.zoom;
        const displayH = state.height * state.zoom;
        if (state.stagedText) {
          updateStagedTextDisplay();
        }

        canvasWrapper.style.width = `${displayW}px`;
        canvasWrapper.style.height = `${displayH}px`;

        paintCanvas.style.width = `${displayW}px`;
        paintCanvas.style.height = `${displayH}px`;
        previewCanvas.style.width = `${displayW}px`;
        previewCanvas.style.height = `${displayH}px`;
        gridCanvas.style.width = `${displayW}px`;
        gridCanvas.style.height = `${displayH}px`;

        const pct = state.zoom * 100;
        let pctStr;
        if (pct >= 10) {
          pctStr = `${Math.round(pct)}%`;
        } else if (pct >= 1) {
          pctStr = `${Number(pct.toFixed(1))}%`;
        } else {
          pctStr = `${Number(pct.toFixed(2))}%`;
        }
        statusZoom.textContent = pctStr;
        if (state.selection) {
          updateSelectionBoxDisplay();
        }
        if (state.stagedShape) {
          updateShapeHandles();
        }
        updateCanvasTransform();
      }

      const zoomPresets = [0.01, 0.02, 0.05, 0.1, 0.25, 0.5, 1, 2, 4, 8, 16, 32];

      function setZoom(newZoom) {
        state.zoom = Math.max(0.01, Math.min(32, newZoom));
        updateCanvasDisplaySize();
        drawGrid();
      }

      function zoomAtPoint(newZoom, centerX, centerY) {
        newZoom = Math.max(0.01, Math.min(32, newZoom));
        if (Math.abs(newZoom - state.zoom) < 0.0001) return;

        const rect = paintCanvas.getBoundingClientRect();
        const px = (centerX - rect.left) / state.zoom;
        const py = (centerY - rect.top) / state.zoom;

        const deltaW = (state.width * newZoom) - (state.width * state.zoom);
        const deltaH = (state.height * newZoom) - (state.height * state.zoom);

        const deltaPanX = (centerX - px * newZoom) - (rect.left - deltaW / 2);
        const deltaPanY = (centerY - py * newZoom) - (rect.top - deltaH / 2);

        state.panX += deltaPanX;
        state.panY += deltaPanY;
        setZoom(newZoom);
        updateCanvasTransform();
      }

      function resetView() {
        state.panX = 0;
        state.panY = 0;
        updateCanvasTransform();
        const availW = Math.max(50, canvasContainer.clientWidth - 40);
        const availH = Math.max(50, canvasContainer.clientHeight - 40);
        const fitRatio = Math.min(availW / state.width, availH / state.height);
        let fitZoom = fitRatio;
        if (fitZoom >= 1) {
          fitZoom = Math.min(16, Math.floor(fitRatio));
        } else {
          fitZoom = Math.max(0.01, Math.min(1, Number(fitRatio.toFixed(3))));
        }
        setZoom(fitZoom || 1);
      }

      quickResetView.addEventListener('click', resetView);
      document.getElementById('btn-zoom-in').addEventListener('click', () => {
        const next = zoomPresets.find(z => z > state.zoom * 1.02);
        setZoom(next !== undefined ? next : 32);
        closeAllOverlays();
      });
      document.getElementById('btn-zoom-out').addEventListener('click', () => {
        const prev = [...zoomPresets].reverse().find(z => z < state.zoom * 0.98);
        setZoom(prev !== undefined ? prev : 0.01);
        closeAllOverlays();
      });
      btnResetView.addEventListener('click', () => {
        resetView();
        closeAllOverlays();
      });

      document.getElementById('action-toggle-grid').addEventListener('click', () => {
        state.showGrid = !state.showGrid;
        btnToggleGrid.textContent = `Grid: ${state.showGrid ? 'ON' : 'OFF'}`;
        gridCheckIndicator.textContent = state.showGrid ? '✓' : '';
        drawGrid();
        closeAllOverlays();
      });

      function drawGrid() {
        if (!state.showGrid || state.zoom < 4) {
          gridCanvas.style.display = 'none';
          gridCanvas.style.backgroundImage = 'none';
          return;
        }

        gridCanvas.style.display = 'block';
        const z = state.zoom;
        // Using CSS background-image guarantees the grid is always visible at high zoom even for huge 3,000px canvases
        gridCanvas.style.backgroundImage = `
          linear-gradient(to right, rgba(128, 128, 128, 0.35) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(128, 128, 128, 0.35) 1px, transparent 1px)
        `;
        gridCanvas.style.backgroundSize = `${z}px ${z}px`;
        gridCanvas.style.backgroundPosition = '0 0';
      }

      // --- Coordinate Mapping ---
      function getCanvasCoordinates(e) {
        if (!e) {
          return {
            x: state.lastX !== null ? state.lastX : 0,
            y: state.lastY !== null ? state.lastY : 0
          };
        }

        let clientX = e.clientX;
        let clientY = e.clientY;

        // If clientX/Y is missing, check touches or changedTouches
        if (clientX === undefined || clientY === undefined) {
          const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
          if (touch) {
            clientX = touch.clientX;
            clientY = touch.clientY;
          }
        }

        if (clientX === undefined || clientY === undefined) {
          return {
            x: state.lastX !== null ? state.lastX : 0,
            y: state.lastY !== null ? state.lastY : 0
          };
        }

        const rect = paintCanvas.getBoundingClientRect();
        const x = Math.floor((clientX - rect.left) / state.zoom);
        const y = Math.floor((clientY - rect.top) / state.zoom);

        return {
          x: Math.max(0, Math.min(state.width - 1, x)),
          y: Math.max(0, Math.min(state.height - 1, y))
        };
      }

      // --- Pixel Math & Drawing Algorithms ---
      function putPixel(ctx, x, y, color, size = 1) {
        if (x < 0 || x >= state.width || y < 0 || y >= state.height) return;
        ctx.fillStyle = color;
        if (size === 1) {
          ctx.fillRect(x, y, 1, 1);
        } else {
          const offset = Math.floor(size / 2);
          ctx.fillRect(x - offset, y - offset, size, size);
        }
      }

      function erasePixel(ctx, x, y, size = 1) {
        if (x < 0 || x >= state.width || y < 0 || y >= state.height) return;
        const offset = size === 1 ? 0 : Math.floor(size / 2);
        const drawX = size === 1 ? x : x - offset;
        const drawY = size === 1 ? y : y - offset;
        if (state.activeLayerIndex === 0) {
          ctx.fillStyle = state.bgColor;
          ctx.fillRect(drawX, drawY, size, size);
        } else {
          ctx.clearRect(drawX, drawY, size, size);
        }
      }

      function eraseBresenhamLine(ctx, x0, y0, x1, y1, size = 1) {
        x0 = Math.round(x0);
        y0 = Math.round(y0);
        x1 = Math.round(x1);
        y1 = Math.round(y1);

        const dx = Math.abs(x1 - x0);
        const dy = Math.abs(y1 - y0);
        const sx = x0 < x1 ? 1 : -1;
        const sy = y0 < y1 ? 1 : -1;
        let err = dx - dy;

        while (true) {
          erasePixel(ctx, x0, y0, size);
          if (x0 === x1 && y0 === y1) break;
          const e2 = 2 * err;
          if (e2 > -dy) {
            err -= dy;
            x0 += sx;
          }
          if (e2 < dx) {
            err += dx;
            y0 += sy;
          }
        }
      }

      function drawBresenhamLine(ctx, x0, y0, x1, y1, color, thickness = 1) {
        x0 = Math.round(x0);
        y0 = Math.round(y0);
        x1 = Math.round(x1);
        y1 = Math.round(y1);

        const dx = Math.abs(x1 - x0);
        const dy = Math.abs(y1 - y0);
        const sx = x0 < x1 ? 1 : -1;
        const sy = y0 < y1 ? 1 : -1;
        let err = dx - dy;

        while (true) {
          putPixel(ctx, x0, y0, color, thickness);
          if (x0 === x1 && y0 === y1) break;
          const e2 = 2 * err;
          if (e2 > -dy) {
            err -= dy;
            x0 += sx;
          }
          if (e2 < dx) {
            err += dx;
            y0 += sy;
          }
        }
      }

      function drawBresenhamEllipse(ctx, xc, yc, rx, ry, strokeColor, fillColor, mode) {
        xc = Math.round(xc);
        yc = Math.round(yc);
        rx = Math.max(1, Math.round(rx));
        ry = Math.max(1, Math.round(ry));

        const points = [];
        let x = 0;
        let y = ry;

        let d1 = (ry * ry) - (rx * rx * ry) + (0.25 * rx * rx);
        let dx = 2 * ry * ry * x;
        let dy = 2 * rx * rx * y;

        while (dx < dy) {
          points.push({ x, y });
          if (d1 < 0) {
            x++;
            dx += (2 * ry * ry);
            d1 += dx + (ry * ry);
          } else {
            x++;
            y--;
            dx += (2 * ry * ry);
            dy -= (2 * rx * rx);
            d1 += dx - dy + (ry * ry);
          }
        }

        let d2 = ((ry * ry) * ((x + 0.5) * (x + 0.5))) + ((rx * rx) * ((y - 1) * (y - 1))) - (rx * rx * ry * ry);
        while (y >= 0) {
          points.push({ x, y });
          if (d2 > 0) {
            y--;
            dy -= (2 * rx * rx);
            d2 += (rx * rx) - dy;
          } else {
            y--;
            x++;
            dx += (2 * ry * ry);
            dy -= (2 * rx * rx);
            d2 += dx - dy + (rx * rx);
          }
        }

        if (mode === 'fill' || mode === 'outline-fill') {
          ctx.fillStyle = fillColor;
          const ySpans = {};
          points.forEach(p => {
            if (ySpans[p.y] === undefined || p.x > ySpans[p.y]) {
              ySpans[p.y] = p.x;
            }
          });
          for (let py in ySpans) {
            const spanX = ySpans[py];
            const numY = parseInt(py, 10);
            ctx.fillRect(xc - spanX, yc + numY, spanX * 2 + 1, 1);
            if (numY !== 0) {
              ctx.fillRect(xc - spanX, yc - numY, spanX * 2 + 1, 1);
            }
          }
        }

        if (mode === 'outline' || mode === 'outline-fill') {
          ctx.fillStyle = strokeColor;
          points.forEach(p => {
            ctx.fillRect(xc + p.x, yc + p.y, 1, 1);
            ctx.fillRect(xc - p.x, yc + p.y, 1, 1);
            ctx.fillRect(xc + p.x, yc - p.y, 1, 1);
            ctx.fillRect(xc - p.x, yc - p.y, 1, 1);
          });
        }
      }

      function drawBresenhamRect(ctx, x0, y0, x1, y1, strokeColor, fillColor, mode) {
        const left = Math.min(x0, x1);
        const top = Math.min(y0, y1);
        const w = Math.abs(x1 - x0) + 1;
        const h = Math.abs(y1 - y0) + 1;

        if (mode === 'fill') {
          ctx.fillStyle = fillColor;
          ctx.fillRect(left, top, w, h);
        } else if (mode === 'outline-fill') {
          ctx.fillStyle = fillColor;
          ctx.fillRect(left, top, w, h);
          ctx.fillStyle = strokeColor;
          ctx.fillRect(left, top, w, 1);
          ctx.fillRect(left, top + h - 1, w, 1);
          ctx.fillRect(left, top, 1, h);
          ctx.fillRect(left + w - 1, top, 1, h);
        } else {
          ctx.fillStyle = strokeColor;
          ctx.fillRect(left, top, w, 1);
          ctx.fillRect(left, top + h - 1, w, 1);
          ctx.fillRect(left, top, 1, h);
          ctx.fillRect(left + w - 1, top, 1, h);
        }
      }

      function isPointInPolygon(x, y, pts) {
        let inside = false;
        for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
          const xi = pts[i].x, yi = pts[i].y;
          const xj = pts[j].x, yj = pts[j].y;
          const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
          if (intersect) inside = !inside;
        }
        return inside;
      }

      function drawBresenhamPolygon(ctx, points, strokeColor, fillColor, mode) {
        if (points.length < 3) return;

        if (mode === 'fill' || mode === 'outline-fill') {
          ctx.fillStyle = fillColor;
          let minY = state.height;
          let maxY = 0;
          points.forEach(p => {
            if (p.y < minY) minY = p.y;
            if (p.y > maxY) maxY = p.y;
          });

          minY = Math.max(0, Math.floor(minY));
          maxY = Math.min(state.height - 1, Math.ceil(maxY));

          for (let y = minY; y <= maxY; y++) {
            const nodeX = [];
            let j = points.length - 1;
            for (let i = 0; i < points.length; i++) {
              if ((points[i].y < y && points[j].y >= y) || (points[j].y < y && points[i].y >= y)) {
                const x = Math.round(points[i].x + (y - points[i].y) / (points[j].y - points[i].y) * (points[j].x - points[i].x));
                nodeX.push(x);
              }
              j = i;
            }
            nodeX.sort((a, b) => a - b);
            for (let i = 0; i < nodeX.length; i += 2) {
              if (i + 1 < nodeX.length) {
                const x1 = Math.max(0, nodeX[i]);
                const x2 = Math.min(state.width - 1, nodeX[i + 1]);
                if (x2 >= x1) {
                  ctx.fillRect(x1, y, x2 - x1 + 1, 1);
                }
              }
            }
          }
        }

        if (mode === 'outline' || mode === 'outline-fill') {
          for (let i = 0; i < points.length; i++) {
            const p1 = points[i];
            const p2 = points[(i + 1) % points.length];
            drawBresenhamLine(ctx, p1.x, p1.y, p2.x, p2.y, strokeColor, 1);
          }
        }
      }

      function drawBresenhamBezier(ctx, p0, p1, p2, p3, color, thickness = 1) {
        const chord = Math.hypot(p3.x - p0.x, p3.y - p0.y);
        const net = Math.hypot(p1.x - p0.x, p1.y - p0.y) + Math.hypot(p2.x - p1.x, p2.y - p1.y) + Math.hypot(p3.x - p2.x, p3.y - p2.y);
        const steps = Math.max(12, Math.ceil(Math.max(chord, net) * 2));
        
        let prevX = Math.round(p0.x);
        let prevY = Math.round(p0.y);

        for (let i = 1; i <= steps; i++) {
          const t = i / steps;
          const mt = 1 - t;
          const x = Math.round(mt * mt * mt * p0.x + 3 * mt * mt * t * p1.x + 3 * mt * t * t * p2.x + t * t * t * p3.x);
          const y = Math.round(mt * mt * mt * p0.y + 3 * mt * mt * t * p1.y + 3 * mt * t * t * p2.y + t * t * t * p3.y);
          drawBresenhamLine(ctx, prevX, prevY, x, y, color, thickness);
          prevX = x;
          prevY = y;
        }
      }

      function finishPolygon() {
        if (state.polygonPoints.length < 3) {
          state.polygonPoints = [];
          previewCtx.clearRect(0, 0, state.width, state.height);
          return;
        }
        const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
        const fillCol = state.mouseButton === 2 ? state.fgColor : state.bgColor;

        previewCtx.clearRect(0, 0, state.width, state.height);
        drawBresenhamPolygon(paintCtx, state.polygonPoints, strokeCol, fillCol, state.shapeMode);
        saveHistoryState();
        state.polygonPoints = [];
        statusHint.textContent = 'Polygon: Tap and drag to start a new polygon.';
      }

      function drawBresenhamRoundRect(ctx, x0, y0, x1, y1, strokeColor, fillColor, mode) {
        const left = Math.min(x0, x1);
        const top = Math.min(y0, y1);
        const w = Math.abs(x1 - x0) + 1;
        const h = Math.abs(y1 - y0) + 1;

        const maxR = Math.max(1, Math.floor(Math.min(w, h) / 2) - 1);
        const r = Math.min(Math.min(8, Math.max(2, Math.floor(Math.min(w, h) / 4))), maxR);

        if (r <= 1 || w <= 4 || h <= 4) {
          drawBresenhamRect(ctx, x0, y0, x1, y1, strokeColor, fillColor, mode);
          return;
        }

        // Midpoint circle quadrant points for radius r (exact continuous pixel arc)
        let cx = 0, cy = r, d = 1 - r;
        const pts = [];
        while (cx <= cy) {
          pts.push({ x: cx, y: cy });
          if (cx !== cy) pts.push({ x: cy, y: cx });
          if (d < 0) {
            d += 2 * cx + 3;
          } else {
            d += 2 * (cx - cy) + 5;
            cy--;
          }
          cx++;
        }

        // Fill mode
        if (mode === 'fill' || mode === 'outline-fill') {
          ctx.fillStyle = fillColor;
          // Middle rows
          const midH = h - 2 * r;
          if (midH > 0) {
            ctx.fillRect(left, top + r, w, midH);
          }
          // Top and bottom corner rows
          const rowSpans = {};
          pts.forEach(p => {
            if (rowSpans[p.y] === undefined || p.x > rowSpans[p.y]) {
              rowSpans[p.y] = p.x;
            }
          });
          for (const py in rowSpans) {
            const numPy = parseInt(py, 10);
            const spanX = rowSpans[py];
            const startX = left + r - spanX;
            const endX = left + w - 1 - r + spanX;
            const rowW = endX - startX + 1;
            ctx.fillRect(startX, top + r - numPy, rowW, 1);
            ctx.fillRect(startX, top + h - 1 - r + numPy, rowW, 1);
          }
        }

        // Outline mode: continuous, uninterrupted 1-pixel borders
        if (mode === 'outline' || mode === 'outline-fill') {
          ctx.fillStyle = strokeColor;
          // 4 Straight edges
          const straightW = w - 2 * r;
          const straightH = h - 2 * r;
          if (straightW > 0) {
            ctx.fillRect(left + r, top, straightW, 1);
            ctx.fillRect(left + r, top + h - 1, straightW, 1);
          }
          if (straightH > 0) {
            ctx.fillRect(left, top + r, 1, straightH);
            ctx.fillRect(left + w - 1, top + r, 1, straightH);
          }
          // 4 Rounded corners
          pts.forEach(p => {
            ctx.fillRect(left + r - p.x, top + r - p.y, 1, 1);
            ctx.fillRect(left + w - 1 - r + p.x, top + r - p.y, 1, 1);
            ctx.fillRect(left + r - p.x, top + h - 1 - r + p.y, 1, 1);
            ctx.fillRect(left + w - 1 - r + p.x, top + h - 1 - r + p.y, 1, 1);
          });
        }
      }

      function applyAirbrush(ctx, cx, cy, color, radius) {
        ctx.fillStyle = color;
        const dots = Math.max(3, Math.floor(radius * 1.5));
        for (let i = 0; i < dots; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.random() * radius;
          const px = Math.round(cx + Math.cos(angle) * dist);
          const py = Math.round(cy + Math.sin(angle) * dist);
          putPixel(ctx, px, py, color, 1);
        }
      }

      function applyBrush(ctx, cx, cy, color, shape, size) {
        ctx.fillStyle = color;
        cx = Math.round(cx);
        cy = Math.round(cy);

        if (shape === 'circle') {
          const r = Math.floor(size / 2);
          const rSq = (size / 2) * (size / 2);
          for (let dy = -r; dy <= r; dy++) {
            for (let dx = -r; dx <= r; dx++) {
              if (dx * dx + dy * dy <= rSq + 0.35) {
                ctx.fillRect(cx + dx, cy + dy, 1, 1);
              }
            }
          }
        } else if (shape === 'square') {
          const offset = Math.floor(size / 2);
          ctx.fillRect(cx - offset, cy - offset, size, size);
        } else if (shape === 'slash-f') {
          const half = Math.floor(size / 2);
          for (let i = -half; i <= half; i++) {
            ctx.fillRect(cx + i, cy - i, 1, 1);
          }
        } else if (shape === 'slash-b') {
          const half = Math.floor(size / 2);
          for (let i = -half; i <= half; i++) {
            ctx.fillRect(cx + i, cy + i, 1, 1);
          }
        }
      }

      function drawBrushStroke(ctx, x0, y0, x1, y1, color, shape, size) {
        x0 = Math.round(x0);
        y0 = Math.round(y0);
        x1 = Math.round(x1);
        y1 = Math.round(y1);

        const dx = Math.abs(x1 - x0);
        const dy = Math.abs(y1 - y0);
        const sx = x0 < x1 ? 1 : -1;
        const sy = y0 < y1 ? 1 : -1;
        let err = dx - dy;

        while (true) {
          applyBrush(ctx, x0, y0, color, shape, size);
          if (x0 === x1 && y0 === y1) break;
          const e2 = 2 * err;
          if (e2 > -dy) {
            err -= dy;
            x0 += sx;
          }
          if (e2 < dx) {
            err += dx;
            y0 += sy;
          }
        }
      }

      function floodFill(startX, startY, fillHex) {
        if (startX < 0 || startX >= state.width || startY < 0 || startY >= state.height) return;

        const targetCtx = getActiveLayerCtx();
        const imgData = targetCtx.getImageData(0, 0, state.width, state.height);
        const data = new Uint32Array(imgData.data.buffer);
        const w = state.width;
        const h = state.height;

        const temp = document.createElement('div');
        temp.style.color = fillHex;
        document.body.appendChild(temp);
        const rgbStr = window.getComputedStyle(temp).color;
        document.body.removeChild(temp);

        const match = rgbStr.match(/\d+/g);
        const fr = parseInt(match[0], 10);
        const fg = parseInt(match[1], 10);
        const fb = parseInt(match[2], 10);
        const fa = 255;
        const fillColor = (fa << 24) | (fb << 16) | (fg << 8) | fr;

        const startIndex = startY * w + startX;
        const targetColor = data[startIndex];

        if (targetColor === fillColor) return;

        const queue = [startX, startY];
        const visited = new Uint8Array(w * h);

        while (queue.length > 0) {
          const cy = queue.pop();
          const cx = queue.pop();
          const idx = cy * w + cx;

          if (cx < 0 || cx >= w || cy < 0 || cy >= h) continue;
          if (visited[idx]) continue;
          if (data[idx] !== targetColor) continue;

          visited[idx] = 1;
          data[idx] = fillColor;

          if (cx + 1 < w && !visited[idx + 1] && data[idx + 1] === targetColor) queue.push(cx + 1, cy);
          if (cx - 1 >= 0 && !visited[idx - 1] && data[idx - 1] === targetColor) queue.push(cx - 1, cy);
          if (cy + 1 < h && !visited[idx + w] && data[idx + w] === targetColor) queue.push(cx, cy + 1);
          if (cy - 1 >= 0 && !visited[idx - w] && data[idx - w] === targetColor) queue.push(cx, cy - 1);
        }

        targetCtx.putImageData(imgData, 0, 0);
        compositeLayers();
        saveHistoryState();
      }

      function pickColorAt(x, y, isRightClick) {
        if (x < 0 || x >= state.width || y < 0 || y >= state.height) return;
        const pixel = paintCtx.getImageData(x, y, 1, 1).data;
        const hex = '#' + ((1 << 24) + (pixel[0] << 16) + (pixel[1] << 8) + pixel[2]).toString(16).slice(1);

        if (isRightClick) {
          state.bgColor = hex;
          updateColorDisplay();
        } else {
          applyNewForegroundColor(hex);
        }
      }

      // --- Undo / Redo History Stack ---
      function saveHistoryState() {
        if (state.historyIndex < state.history.length - 1) {
          state.history = state.history.slice(0, state.historyIndex + 1);
        }

        const layerSnapshots = (state.layers && state.layers.length > 0) ? state.layers.map(l => ({
          id: l.id,
          name: l.name,
          visible: l.visible,
          opacity: l.opacity,
          data: l.ctx.getImageData(0, 0, state.width, state.height)
        })) : null;

        const targetCtx = getActiveLayerCtx();
        const imgData = targetCtx.getImageData(0, 0, state.width, state.height);
        state.history.push({
          width: state.width,
          height: state.height,
          activeLayerIndex: state.activeLayerIndex,
          layers: layerSnapshots,
          data: imgData
        });

        const histLimit = (state.width * state.height >= 1000000) ? 5 : state.maxHistory;
        if (state.history.length > histLimit) {
          state.history.shift();
        } else {
          state.historyIndex++;
        }
      }

      function undo() {
        if (state.historyIndex > 0) {
          state.historyIndex--;
          restoreHistoryState(state.history[state.historyIndex]);
        }
      }

      function redo() {
        if (state.historyIndex < state.history.length - 1) {
          state.historyIndex++;
          restoreHistoryState(state.history[state.historyIndex]);
        }
      }

      function restoreHistoryState(histItem) {
        if (histItem.width !== state.width || histItem.height !== state.height) {
          state.width = histItem.width;
          state.height = histItem.height;
          paintCanvas.width = state.width;
          paintCanvas.height = state.height;
          previewCanvas.width = state.width;
          previewCanvas.height = state.height;
          gridCanvas.width = state.width;
          gridCanvas.height = state.height;
          paintCtx.imageSmoothingEnabled = false;
          previewCtx.imageSmoothingEnabled = false;
          updateCanvasDisplaySize();
          drawGrid();
          statusDimensions.textContent = `${state.width} x ${state.height} px`;
        }

        if (histItem.layers && histItem.layers.length > 0) {
          state.layers = histItem.layers.map(ls => {
            const c = document.createElement('canvas');
            c.width = state.width;
            c.height = state.height;
            const ctx = c.getContext('2d', { willReadFrequently: true });
            ctx.imageSmoothingEnabled = false;
            ctx.putImageData(ls.data, 0, 0);
            return {
              id: ls.id,
              name: ls.name,
              visible: ls.visible,
              opacity: ls.opacity,
              canvas: c,
              ctx: ctx
            };
          });
          state.activeLayerIndex = histItem.activeLayerIndex !== undefined ? histItem.activeLayerIndex : 0;
          compositeLayers();
          renderLayersList();
        } else if (histItem.data) {
          paintCtx.putImageData(histItem.data, 0, 0);
        }
      }

      quickUndo.addEventListener('click', undo);
      quickRedo.addEventListener('click', redo);

      // --- Selection & Transformation Functions ---
      function clearSelectionAreaOnActiveLayer(targetCtx, s) {
        const targetX = s.origX !== undefined ? s.origX : s.x;
        const targetY = s.origY !== undefined ? s.origY : s.y;

        if (s.isMagic && (s.origMask || s.selectedMask)) {
          const mask = s.origMask || s.selectedMask;
          const fullImg = targetCtx.getImageData(0, 0, state.width, state.height);
          const fd = fullImg.data;

          const tempDiv = document.createElement('div');
          tempDiv.style.color = state.bgColor;
          document.body.appendChild(tempDiv);
          const bgRgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
          document.body.removeChild(tempDiv);

          for (let i = 0; i < mask.length; i++) {
            if (mask[i]) {
              const idx = i * 4;
              if (state.activeLayerIndex === 0) {
                fd[idx] = bgRgb[0];
                fd[idx + 1] = bgRgb[1];
                fd[idx + 2] = bgRgb[2];
                fd[idx + 3] = 255;
              } else {
                fd[idx + 3] = 0;
              }
            }
          }
          targetCtx.putImageData(fullImg, 0, 0);
        } else if (s.isLasso && s.polygon) {
          const pts = s.origPolygon || s.polygon;
          const imgData = targetCtx.getImageData(targetX, targetY, s.w, s.h);
          const d = imgData.data;

          const tempDiv = document.createElement('div');
          tempDiv.style.color = state.bgColor;
          document.body.appendChild(tempDiv);
          const bgRgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
          document.body.removeChild(tempDiv);

          for (let py = 0; py < s.h; py++) {
            for (let px = 0; px < s.w; px++) {
              const gx = targetX + px;
              const gy = targetY + py;
              if (isPointInPolygon(gx, gy, pts)) {
                const idx = (py * s.w + px) * 4;
                if (state.activeLayerIndex === 0) {
                  d[idx] = bgRgb[0];
                  d[idx + 1] = bgRgb[1];
                  d[idx + 2] = bgRgb[2];
                  d[idx + 3] = 255;
                } else {
                  d[idx + 3] = 0;
                }
              }
            }
          }
          targetCtx.putImageData(imgData, targetX, targetY);
        } else {
          if (state.activeLayerIndex === 0) {
            targetCtx.fillStyle = state.bgColor;
            targetCtx.fillRect(targetX, targetY, s.w, s.h);
          } else {
            targetCtx.clearRect(targetX, targetY, s.w, s.h);
          }
        }
      }

      function generateMagicBoundaryPath(mask, canvasW, canvasH, z, offsetX = 0, offsetY = 0) {
        if (!mask) return '';
        const hSegments = [];
        const vSegments = [];

        for (let y = 0; y < canvasH; y++) {
          let inRun = false;
          let startX = 0;
          for (let x = 0; x < canvasW; x++) {
            const isTop = mask[y * canvasW + x] && (y === 0 || !mask[(y - 1) * canvasW + x]);
            if (isTop && !inRun) {
              inRun = true;
              startX = x;
            } else if (!isTop && inRun) {
              inRun = false;
              hSegments.push(`M ${(startX + offsetX) * z} ${(y + offsetY) * z} L ${(x + offsetX) * z} ${(y + offsetY) * z}`);
            }
          }
          if (inRun) {
            hSegments.push(`M ${(startX + offsetX) * z} ${(y + offsetY) * z} L ${(canvasW + offsetX) * z} ${(y + offsetY) * z}`);
          }

          inRun = false;
          startX = 0;
          for (let x = 0; x < canvasW; x++) {
            const isBot = mask[y * canvasW + x] && (y === canvasH - 1 || !mask[(y + 1) * canvasW + x]);
            if (isBot && !inRun) {
              inRun = true;
              startX = x;
            } else if (!isBot && inRun) {
              inRun = false;
              hSegments.push(`M ${(startX + offsetX) * z} ${(y + 1 + offsetY) * z} L ${(x + offsetX) * z} ${(y + 1 + offsetY) * z}`);
            }
          }
          if (inRun) {
            hSegments.push(`M ${(startX + offsetX) * z} ${(y + 1 + offsetY) * z} L ${(canvasW + offsetX) * z} ${(y + 1 + offsetY) * z}`);
          }
        }

        for (let x = 0; x < canvasW; x++) {
          let inRun = false;
          let startY = 0;
          for (let y = 0; y < canvasH; y++) {
            const isLeft = mask[y * canvasW + x] && (x === 0 || !mask[y * canvasW + (x - 1)]);
            if (isLeft && !inRun) {
              inRun = true;
              startY = y;
            } else if (!isLeft && inRun) {
              inRun = false;
              vSegments.push(`M ${(x + offsetX) * z} ${(startY + offsetY) * z} L ${(x + offsetX) * z} ${(y + offsetY) * z}`);
            }
          }
          if (inRun) {
            vSegments.push(`M ${(x + offsetX) * z} ${(startY + offsetY) * z} L ${(x + offsetX) * z} ${(canvasH + offsetY) * z}`);
          }

          inRun = false;
          startY = 0;
          for (let y = 0; y < canvasH; y++) {
            const isRight = mask[y * canvasW + x] && (x === canvasW - 1 || !mask[y * canvasW + (x + 1)]);
            if (isRight && !inRun) {
              inRun = true;
              startY = y;
            } else if (!isRight && inRun) {
              inRun = false;
              vSegments.push(`M ${(x + 1 + offsetX) * z} ${(startY + offsetY) * z} L ${(x + 1 + offsetX) * z} ${(y + offsetY) * z}`);
            }
          }
          if (inRun) {
            vSegments.push(`M ${(x + 1 + offsetX) * z} ${(startY + offsetY) * z} L ${(x + 1 + offsetX) * z} ${(canvasH + offsetY) * z}`);
          }
        }

        return hSegments.concat(vSegments).join(' ');
      }

      function clearSelectionBox(shouldCancel = false) {
        if (state.selectionMoving) {
          if (shouldCancel) {
            cancelMoveSelection();
          } else {
            commitMoveSelection();
            return;
          }
        }
        selectionBox.classList.add('hidden');
        if (lassoSvg) lassoSvg.classList.add('hidden');
        if (magicSvg) magicSvg.classList.add('hidden');
        state.selection = null;
      }

      function updateSelectionBoxDisplay() {
        if (!state.selection) {
          if (selectionBox) selectionBox.classList.add('hidden');
          if (lassoSvg) lassoSvg.classList.add('hidden');
          if (magicSvg) magicSvg.classList.add('hidden');
          return;
        }
        const s = state.selection;
        const z = state.zoom;
        selectionBox.style.left = `${s.x * z}px`;
        selectionBox.style.top = `${s.y * z}px`;
        selectionBox.style.width = `${s.w * z}px`;
        selectionBox.style.height = `${s.h * z}px`;
        selectionBox.classList.remove('hidden');

        const selRectSvg = document.getElementById('selection-rect-svg');
        const selHandles = selectionBox.querySelectorAll('.sel-handle');

        if (state.selectionMoving) {
          selectionBox.classList.remove('bg-blue-500/10');
          if (selectionContentCanvas) {
            selectionContentCanvas.style.display = 'none';
          }
        } else {
          if (!s.isMagic && !s.isLasso) {
            selectionBox.classList.add('bg-blue-500/10');
          }
          if (selectionContentCanvas) {
            selectionContentCanvas.style.display = 'none';
          }
        }

        if (s.isMagic && (s.selectedMask || s.origMask)) {
          // Conforming SVG contour for magic wand selection (zero collateral damage border)
          if (selRectSvg) selRectSvg.classList.add('hidden');
          selHandles.forEach(h => h.classList.add('hidden'));
          selectionBox.classList.remove('bg-blue-500/10');
          if (lassoSvg) lassoSvg.classList.add('hidden');

          const mask = s.origMask || s.selectedMask;
          const offsetDx = (s.x - (s.origX !== undefined ? s.origX : s.x));
          const offsetDy = (s.y - (s.origY !== undefined ? s.origY : s.y));

          const pathD = generateMagicBoundaryPath(mask, state.width, state.height, z, offsetDx, offsetDy);
          if (magicPathBlack) magicPathBlack.setAttribute('d', pathD);
          if (magicPathWhite) magicPathWhite.setAttribute('d', pathD);
          if (magicSvg) magicSvg.classList.remove('hidden');
        } else if (s.isLasso && s.polygon) {
          if (magicSvg) magicSvg.classList.add('hidden');
          if (selRectSvg) selRectSvg.classList.add('hidden');
          selHandles.forEach(h => h.classList.add('hidden'));
          selectionBox.classList.remove('bg-blue-500/10');

          const offsetDx = (s.x - (s.origX !== undefined ? s.origX : s.x));
          const offsetDy = (s.y - (s.origY !== undefined ? s.origY : s.y));
          const ptsStr = s.polygon.map(p => `${(p.x + offsetDx) * z},${(p.y + offsetDy) * z}`).join(' ');

          if (lassoPolyFill) lassoPolyFill.setAttribute('points', ptsStr);
          if (lassoPolyBlack) lassoPolyBlack.setAttribute('points', ptsStr);
          if (lassoPolyWhite) lassoPolyWhite.setAttribute('points', ptsStr);
          if (lassoSvg) lassoSvg.classList.remove('hidden');
        } else {
          if (magicSvg) magicSvg.classList.add('hidden');
          if (selRectSvg) selRectSvg.classList.remove('hidden');
          selHandles.forEach(h => h.classList.remove('hidden'));
          selectionBox.classList.add('bg-blue-500/10');
          if (lassoSvg) lassoSvg.classList.add('hidden');
        }

        if (selectionOverlayTitle) {
          if (s.isMagic) {
            selectionOverlayTitle.textContent = `Magic Select (${state.magicMode === 'global' ? 'Global' : 'Adjacent'} - ${s.w}x${s.h} px)`;
          } else {
            selectionOverlayTitle.textContent = `Selection Actions (${s.w} x ${s.h} px)`;
          }
        }
      }

      function renderSelectionDataToCanvas(targetCtx, imgData, destX, destY, isTransparent, bgHex) {
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = imgData.width;
        tempCanvas.height = imgData.height;
        const tempCtx = tempCanvas.getContext('2d');
        tempCtx.imageSmoothingEnabled = false;

        if (isTransparent) {
          const cloned = new ImageData(
            new Uint8ClampedArray(imgData.data),
            imgData.width,
            imgData.height
          );
          const tempDiv = document.createElement('div');
          tempDiv.style.color = bgHex;
          document.body.appendChild(tempDiv);
          const bgRgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
          document.body.removeChild(tempDiv);

          const d = cloned.data;
          for (let i = 0; i < d.length; i += 4) {
            if (d[i] === bgRgb[0] && d[i + 1] === bgRgb[1] && d[i + 2] === bgRgb[2]) {
              d[i + 3] = 0;
            }
          }
          tempCtx.putImageData(cloned, 0, 0);
        } else {
          tempCtx.putImageData(imgData, 0, 0);
        }

        // Use drawImage so transparent pixels in imgData never overwrite or delete canvas pixels
        targetCtx.drawImage(tempCanvas, destX, destY);
      }

      function scaleImageDataNearestNeighbor(srcData, newWidth, newHeight) {
        const newImgData = new ImageData(newWidth, newHeight);
        const src = new Uint32Array(srcData.data.buffer);
        const dst = new Uint32Array(newImgData.data.buffer);
        
        const srcW = srcData.width;
        const srcH = srcData.height;

        for (let y = 0; y < newHeight; y++) {
          const srcY = Math.floor(y * srcH / newHeight);
          for (let x = 0; x < newWidth; x++) {
            const srcX = Math.floor(x * srcW / newWidth);
            dst[y * newWidth + x] = src[srcY * srcW + srcX];
          }
        }
        return newImgData;
      }

      function flipImageDataH(srcData) {
        const w = srcData.width;
        const h = srcData.height;
        const newImg = new ImageData(w, h);
        const src = new Uint32Array(srcData.data.buffer);
        const dst = new Uint32Array(newImg.data.buffer);
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            dst[y * w + (w - 1 - x)] = src[y * w + x];
          }
        }
        return newImg;
      }

      function flipImageDataV(srcData) {
        const w = srcData.width;
        const h = srcData.height;
        const newImg = new ImageData(w, h);
        const src = new Uint32Array(srcData.data.buffer);
        const dst = new Uint32Array(newImg.data.buffer);
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            dst[(h - 1 - y) * w + x] = src[y * w + x];
          }
        }
        return newImg;
      }

      function rotateImageData90(srcData) {
        const w = srcData.width;
        const h = srcData.height;
        const newW = h;
        const newH = w;
        const newImg = new ImageData(newW, newH);
        const src = new Uint32Array(srcData.data.buffer);
        const dst = new Uint32Array(newImg.data.buffer);
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            dst[x * newW + (newW - 1 - y)] = src[y * w + x];
          }
        }
        return newImg;
      }

      function invertImageData(srcData) {
        const d = srcData.data;
        for (let i = 0; i < d.length; i += 4) {
          d[i] = 255 - d[i];
          d[i + 1] = 255 - d[i + 1];
          d[i + 2] = 255 - d[i + 2];
        }
      }

      function renderFloatingSelection() {
        if (!state.selection) {
          previewCtx.clearRect(0, 0, state.width, state.height);
          if (selectionContentCanvas) {
            selectionContentCanvas.style.display = 'none';
          }
          return;
        }
        const s = state.selection;
        previewCtx.clearRect(0, 0, state.width, state.height);

        // Hide selectionContentCanvas so no image pixels spill outside the canvas boundary
        if (selectionContentCanvas) {
          selectionContentCanvas.style.display = 'none';
        }

        // Render floating selection onto previewCanvas.
        // Because previewCanvas is size (state.width x state.height),
        // only the part of the image within the boundary of the canvas is visible!
        renderSelectionDataToCanvas(previewCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
      }

      function startMoveSelection() {
        if (!state.selection) return;
        closeAllOverlays();
        state.selectionMoving = true;
        const s = state.selection;
        const targetCtx = getActiveLayerCtx();

        if (!s.preMoveState) {
          s.preMoveState = targetCtx.getImageData(0, 0, state.width, state.height);
          s.origX = s.x;
          s.origY = s.y;
        }

        clearSelectionAreaOnActiveLayer(targetCtx, s);
        compositeLayers();

        updateSelectionBoxDisplay();
        renderFloatingSelection();
        floatingMoveBar.classList.remove('hidden');
      }

      function updateMovePosition(newX, newY) {
        if (!state.selection || !state.selectionMoving) return;
        const s = state.selection;
        s.x = Math.max(-s.w + 1, Math.min(state.width - 1, newX));
        s.y = Math.max(-s.h + 1, Math.min(state.height - 1, newY));

        updateSelectionBoxDisplay();
        renderFloatingSelection();
      }

      function commitMoveSelection() {
        if (!state.selection || !state.selectionMoving) return;
        const s = state.selection;
        previewCtx.clearRect(0, 0, state.width, state.height);

        if (selectionContentCanvas) {
          selectionContentCanvas.style.display = 'none';
          const sCtx = selectionContentCanvas.getContext('2d');
          if (sCtx) sCtx.clearRect(0, 0, selectionContentCanvas.width, selectionContentCanvas.height);
        }

        const targetCtx = getActiveLayerCtx();
        // Stamp only onto targetCtx (which has bounds 0, 0, state.width, state.height).
        // Anything outside canvas boundaries is cleanly clipped and deleted!
        renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
        compositeLayers();
        state.selectionMoving = false;
        floatingMoveBar.classList.add('hidden');
        clearSelectionBox();
        saveHistoryState();
      }

      function cancelMoveSelection() {
        if (!state.selection || !state.selectionMoving) return;
        const s = state.selection;
        previewCtx.clearRect(0, 0, state.width, state.height);

        if (selectionContentCanvas) {
          selectionContentCanvas.style.display = 'none';
          const sCtx = selectionContentCanvas.getContext('2d');
          if (sCtx) sCtx.clearRect(0, 0, selectionContentCanvas.width, selectionContentCanvas.height);
        }

        if (s.isPasted) {
          state.selectionMoving = false;
          floatingMoveBar.classList.add('hidden');
          clearSelectionBox();
          statusHint.textContent = 'Pasted image canceled.';
          return;
        }

        if (s.preMoveState) {
          getActiveLayerCtx().putImageData(s.preMoveState, 0, 0);
          compositeLayers();
        }
        state.selectionMoving = false;
        floatingMoveBar.classList.add('hidden');
        s.x = s.origX;
        s.y = s.origY;
        s.preMoveState = null;
        updateSelectionBoxDisplay();
      }

      function eraseSelection() {
        if (!state.selection) return;
        const s = state.selection;
        const targetCtx = getActiveLayerCtx();
        if (state.selectionMoving) {
          previewCtx.clearRect(0, 0, state.width, state.height);
          state.selectionMoving = false;
          floatingMoveBar.classList.add('hidden');
        } else {
          clearSelectionAreaOnActiveLayer(targetCtx, s);
        }
        compositeLayers();
        clearSelectionBox();
        closeAllOverlays();
        saveHistoryState();
      }

      function scaleSelection(newW, newH) {
        if (!state.selection) return;
        newW = Math.max(1, Math.min(4096, Math.round(newW)));
        newH = Math.max(1, Math.min(4096, Math.round(newH)));
        const s = state.selection;

        const scaledData = scaleImageDataNearestNeighbor(s.imgData, newW, newH);

        if (state.selectionMoving) {
          s.w = newW;
          s.h = newH;
          s.imgData = scaledData;
          updateSelectionBoxDisplay();
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          if (!s.preMoveState) {
            s.preMoveState = targetCtx.getImageData(0, 0, state.width, state.height);
            s.origX = s.x;
            s.origY = s.y;
          }
          if (state.activeLayerIndex === 0) {
            targetCtx.fillStyle = state.bgColor;
            targetCtx.fillRect(s.x, s.y, s.w, s.h);
          } else {
            targetCtx.clearRect(s.x, s.y, s.w, s.h);
          }
          compositeLayers();
          s.w = newW;
          s.h = newH;
          s.imgData = scaledData;
          startMoveSelection();
          updateSelectionBoxDisplay();
        }
      }

      function pasteImageData(dataToPaste) {
        if (!dataToPaste) return;
        closeAllOverlays();

        if (state.selectionMoving) {
          commitMoveSelection();
        }

        const posX = 0;
        const posY = 0;

        state.selection = {
          x: posX,
          y: posY,
          w: dataToPaste.width,
          h: dataToPaste.height,
          imgData: dataToPaste,
          preMoveState: getActiveLayerCtx().getImageData(0, 0, state.width, state.height),
          origX: posX,
          origY: posY,
          isPasted: true
        };

        state.selectionMoving = true;
        updateSelectionBoxDisplay();
        renderFloatingSelection();
        floatingMoveBar.classList.remove('hidden');

        statusHint.textContent = `Pasted image (${dataToPaste.width} x ${dataToPaste.height} px). Drag to position; tap ✓ Stamp Down to bake to canvas.`;
      }

      function selectAllCanvas() {
        if (state.selectionMoving) {
          commitMoveSelection();
        }
        createSelection(0, 0, state.width, state.height);
        closeAllOverlays();
        statusHint.textContent = `Selected all canvas (${state.width} x ${state.height} px).`;
      }

      function selectAllAndFitToCanvas() {
        selectAllCanvas();
      }

      function fitSelectionToCanvas() {
        if (!state.selection) {
          createSelection(0, 0, state.width, state.height);
          closeAllOverlays();
          statusHint.textContent = `Selected all canvas (${state.width} x ${state.height} px).`;
          return;
        }

        const s = state.selection;
        const targetCtx = getActiveLayerCtx();

        if (state.selectionMoving) {
          const scaled = scaleImageDataNearestNeighbor(s.imgData, state.width, state.height);
          s.x = 0;
          s.y = 0;
          s.w = state.width;
          s.h = state.height;
          s.imgData = scaled;
          s.isLasso = false;
          s.isMagic = false;
          updateSelectionBoxDisplay();
          renderFloatingSelection();
          closeAllOverlays();
          statusHint.textContent = `Selection resized to the size of the canvas (${state.width} x ${state.height} px).`;
        } else {
          clearSelectionAreaOnActiveLayer(targetCtx, s);

          const scaled = scaleImageDataNearestNeighbor(s.imgData, state.width, state.height);
          s.x = 0;
          s.y = 0;
          s.w = state.width;
          s.h = state.height;
          s.imgData = scaled;
          s.isLasso = false;
          s.isMagic = false;

          renderSelectionDataToCanvas(targetCtx, scaled, 0, 0, state.selectTransparent, state.bgColor);
          compositeLayers();
          previewCtx.clearRect(0, 0, state.width, state.height);
          state.selectionMoving = false;
          if (floatingMoveBar) floatingMoveBar.classList.add('hidden');

          updateSelectionBoxDisplay();
          saveHistoryState();
          closeAllOverlays();
          statusHint.textContent = `Selection resized to the size of the canvas (${state.width} x ${state.height} px).`;
        }
      }

      btnCommitMove.addEventListener('click', commitMoveSelection);
      btnCancelMove.addEventListener('click', cancelMoveSelection);

      // Tap Selection Box to open Menu, or Drag directly to move!
      let selBoxTouchStartX = 0;
      let selBoxTouchStartY = 0;
      let selBoxIsDrag = false;
      let selDragStartSelX = 0;
      let selDragStartSelY = 0;

      function onSelBoxPointerDown(e) {
        e.stopPropagation();
        if (!state.selection) return;

        const clientX = e.clientX !== undefined ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
        const clientY = e.clientY !== undefined ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);

        selBoxTouchStartX = clientX;
        selBoxTouchStartY = clientY;
        selBoxIsDrag = false;
        selDragStartSelX = state.selection.x;
        selDragStartSelY = state.selection.y;

        const onSelMove = (ev) => {
          const cx = ev.clientX !== undefined ? ev.clientX : (ev.touches && ev.touches[0] ? ev.touches[0].clientX : 0);
          const cy = ev.clientY !== undefined ? ev.clientY : (ev.touches && ev.touches[0] ? ev.touches[0].clientY : 0);
          const dist = Math.hypot(cx - selBoxTouchStartX, cy - selBoxTouchStartY);
          if (dist > 3) {
            if (!selBoxIsDrag) {
              if (!state.selectionMoving) {
                startMoveSelection();
              }
              selBoxIsDrag = true;
            }
            const dx = Math.round((cx - selBoxTouchStartX) / state.zoom);
            const dy = Math.round((cy - selBoxTouchStartY) / state.zoom);
            updateMovePosition(selDragStartSelX + dx, selDragStartSelY + dy);
          }
        };

        const onSelUp = (ev) => {
          window.removeEventListener('pointermove', onSelMove);
          window.removeEventListener('pointerup', onSelUp);
          window.removeEventListener('touchmove', onSelMove);
          window.removeEventListener('touchend', onSelUp);

          if (!selBoxIsDrag) {
            // TAP inside selection region: open Selection Actions Overlay!
            openOverlay(overlaySelection);
          }
        };

        window.addEventListener('pointermove', onSelMove);
        window.addEventListener('pointerup', onSelUp);
        window.addEventListener('touchmove', onSelMove, { passive: false });
        window.addEventListener('touchend', onSelUp, { passive: false });
      }

      // Direct click on floating Edit Selection button
      btnSelectionEdit.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openSelectionMenu();
      });
      btnSelectionEdit.addEventListener('touchend', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openSelectionMenu();
      }, { passive: false });

      // Tapping inside the selection box also opens the menu
      selectionBox.addEventListener('click', (e) => {
        if (!selBoxIsDrag) {
          e.preventDefault();
          e.stopPropagation();
          openSelectionMenu();
        }
      });

      selectionBox.addEventListener('pointerdown', onSelBoxPointerDown);
      selectionBox.addEventListener('touchstart', onSelBoxPointerDown, { passive: false });

      // Selection Overlay Action Handlers
      btnCloseSelectionOverlay.addEventListener('click', closeAllOverlays);

      if (btnToggleTransparentSelection) {
        btnToggleTransparentSelection.addEventListener('click', (e) => {
          e.stopPropagation();
          state.selectTransparent = !state.selectTransparent;
          updateTransparentSwitchUI();
          if (state.selectTransparent) {
            deleteSecondaryColorFromSelection();
          } else if (state.selectionMoving) {
            renderFloatingSelection();
          }
        });
      }

      btnSelMove.addEventListener('click', () => {
        closeAllOverlays();
        startMoveSelection();
      });

      btnSelErase.addEventListener('click', () => {
        eraseSelection();
      });

      btnSelScale2x.addEventListener('click', () => {
        closeAllOverlays();
        if (state.selection) {
          scaleSelection(state.selection.w * 2, state.selection.h * 2);
        }
      });

      btnSelScaleHalf.addEventListener('click', () => {
        closeAllOverlays();
        if (state.selection) {
          scaleSelection(Math.round(state.selection.w / 2), Math.round(state.selection.h / 2));
        }
      });

      btnSelScaleCustom.addEventListener('click', () => {
        closeAllOverlays();
        if (state.selection) {
          inputSelWidth.value = state.selection.w;
          inputSelHeight.value = state.selection.h;
          modalSelCustomSize.classList.remove('hidden');
        }
      });

      if (btnSelSelectAll) {
        btnSelSelectAll.addEventListener('click', () => {
          selectAllCanvas();
        });
      }

      if (btnSelAllFit) {
        btnSelAllFit.addEventListener('click', () => {
          fitSelectionToCanvas();
        });
      }

      if (btnSelScaleFitCanvas) {
        btnSelScaleFitCanvas.addEventListener('click', () => {
          fitSelectionToCanvas();
        });
      }

      if (actionSelectAllFit) {
        actionSelectAllFit.addEventListener('click', () => {
          selectAllAndFitToCanvas();
        });
      }

      btnApplySelSize.addEventListener('click', () => {
        const nw = parseInt(inputSelWidth.value, 10);
        const nh = parseInt(inputSelHeight.value, 10);
        if (nw > 0 && nh > 0) {
          modalSelCustomSize.classList.add('hidden');
          scaleSelection(nw, nh);
        }
      });

      btnCancelSelSize.addEventListener('click', () => modalSelCustomSize.classList.add('hidden'));
      btnCloseSelSizeModal.addEventListener('click', () => modalSelCustomSize.classList.add('hidden'));

      btnSelFlipH.addEventListener('click', () => {
        if (!state.selection) return;
        const s = state.selection;
        s.imgData = flipImageDataH(s.imgData);
        if (state.selectionMoving) {
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          clearSelectionAreaOnActiveLayer(targetCtx, s);
          renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
          compositeLayers();
          saveHistoryState();
        }
        closeAllOverlays();
      });

      btnSelFlipV.addEventListener('click', () => {
        if (!state.selection) return;
        const s = state.selection;
        s.imgData = flipImageDataV(s.imgData);
        if (state.selectionMoving) {
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          clearSelectionAreaOnActiveLayer(targetCtx, s);
          renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
          compositeLayers();
          saveHistoryState();
        }
        closeAllOverlays();
      });

      btnSelRotate.addEventListener('click', () => {
        if (!state.selection) return;
        const s = state.selection;
        const oldW = s.w;
        const oldH = s.h;
        s.imgData = rotateImageData90(s.imgData);
        s.w = oldH;
        s.h = oldW;
        updateSelectionBoxDisplay();
        if (state.selectionMoving) {
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          clearSelectionAreaOnActiveLayer(targetCtx, s);
          renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
          compositeLayers();
          saveHistoryState();
        }
        closeAllOverlays();
      });

      if (btnSelPaste) {
        btnSelPaste.addEventListener('click', () => {
          closeAllOverlays();
          const dataToPaste = localCopiedData || (state.selection ? state.selection.imgData : null);
          if (dataToPaste) {
            pasteImageData(dataToPaste);
          } else {
            statusHint.textContent = 'Clipboard is empty. Copy a selection first.';
          }
        });
      }

      if (btnSelPickColor) {
        btnSelPickColor.addEventListener('click', () => {
          if (!state.selection) return;
          const s = state.selection;
          if (s.sampledHexColor && s.sampledHexColor !== 'transparent') {
            applyNewForegroundColor(s.sampledHexColor);
            statusHint.textContent = `Copied color ${s.sampledHexColor} to active foreground!`;
            updateMagicSelectionMenuUI();
          } else {
            statusHint.textContent = 'Selected pixels are transparent.';
          }
        });
      }

      if (btnSelFillColor) {
        btnSelFillColor.addEventListener('click', () => {
          if (!state.selection) return;
          const s = state.selection;

          const tempDiv = document.createElement('div');
          tempDiv.style.color = state.fgColor;
          document.body.appendChild(tempDiv);
          const fgRgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
          document.body.removeChild(tempDiv);

          const d = s.imgData.data;
          for (let i = 0; i < d.length; i += 4) {
            if (d[i + 3] > 0) {
              d[i] = fgRgb[0];
              d[i + 1] = fgRgb[1];
              d[i + 2] = fgRgb[2];
              d[i + 3] = 255;
            }
          }

          s.sampledHexColor = state.fgColor;
          updateMagicSelectionMenuUI();

          if (state.selectionMoving) {
            renderFloatingSelection();
          } else {
            const targetCtx = getActiveLayerCtx();
            const tempC = document.createElement('canvas');
            tempC.width = s.w;
            tempC.height = s.h;
            tempC.getContext('2d').putImageData(s.imgData, 0, 0);
            targetCtx.drawImage(tempC, s.x, s.y);
            compositeLayers();
            saveHistoryState();
          }

          statusHint.textContent = `Recolored selection to ${state.fgColor}`;
        });
      }

      if (btnSelModeAdj) {
        btnSelModeAdj.addEventListener('click', () => {
          state.magicMode = 'adjacent';
          updateMagicSelectionMenuUI();
          updateBottomToolLabel();
          if (state.selection && state.selection.isMagic && state.lastMagicClickX !== null) {
            performMagicSelect(state.lastMagicClickX, state.lastMagicClickY);
          }
        });
      }

      if (btnSelModeGlob) {
        btnSelModeGlob.addEventListener('click', () => {
          state.magicMode = 'global';
          updateMagicSelectionMenuUI();
          updateBottomToolLabel();
          if (state.selection && state.selection.isMagic && state.lastMagicClickX !== null) {
            performMagicSelect(state.lastMagicClickX, state.lastMagicClickY);
          }
        });
      }

      btnSelCopy.addEventListener('click', () => {
        if (state.selection) {
          localCopiedData = state.selection.imgData;
        }
        closeAllOverlays();
      });

      btnSelCut.addEventListener('click', () => {
        if (state.selection) {
          localCopiedData = state.selection.imgData;
          eraseSelection();
        }
      });

      btnSelInvert.addEventListener('click', () => {
        if (!state.selection) return;
        const s = state.selection;
        invertImageData(s.imgData);
        if (state.selectionMoving) {
          renderFloatingSelection();
        } else {
          const targetCtx = getActiveLayerCtx();
          clearSelectionAreaOnActiveLayer(targetCtx, s);
          renderSelectionDataToCanvas(targetCtx, s.imgData, s.x, s.y, state.selectTransparent, state.bgColor);
          compositeLayers();
          saveHistoryState();
        }
        closeAllOverlays();
      });

      btnSelDeselect.addEventListener('click', () => {
        clearSelectionBox();
        closeAllOverlays();
      });

      // --- Pointer Handlers ---
            function performMagicSelect(clickX, clickY) {
        if (clickX < 0 || clickX >= state.width || clickY < 0 || clickY >= state.height) return;
        state.lastMagicClickX = clickX;
        state.lastMagicClickY = clickY;

        const targetCtx = getActiveLayerCtx();
        const imgData = targetCtx.getImageData(0, 0, state.width, state.height);
        const u32 = new Uint32Array(imgData.data.buffer);
        const d = imgData.data;

        const targetIdx = clickY * state.width + clickX;
        const targetVal = u32[targetIdx];
        const tr = d[targetIdx * 4];
        const tg = d[targetIdx * 4 + 1];
        const tb = d[targetIdx * 4 + 2];
        const ta = d[targetIdx * 4 + 3];
        const sampledHex = ta === 0 ? 'transparent' : '#' + [tr, tg, tb].map(v => v.toString(16).padStart(2, '0')).join('');

        const selected = new Uint8Array(state.width * state.height);
        let minX = state.width, maxX = -1, minY = state.height, maxY = -1;
        let count = 0;

        if (state.magicMode === 'global') {
          for (let cy = 0; cy < state.height; cy++) {
            for (let cx = 0; cx < state.width; cx++) {
              const idx = cy * state.width + cx;
              if (u32[idx] === targetVal) {
                selected[idx] = 1;
                count++;
                if (cx < minX) minX = cx;
                if (cx > maxX) maxX = cx;
                if (cy < minY) minY = cy;
                if (cy > maxY) maxY = cy;
              }
            }
          }
        } else {
          // Adjacent (BFS 8-way flood fill, connecting orthogonally and diagonally)
          const queue = [targetIdx];
          selected[targetIdx] = 1;
          let head = 0;

          while (head < queue.length) {
            const curr = queue[head++];
            const cx = curr % state.width;
            const cy = Math.floor(curr / state.width);
            count++;

            if (cx < minX) minX = cx;
            if (cx > maxX) maxX = cx;
            if (cy < minY) minY = cy;
            if (cy > maxY) maxY = cy;

            // Check all 8 neighboring pixels (orthogonal and diagonal)
            for (let dy = -1; dy <= 1; dy++) {
              const ny = cy + dy;
              if (ny < 0 || ny >= state.height) continue;
              for (let dx = -1; dx <= 1; dx++) {
                if (dx === 0 && dy === 0) continue;
                const nx = cx + dx;
                if (nx < 0 || nx >= state.width) continue;
                const nIdx = ny * state.width + nx;
                if (!selected[nIdx] && u32[nIdx] === targetVal) {
                  selected[nIdx] = 1;
                  queue.push(nIdx);
                }
              }
            }
          }
        }

        if (count > 0 && minX <= maxX && minY <= maxY) {
          const w = maxX - minX + 1;
          const h = maxY - minY + 1;

          const subImg = targetCtx.getImageData(minX, minY, w, h);
          const sd = subImg.data;
          for (let py = 0; py < h; py++) {
            for (let px = 0; px < w; px++) {
              const gIdx = (minY + py) * state.width + (minX + px);
              if (!selected[gIdx]) {
                sd[(py * w + px) * 4 + 3] = 0;
              }
            }
          }

          state.selection = {
            x: minX,
            y: minY,
            w,
            h,
            imgData: subImg,
            isMagic: true,
            magicMode: state.magicMode,
            selectedMask: selected,
            origMask: new Uint8Array(selected),
            sampledHexColor: sampledHex,
            targetVal
          };

          updateSelectionBoxDisplay();
          updateMagicSelectionMenuUI();
          statusHint.textContent = `Magic Selected ${count} pixels (${state.magicMode}). Tap '⚡ Selection Options' for Color tools!`;
        }
      }

      function onPointerDown(e) {
        if (state.stagedShape) {
          commitStagedShape();
        }
        if (state.stagedText) {
          commitStagedText();
        }
        if (state.selectionMoving) {
          commitMoveSelection();
        }

        const coords = getCanvasCoordinates(e);
        state.isDrawing = true;
        state.mouseButton = e.button === 2 ? 2 : 0;
        state.startX = coords.x;
        state.startY = coords.y;
        state.lastX = coords.x;
        state.lastY = coords.y;

        const activeColor = state.mouseButton === 2 ? state.bgColor : state.fgColor;
        const targetCtx = getActiveLayerCtx();

        if (state.tool === 'pencil') {
          putPixel(targetCtx, coords.x, coords.y, activeColor, state.pencilSize);
          compositeLayers();
        } else if (state.tool === 'eraser') {
          if (state.mouseButton === 2) {
            eraseColorOnly(coords.x, coords.y, state.eraserSize, state.fgColor, state.bgColor);
          } else {
            erasePixel(targetCtx, coords.x, coords.y, state.eraserSize);
          }
          compositeLayers();
        } else if (state.tool === 'brush') {
          applyBrush(targetCtx, coords.x, coords.y, activeColor, state.brushShape, state.brushSize);
          compositeLayers();
        } else if (state.tool === 'spray') {
          applyAirbrush(targetCtx, coords.x, coords.y, activeColor, state.sprayRadius);
          compositeLayers();
        } else if (state.tool === 'fill') {
          floodFill(coords.x, coords.y, activeColor);
          state.isDrawing = false;
        } else if (state.tool === 'picker') {
          pickColorAt(coords.x, coords.y, state.mouseButton === 2);
          state.isDrawing = false;
        } else if (state.tool === 'zoom') {
          if (state.mouseButton === 2) {
            const prev = [...zoomPresets].reverse().find(z => z < state.zoom * 0.95);
            setZoom(prev !== undefined ? prev : Math.max(0.01, state.zoom / 2));
          } else {
            const next = zoomPresets.find(z => z > state.zoom * 1.05);
            setZoom(next !== undefined ? next : Math.min(32, state.zoom * 2));
          }
          state.isDrawing = false;
        } else if (state.tool === 'text') {
          state.pendingStampX = coords.x;
          state.pendingStampY = coords.y;
          modalTextStamp.classList.remove('hidden');
          updateModalTextPreview();
          inputStampText.focus();
          state.isDrawing = false;
        } else if (state.tool === 'magic-select') {
          clearSelectionBox();
          performMagicSelect(coords.x, coords.y);
          state.isDrawing = false;
        } else if (state.tool === 'free-select') {
          clearSelectionBox();
          state.lassoPoints = [{ x: coords.x, y: coords.y }];
          state.isDrawing = true;
        } else if (state.tool === 'curve') {
          state.isDrawing = true;
          if (state.curveStep === 0) {
            state.curveP0 = { x: coords.x, y: coords.y };
            state.curveP3 = { x: coords.x, y: coords.y };
            state.curveP1 = { x: coords.x, y: coords.y };
            state.curveP2 = { x: coords.x, y: coords.y };
          } else if (state.curveStep === 1) {
            state.curveP1 = { x: coords.x, y: coords.y };
            state.curveP2 = { x: coords.x, y: coords.y };
          } else if (state.curveStep === 2) {
            state.curveP2 = { x: coords.x, y: coords.y };
          }
        } else if (state.tool === 'polygon') {
          if (state.polygonPoints.length === 0) {
            state.polygonPoints = [{ x: coords.x, y: coords.y }];
            state.isDrawing = true;
          } else {
            const p0 = state.polygonPoints[0];
            const dist = Math.hypot(coords.x - p0.x, coords.y - p0.y);
            if (state.polygonPoints.length >= 3 && dist <= 4) {
              finishPolygon();
              state.isDrawing = false;
              return;
            }
            state.polygonPoints.push({ x: coords.x, y: coords.y });
            state.isDrawing = true;
          }
        }
      }

      function onPointerMove(e) {
        const coords = getCanvasCoordinates(e);
        statusCoords.textContent = `${coords.x}, ${coords.y}`;

        if (!state.isDrawing) return;

        state.lastX = coords.x;
        state.lastY = coords.y;

        const activeColor = state.mouseButton === 2 ? state.bgColor : state.fgColor;
        const targetCtx = getActiveLayerCtx();

        if (state.tool === 'pencil') {
          drawBresenhamLine(targetCtx, state.lastX, state.lastY, coords.x, coords.y, activeColor, state.pencilSize);
          compositeLayers();
        } else if (state.tool === 'eraser') {
          if (state.mouseButton === 2) {
            eraseColorOnly(coords.x, coords.y, state.eraserSize, state.fgColor, state.bgColor);
          } else {
            eraseBresenhamLine(targetCtx, state.lastX, state.lastY, coords.x, coords.y, state.eraserSize);
          }
          compositeLayers();
        } else if (state.tool === 'brush') {
          drawBrushStroke(targetCtx, state.lastX, state.lastY, coords.x, coords.y, activeColor, state.brushShape, state.brushSize);
          compositeLayers();
        } else if (state.tool === 'spray') {
          applyAirbrush(targetCtx, coords.x, coords.y, activeColor, state.sprayRadius);
          compositeLayers();
        } else if (['line', 'rect', 'ellipse', 'roundrect', 'select'].includes(state.tool)) {
          showLiveDimension(state.startX, state.startY, coords.x, coords.y);
          previewCtx.clearRect(0, 0, state.width, state.height);

          const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
          const fillCol = state.mouseButton === 2 ? state.fgColor : state.bgColor;

          if (state.tool === 'line') {
            drawBresenhamLine(previewCtx, state.startX, state.startY, coords.x, coords.y, strokeCol, state.lineThickness);
          } else if (state.tool === 'rect') {
            drawBresenhamRect(previewCtx, state.startX, state.startY, coords.x, coords.y, strokeCol, fillCol, state.shapeMode);
          } else if (state.tool === 'ellipse') {
            const rx = Math.abs(coords.x - state.startX) / 2;
            const ry = Math.abs(coords.y - state.startY) / 2;
            const cx = Math.min(state.startX, coords.x) + rx;
            const cy = Math.min(state.startY, coords.y) + ry;
            drawBresenhamEllipse(previewCtx, cx, cy, rx, ry, strokeCol, fillCol, state.shapeMode);
          } else if (state.tool === 'roundrect') {
            drawBresenhamRoundRect(previewCtx, state.startX, state.startY, coords.x, coords.y, strokeCol, fillCol, state.shapeMode);
          } else if (state.tool === 'select') {
            drawBresenhamRect(previewCtx, state.startX, state.startY, coords.x, coords.y, '#000000', '', 'outline');
          }
        } else if (state.tool === 'free-select' && state.lassoPoints.length > 0) {
          state.lassoPoints.push({ x: coords.x, y: coords.y });
          previewCtx.clearRect(0, 0, state.width, state.height);
          for (let i = 0; i < state.lassoPoints.length - 1; i++) {
            drawBresenhamLine(previewCtx, state.lassoPoints[i].x, state.lassoPoints[i].y, state.lassoPoints[i + 1].x, state.lassoPoints[i + 1].y, '#000000', 1);
          }
        } else if (state.tool === 'curve' && state.curveP0) {
          showLiveDimension(state.curveP0.x, state.curveP0.y, coords.x, coords.y);
          const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
          previewCtx.clearRect(0, 0, state.width, state.height);
          if (state.curveStep === 0) {
            state.curveP3 = { x: coords.x, y: coords.y };
            state.curveP1 = state.curveP0;
            state.curveP2 = state.curveP3;
            drawBresenhamLine(previewCtx, state.curveP0.x, state.curveP0.y, state.curveP3.x, state.curveP3.y, strokeCol, state.lineThickness);
          } else if (state.curveStep === 1) {
            state.curveP1 = { x: coords.x, y: coords.y };
            state.curveP2 = { x: coords.x, y: coords.y };
            drawBresenhamBezier(previewCtx, state.curveP0, state.curveP1, state.curveP2, state.curveP3, strokeCol, state.lineThickness);
          } else if (state.curveStep === 2) {
            state.curveP2 = { x: coords.x, y: coords.y };
            drawBresenhamBezier(previewCtx, state.curveP0, state.curveP1, state.curveP2, state.curveP3, strokeCol, state.lineThickness);
          }
        } else if (state.tool === 'polygon' && state.polygonPoints.length > 0) {
          const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
          previewCtx.clearRect(0, 0, state.width, state.height);
          for (let i = 0; i < state.polygonPoints.length - 1; i++) {
            drawBresenhamLine(previewCtx, state.polygonPoints[i].x, state.polygonPoints[i].y, state.polygonPoints[i + 1].x, state.polygonPoints[i + 1].y, strokeCol, 1);
          }
          const lastPt = state.polygonPoints[state.polygonPoints.length - 1];
          drawBresenhamLine(previewCtx, lastPt.x, lastPt.y, coords.x, coords.y, strokeCol, 1);
        }
      }

      function onPointerUp(e) {
        if (!state.isDrawing) return;
        state.isDrawing = false;
        const coords = getCanvasCoordinates(e);
        previewCtx.clearRect(0, 0, state.width, state.height);

        const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
        const fillCol = state.mouseButton === 2 ? state.fgColor : state.bgColor;

        if (state.tool === 'line') {
          previewCtx.clearRect(0, 0, state.width, state.height);
          stageShape({
            type: 'line',
            p0: { x: state.startX, y: state.startY },
            p1: { x: coords.x, y: coords.y },
            strokeColor: strokeCol,
            thickness: state.lineThickness
          });
        } else if (state.tool === 'rect') {
          previewCtx.clearRect(0, 0, state.width, state.height);
          stageShape({
            type: 'rect',
            p0: { x: state.startX, y: state.startY },
            p1: { x: coords.x, y: coords.y },
            strokeColor: strokeCol,
            fillColor: fillCol,
            mode: state.shapeMode
          });
        } else if (state.tool === 'ellipse') {
          previewCtx.clearRect(0, 0, state.width, state.height);
          stageShape({
            type: 'ellipse',
            p0: { x: state.startX, y: state.startY },
            p1: { x: coords.x, y: coords.y },
            strokeColor: strokeCol,
            fillColor: fillCol,
            mode: state.shapeMode
          });
        } else if (state.tool === 'roundrect') {
          previewCtx.clearRect(0, 0, state.width, state.height);
          stageShape({
            type: 'roundrect',
            p0: { x: state.startX, y: state.startY },
            p1: { x: coords.x, y: coords.y },
            strokeColor: strokeCol,
            fillColor: fillCol,
            mode: state.shapeMode
          });
        } else if (state.tool === 'select') {
          const x = Math.min(state.startX, coords.x);
          const y = Math.min(state.startY, coords.y);
          const w = Math.abs(coords.x - state.startX) + 1;
          const h = Math.abs(coords.y - state.startY) + 1;

          if (w > 1 && h > 1) {
            createSelection(x, y, w, h);
          }
        } else if (state.tool === 'free-select' && state.lassoPoints.length > 5) {
          previewCtx.clearRect(0, 0, state.width, state.height);
          const pts = state.lassoPoints;
          const minX = Math.max(0, Math.min(...pts.map(p => p.x)));
          const minY = Math.max(0, Math.min(...pts.map(p => p.y)));
          const maxX = Math.min(state.width - 1, Math.max(...pts.map(p => p.x)));
          const maxY = Math.min(state.height - 1, Math.max(...pts.map(p => p.y)));
          const w = maxX - minX + 1;
          const h = maxY - minY + 1;

          if (w > 2 && h > 2) {
            const rawImg = getActiveLayerCtx().getImageData(minX, minY, w, h);
            const d = rawImg.data;
            for (let py = 0; py < h; py++) {
              for (let px = 0; px < w; px++) {
                const gx = minX + px;
                const gy = minY + py;
                if (!isPointInPolygon(gx, gy, pts)) {
                  d[(py * w + px) * 4 + 3] = 0; // Transparent mask outside lasso
                }
              }
            }
            const polyPoints = pts.map(p => ({ x: p.x, y: p.y }));
            state.selection = {
              x: minX,
              y: minY,
              w: w,
              h: h,
              imgData: rawImg,
              isLasso: true,
              polygon: polyPoints,
              origPolygon: polyPoints
            };
            updateSelectionBoxDisplay();
          }
          state.lassoPoints = [];
        } else if (state.tool === 'curve' && state.curveP0) {
          const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
          if (state.curveStep === 0) {
            state.curveP3 = { x: coords.x, y: coords.y };
            state.curveP1 = state.curveP0;
            state.curveP2 = state.curveP3;
            state.curveStep = 1;
            previewCtx.clearRect(0, 0, state.width, state.height);
            drawBresenhamBezier(previewCtx, state.curveP0, state.curveP1, state.curveP2, state.curveP3, strokeCol, state.lineThickness);
            statusHint.textContent = 'Curve: Click and drag anywhere to bend the curve (1 of 2).';
          } else if (state.curveStep === 1) {
            state.curveP1 = { x: coords.x, y: coords.y };
            state.curveP2 = { x: coords.x, y: coords.y };
            state.curveStep = 2;
            previewCtx.clearRect(0, 0, state.width, state.height);
            drawBresenhamBezier(previewCtx, state.curveP0, state.curveP1, state.curveP2, state.curveP3, strokeCol, state.lineThickness);
            statusHint.textContent = 'Curve: Click and drag for second bend, or tap to finish.';
          } else if (state.curveStep === 2) {
            state.curveP2 = { x: coords.x, y: coords.y };
            previewCtx.clearRect(0, 0, state.width, state.height);
            stageShape({
              type: 'curve',
              p0: { x: state.curveP0.x, y: state.curveP0.y },
              p1: { x: state.curveP1.x, y: state.curveP1.y },
              p2: { x: coords.x, y: coords.y },
              p3: { x: state.curveP3.x, y: state.curveP3.y },
              strokeColor: strokeCol,
              thickness: state.lineThickness
            });
            state.curveStep = 0;
            statusHint.textContent = 'Curve: Adjust handles, then tap Commit to bake.';
          }
        } else if (state.tool === 'polygon') {
          if (state.polygonPoints.length === 1 && (coords.x !== state.polygonPoints[0].x || coords.y !== state.polygonPoints[0].y)) {
            state.polygonPoints.push({ x: coords.x, y: coords.y });
          }
          const strokeCol = state.mouseButton === 2 ? state.bgColor : state.fgColor;
          previewCtx.clearRect(0, 0, state.width, state.height);
          for (let i = 0; i < state.polygonPoints.length - 1; i++) {
            drawBresenhamLine(previewCtx, state.polygonPoints[i].x, state.polygonPoints[i].y, state.polygonPoints[i + 1].x, state.polygonPoints[i + 1].y, strokeCol, 1);
          }
          statusHint.textContent = `Polygon: ${state.polygonPoints.length} vertices. Tap next point or double-click to close.`;
        } else if (['pencil', 'eraser', 'brush', 'spray'].includes(state.tool)) {
          hideLiveDimension();
          saveHistoryState();
        }
      }

      function eraseColorOnly(cx, cy, size, matchHex, replaceHex) {
        const offset = Math.floor(size / 2);
        const x0 = Math.max(0, cx - offset);
        const y0 = Math.max(0, cy - offset);
        const x1 = Math.min(state.width - 1, cx + offset);
        const y1 = Math.min(state.height - 1, cy + offset);

        const targetCtx = getActiveLayerCtx();
        const imgData = targetCtx.getImageData(0, 0, state.width, state.height);
        const d = imgData.data;
        const w = state.width;

        const temp = document.createElement('div');
        temp.style.color = matchHex;
        document.body.appendChild(temp);
        const matchRGB = window.getComputedStyle(temp).color.match(/\d+/g).map(Number);
        temp.style.color = replaceHex;
        const replaceRGB = window.getComputedStyle(temp).color.match(/\d+/g).map(Number);
        document.body.removeChild(temp);

        for (let y = y0; y <= y1; y++) {
          for (let x = x0; x <= x1; x++) {
            const idx = (y * w + x) * 4;
            if (d[idx + 3] > 0 && d[idx] === matchRGB[0] && d[idx + 1] === matchRGB[1] && d[idx + 2] === matchRGB[2]) {
              if (state.activeLayerIndex === 0) {
                d[idx] = replaceRGB[0];
                d[idx + 1] = replaceRGB[1];
                d[idx + 2] = replaceRGB[2];
                d[idx + 3] = 255;
              } else {
                d[idx + 3] = 0; // True transparent erase on higher layers
              }
            }
          }
        }
        targetCtx.putImageData(imgData, 0, 0);
        compositeLayers();
      }

      // --- Strict 1-Bit Binary Pixel Text Engine (Zero Gradient Aura) ---
      function generatePixelTextBitmap(text, fontSize, fontFamily, thickness, kerning, color) {
        if (!text) return null;

        const scratch = document.createElement('canvas');
        const sctx = scratch.getContext('2d');
        const weight = thickness > 1 ? 'bold ' : '';
        sctx.font = `${weight}${fontSize}px ${fontFamily}`;
        if ('letterSpacing' in sctx) {
          sctx.letterSpacing = `${kerning}px`;
        }

        const metrics = sctx.measureText(text);
        const textW = Math.max(16, Math.ceil(metrics.width) + (thickness * 4) + Math.abs(kerning * text.length) + 16);
        const textH = Math.max(16, Math.ceil(fontSize * 1.5) + (thickness * 4) + 16);

        scratch.width = textW;
        scratch.height = textH;
        sctx.imageSmoothingEnabled = false;
        sctx.font = `${weight}${fontSize}px ${fontFamily}`;
        if ('letterSpacing' in sctx) {
          sctx.letterSpacing = `${kerning}px`;
        }
        sctx.textBaseline = 'top';

        const padX = thickness + 3;
        const padY = thickness + 3;

        sctx.fillStyle = '#000000';
        sctx.fillText(text, padX, padY);

        if (thickness > 1) {
          sctx.lineWidth = thickness;
          sctx.strokeStyle = '#000000';
          sctx.strokeText(text, padX, padY);
        }

        const rawImg = sctx.getImageData(0, 0, textW, textH);
        const d = rawImg.data;

        const tempDiv = document.createElement('div');
        tempDiv.style.color = color;
        document.body.appendChild(tempDiv);
        const rgb = window.getComputedStyle(tempDiv).color.match(/\d+/g).map(Number);
        document.body.removeChild(tempDiv);

        let minX = textW, maxX = -1, minY = textH, maxY = -1;
        let hasPixels = false;

        // Binary Alpha Thresholding: Eliminates all anti-aliasing / gradient aura!
        for (let y = 0; y < textH; y++) {
          for (let x = 0; x < textW; x++) {
            const idx = (y * textW + x) * 4;
            const alpha = d[idx + 3];
            if (alpha >= 80) {
              d[idx] = rgb[0];
              d[idx + 1] = rgb[1];
              d[idx + 2] = rgb[2];
              d[idx + 3] = 255;
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
              hasPixels = true;
            } else {
              d[idx + 3] = 0;
            }
          }
        }

        if (!hasPixels) return null;

        const cropW = maxX - minX + 1;
        const cropH = maxY - minY + 1;

        const cropCanvas = document.createElement('canvas');
        cropCanvas.width = cropW;
        cropCanvas.height = cropH;
        const cropCtx = cropCanvas.getContext('2d');
        cropCtx.imageSmoothingEnabled = false;

        sctx.putImageData(rawImg, 0, 0);
        cropCtx.drawImage(scratch, minX, minY, cropW, cropH, 0, 0, cropW, cropH);

        return {
          canvas: cropCanvas,
          imgData: cropCtx.getImageData(0, 0, cropW, cropH),
          w: cropW,
          h: cropH
        };
      }

      function updateModalTextPreview() {
        if (!textModalPreviewCanvas) return;
        const txt = inputStampText.value.trim() || 'PIXEL';
        const sz = parseInt(inputStampSize.value, 10) || 12;
        const th = state.textThickness || 1;
        const kern = parseInt(inputStampKerning.value, 10) || 0;
        const font = selectStampFont.value || 'monospace';

        const bmp = generatePixelTextBitmap(txt, sz, font, th, kern, state.fgColor);
        if (bmp) {
          textModalPreviewCanvas.width = bmp.w;
          textModalPreviewCanvas.height = bmp.h;
          const pctx = textModalPreviewCanvas.getContext('2d');
          pctx.imageSmoothingEnabled = false;
          pctx.clearRect(0, 0, bmp.w, bmp.h);
          pctx.drawImage(bmp.canvas, 0, 0);
          if (textPreviewDims) textPreviewDims.textContent = `${bmp.w} x ${bmp.h} px`;
        }
      }

      function updateStagedTextDisplay() {
        if (!state.stagedText || !state.stagedText.bitmap) {
          if (textDragBox) textDragBox.classList.add('hidden');
          if (floatingTextBar) floatingTextBar.classList.add('hidden');
          return;
        }
        const s = state.stagedText;
        const z = state.zoom;
        const bmp = s.bitmap;

        previewCtx.clearRect(0, 0, state.width, state.height);
        previewCtx.imageSmoothingEnabled = false;
        previewCtx.drawImage(bmp.canvas, s.x, s.y);

        if (textDragBox) {
          textDragBox.style.left = `${s.x * z}px`;
          textDragBox.style.top = `${s.y * z}px`;
          textDragBox.style.width = `${bmp.w * z}px`;
          textDragBox.style.height = `${bmp.h * z}px`;
          textDragBox.classList.remove('hidden');
        }

        if (floatingTextBar) floatingTextBar.classList.remove('hidden');
      }

      function stageText(txt, sz, font, th, kern) {
        if (!txt) return;
        const bmp = generatePixelTextBitmap(txt, sz, font, th, kern, state.fgColor);
        if (!bmp) return;

        const posX = Math.max(0, Math.min(state.width - bmp.w, state.pendingStampX));
        const posY = Math.max(0, Math.min(state.height - bmp.h, state.pendingStampY));

        state.stagedText = {
          text: txt,
          size: sz,
          font: font,
          thickness: th,
          kerning: kern,
          x: posX,
          y: posY,
          bitmap: bmp
        };

        updateStagedTextDisplay();
        statusHint.textContent = 'Drag text to position. Tap ✓ Stamp Down when ready!';
      }

      function commitStagedText() {
        if (!state.stagedText || !state.stagedText.bitmap) return;
        const s = state.stagedText;
        const targetCtx = getActiveLayerCtx();
        targetCtx.imageSmoothingEnabled = false;
        targetCtx.drawImage(s.bitmap.canvas, s.x, s.y);
        compositeLayers();
        previewCtx.clearRect(0, 0, state.width, state.height);
        state.stagedText = null;
        if (textDragBox) textDragBox.classList.add('hidden');
        if (floatingTextBar) floatingTextBar.classList.add('hidden');
        saveHistoryState();
        statusHint.textContent = 'Stamped crisp pixel text to active layer.';
      }

      function cancelStagedText() {
        previewCtx.clearRect(0, 0, state.width, state.height);
        state.stagedText = null;
        if (textDragBox) textDragBox.classList.add('hidden');
        if (floatingTextBar) floatingTextBar.classList.add('hidden');
      }

      function onTextDragDown(e) {
        e.stopPropagation();
        e.preventDefault();
        if (!state.stagedText) return;

        const clientX = e.clientX !== undefined ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
        const clientY = e.clientY !== undefined ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);

        const startX = clientX;
        const startY = clientY;
        const origX = state.stagedText.x;
        const origY = state.stagedText.y;

        const onMove = (ev) => {
          const cx = ev.clientX !== undefined ? ev.clientX : (ev.touches && ev.touches[0] ? ev.touches[0].clientX : 0);
          const cy = ev.clientY !== undefined ? ev.clientY : (ev.touches && ev.touches[0] ? ev.touches[0].clientY : 0);

          const dx = Math.round((cx - startX) / state.zoom);
          const dy = Math.round((cy - startY) / state.zoom);

          state.stagedText.x = Math.max(-state.stagedText.bitmap.w + 1, Math.min(state.width - 1, origX + dx));
          state.stagedText.y = Math.max(-state.stagedText.bitmap.h + 1, Math.min(state.height - 1, origY + dy));

          updateStagedTextDisplay();
        };

        const onUp = () => {
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
          window.removeEventListener('touchmove', onMove);
          window.removeEventListener('touchend', onUp);
        };

        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
        window.addEventListener('touchmove', onMove, { passive: false });
        window.addEventListener('touchend', onUp, { passive: false });
      }

      if (textDragBox) {
        textDragBox.addEventListener('pointerdown', onTextDragDown);
        textDragBox.addEventListener('touchstart', onTextDragDown, { passive: false });
      }

      if (btnCommitText) btnCommitText.addEventListener('click', commitStagedText);
      if (btnCancelText) btnCancelText.addEventListener('click', cancelStagedText);
      if (btnEditStagedText) {
        btnEditStagedText.addEventListener('click', () => {
          if (state.stagedText) {
            inputStampText.value = state.stagedText.text;
            inputStampSize.value = state.stagedText.size;
            if (inputStampSizeNum) inputStampSizeNum.value = state.stagedText.size;
            labelStampSize.textContent = `${state.stagedText.size}px`;
            inputStampKerning.value = state.stagedText.kerning;
            labelStampKerning.textContent = `${state.stagedText.kerning}px`;
            selectStampFont.value = state.stagedText.font;
            state.textThickness = state.stagedText.thickness;
            labelStampThickness.textContent = `${state.stagedText.thickness}px`;
            document.querySelectorAll('.btn-text-thick').forEach(b => {
              const th = parseInt(b.dataset.thickness, 10);
              if (th === state.textThickness) {
                b.className = 'btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-blue-100 text-blue-900 border border-blue-500 cursor-pointer';
              } else {
                b.className = 'btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-gray-100 text-gray-800 cursor-pointer';
              }
            });
          }
          modalTextStamp.classList.remove('hidden');
          updateModalTextPreview();
        });
      }

      // Modal Formatting Inputs Listeners
      if (inputStampText) inputStampText.addEventListener('input', updateModalTextPreview);
      if (inputStampSize) {
        inputStampSize.addEventListener('input', (e) => {
          const val = Math.min(200, Math.max(6, parseInt(e.target.value, 10) || 12));
          if (labelStampSize) labelStampSize.textContent = `${val}px`;
          if (inputStampSizeNum) inputStampSizeNum.value = val;
          updateModalTextPreview();
        });
      }
      if (inputStampSizeNum) {
        inputStampSizeNum.addEventListener('input', (e) => {
          const val = Math.min(200, Math.max(6, parseInt(e.target.value, 10) || 12));
          if (inputStampSize) inputStampSize.value = val;
          if (labelStampSize) labelStampSize.textContent = `${val}px`;
          updateModalTextPreview();
        });
      }
      if (inputStampKerning) {
        inputStampKerning.addEventListener('input', (e) => {
          labelStampKerning.textContent = `${e.target.value}px`;
          updateModalTextPreview();
        });
      }
      if (selectStampFont) selectStampFont.addEventListener('change', updateModalTextPreview);

      document.querySelectorAll('.btn-text-thick').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const th = parseInt(btn.dataset.thickness, 10);
          state.textThickness = th;
          if (labelStampThickness) labelStampThickness.textContent = `${th}px`;
          document.querySelectorAll('.btn-text-thick').forEach(b => {
            b.className = 'btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-gray-100 text-gray-800 cursor-pointer';
          });
          btn.className = 'btn-text-thick bevel-raised flex-1 py-1 font-bold text-[10px] bg-blue-100 text-blue-900 border border-blue-500 cursor-pointer';
          updateModalTextPreview();
        });
      });

      if (btnApplyStampText) {
        btnApplyStampText.addEventListener('click', () => {
          const txt = inputStampText.value.trim();
          if (txt) {
            const sz = parseInt(inputStampSize.value, 10) || 12;
            const th = state.textThickness || 1;
            const kern = parseInt(inputStampKerning.value, 10) || 0;
            const font = selectStampFont.value || 'monospace';
            modalTextStamp.classList.add('hidden');
            stageText(txt, sz, font, th, kern);
          }
        });
      }

      if (btnCancelStampText) btnCancelStampText.addEventListener('click', () => modalTextStamp.classList.add('hidden'));
      if (btnCloseTextModal) btnCloseTextModal.addEventListener('click', () => modalTextStamp.classList.add('hidden'));

      // --- Selection Feature (Copy, Move, Cut) ---
      function createSelection(x, y, w, h) {
        state.selection = {
          x, y, w, h,
          imgData: getActiveLayerCtx().getImageData(x, y, w, h)
        };
        updateSelectionBoxDisplay();
      }

      // Attach Canvas Events
      paintCanvas.addEventListener('dblclick', (e) => {
        if (state.tool === 'polygon') {
          finishPolygon();
        }
      });
      paintCanvas.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);

      // --- Multi-Touch Pan & Pinch-to-Zoom Engine ---
      const touchState = {
        isPinching: false,
        startDist: 0,
        startZoom: 8,
        startMidX: 0,
        startMidY: 0,
        startPanX: 0,
        startPanY: 0,
        isBgPanning: false,
        bgPanStartX: 0,
        bgPanStartY: 0,
        bgPanStartPanX: 0,
        bgPanStartPanY: 0,
        gestureEndedAt: 0,
        tapCandidate: null
      };

      function executeTapTool(cand) {
        if (state.stagedShape) commitStagedShape();
        if (state.stagedText) commitStagedText();
        if (state.selectionMoving) commitMoveSelection();

        const activeColor = state.mouseButton === 2 ? state.bgColor : state.fgColor;

        if (cand.tool === 'fill') {
          floodFill(cand.x, cand.y, activeColor);
        } else if (cand.tool === 'picker') {
          pickColorAt(cand.x, cand.y, false);
        } else if (cand.tool === 'text') {
          state.pendingStampX = cand.x;
          state.pendingStampY = cand.y;
          modalTextStamp.classList.remove('hidden');
          updateModalTextPreview();
          inputStampText.focus();
        } else if (cand.tool === 'magic-select') {
          clearSelectionBox();
          performMagicSelect(cand.x, cand.y);
        } else if (cand.tool === 'zoom') {
          const next = zoomPresets.find(z => z > state.zoom * 1.05);
          setZoom(next !== undefined ? next : Math.min(32, state.zoom * 2));
        }
      }

      canvasContainer.addEventListener('touchstart', (e) => {
        if (e.touches.length >= 2) {
          e.preventDefault();
          touchState.tapCandidate = null;
          if (state.isDrawing) {
            state.isDrawing = false;
            if (state.historyIndex >= 0 && state.history[state.historyIndex]) {
              restoreHistoryState(state.history[state.historyIndex]);
            }
            previewCtx.clearRect(0, 0, state.width, state.height);
          }

          touchState.isBgPanning = false;
          touchState.isPinching = true;
          const t1 = e.touches[0];
          const t2 = e.touches[1];
          touchState.startDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
          touchState.startZoom = state.zoom;
          touchState.startMidX = (t1.clientX + t2.clientX) / 2;
          touchState.startMidY = (t1.clientY + t2.clientY) / 2;
          touchState.startPanX = state.panX;
          touchState.startPanY = state.panY;
          return;
        }

        if (Date.now() - touchState.gestureEndedAt < 300) {
          e.preventDefault();
          touchState.tapCandidate = null;
          return;
        }

        // Don't intercept touches on selection box, badge, move bar, or text drag box
        if (e.target.closest('#layers-control-container') || e.target.closest('#quick-color-container') || e.target.closest('#floating-shape-bar') || e.target.closest('.shape-handle') || e.target.closest('#selection-box') || e.target.closest('#floating-move-bar') || e.target.closest('#btn-selection-edit') || e.target.closest('#text-drag-box') || e.target.closest('#floating-text-bar')) {
          touchState.tapCandidate = null;
          return;
        }

        if (e.target === paintCanvas || paintCanvas.contains(e.target)) {
          touchState.isBgPanning = false;
          e.preventDefault();

          // Single-finger tap only tools: Fill, Color Picker, Text, Magic Select, Zoom
          // These MUST NOT trigger immediately on 2-finger pinch/pan gestures!
          if (['fill', 'picker', 'text', 'magic-select', 'zoom'].includes(state.tool)) {
            const coords = getCanvasCoordinates(e);
            const t = e.touches[0];
            touchState.tapCandidate = {
              x: coords.x,
              y: coords.y,
              clientX: t.clientX,
              clientY: t.clientY,
              tool: state.tool,
              time: Date.now()
            };
            return;
          }

          onPointerDown(e);
        } else {
          touchState.isBgPanning = true;
          touchState.bgPanStartX = e.touches[0].clientX;
          touchState.bgPanStartY = e.touches[0].clientY;
          touchState.bgPanStartPanX = state.panX;
          touchState.bgPanStartPanY = state.panY;
        }
      }, { passive: false });

      window.addEventListener('touchmove', (e) => {
        if (e.touches.length >= 2) {
          e.preventDefault();
          touchState.tapCandidate = null; // Instantly cancel any tap on 2-finger gesture!
          if (!touchState.isPinching) {
            if (state.isDrawing) {
              state.isDrawing = false;
              if (state.historyIndex >= 0 && state.history[state.historyIndex]) {
                restoreHistoryState(state.history[state.historyIndex]);
              }
              previewCtx.clearRect(0, 0, state.width, state.height);
            }
            touchState.isPinching = true;
            touchState.isBgPanning = false;
            const t1 = e.touches[0];
            const t2 = e.touches[1];
            touchState.startDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
            touchState.startZoom = state.zoom;
            touchState.startMidX = (t1.clientX + t2.clientX) / 2;
            touchState.startMidY = (t1.clientY + t2.clientY) / 2;
            touchState.startPanX = state.panX;
            touchState.startPanY = state.panY;
            return;
          }

          const t1 = e.touches[0];
          const t2 = e.touches[1];
          const currentDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
          const currentMidX = (t1.clientX + t2.clientX) / 2;
          const currentMidY = (t1.clientY + t2.clientY) / 2;

          const deltaMidX = currentMidX - touchState.startMidX;
          const deltaMidY = currentMidY - touchState.startMidY;
          state.panX = touchState.startPanX + deltaMidX;
          state.panY = touchState.startPanY + deltaMidY;

          if (touchState.startDist > 0) {
            const scale = currentDist / touchState.startDist;
            const targetZoom = Math.max(0.01, Math.min(32, touchState.startZoom * scale));
            if (targetZoom !== state.zoom) {
              zoomAtPoint(targetZoom, currentMidX, currentMidY);
              touchState.startDist = currentDist;
              touchState.startZoom = state.zoom;
              touchState.startMidX = currentMidX;
              touchState.startMidY = currentMidY;
              touchState.startPanX = state.panX;
              touchState.startPanY = state.panY;
            } else {
              updateCanvasTransform();
            }
          } else {
            updateCanvasTransform();
          }
          return;
        }

        // Cancel tap candidate if single finger moved > 8px (it is a drag or pan, not a tap)
        if (touchState.tapCandidate && e.touches.length === 1) {
          const dist = Math.hypot(e.touches[0].clientX - touchState.tapCandidate.clientX, e.touches[0].clientY - touchState.tapCandidate.clientY);
          if (dist > 8) {
            touchState.tapCandidate = null;
          }
        }

        if (touchState.isBgPanning && e.touches.length === 1) {
          e.preventDefault();
          const dx = e.touches[0].clientX - touchState.bgPanStartX;
          const dy = e.touches[0].clientY - touchState.bgPanStartY;
          state.panX = touchState.bgPanStartPanX + dx;
          state.panY = touchState.bgPanStartPanY + dy;
          updateCanvasTransform();
          return;
        }

        if (touchState.isPinching) {
          e.preventDefault();
          return;
        }

        if (state.isDrawing) {
          e.preventDefault();
        }
        onPointerMove(e);
      }, { passive: false });

      window.addEventListener('touchend', (e) => {
        if (touchState.isPinching) {
          e.preventDefault();
          touchState.tapCandidate = null;
          if (e.touches.length === 0) {
            touchState.isPinching = false;
            touchState.gestureEndedAt = Date.now();
          }
          return;
        }

        if (Date.now() - touchState.gestureEndedAt < 300) {
          touchState.tapCandidate = null;
        }

        if (touchState.isBgPanning) {
          touchState.isBgPanning = false;
          touchState.tapCandidate = null;
          return;
        }

        // Execute single-finger tap for Fill, Color Picker, Text, Magic Select, Zoom
        if (touchState.tapCandidate) {
          const cand = touchState.tapCandidate;
          touchState.tapCandidate = null;
          executeTapTool(cand);
          return;
        }

        if (state.isDrawing) {
          e.preventDefault();
        }
        onPointerUp(e);
      }, { passive: false });

      window.addEventListener('touchcancel', (e) => {
        touchState.isPinching = false;
        touchState.isBgPanning = false;
        touchState.gestureEndedAt = Date.now();
        touchState.tapCandidate = null;
        if (state.isDrawing) {
          e.preventDefault();
        }
        onPointerUp(e);
      }, { passive: false });

      // Trackpad pinch-to-zoom & mouse wheel pan
      canvasContainer.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (e.ctrlKey || e.metaKey) {
          const factor = e.deltaY < 0 ? 1.25 : 0.8;
          const newZoom = Math.max(0.01, Math.min(32, state.zoom * factor));
          zoomAtPoint(newZoom, e.clientX, e.clientY);
        } else {
          state.panX -= e.deltaX;
          state.panY -= e.deltaY;
          updateCanvasTransform();
        }
      }, { passive: false });

      // --- Keyboard Shortcuts ---
      window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;

        const key = e.key.toLowerCase();

        if (state.selectionMoving && e.key === 'Enter') {
          e.preventDefault();
          commitMoveSelection();
          return;
        } else if (state.selectionMoving && e.key === 'Escape') {
          e.preventDefault();
          cancelMoveSelection();
          return;
        }

        if ((e.ctrlKey || e.metaKey) && key === 'z') {
          e.preventDefault();
          undo();
        } else if (((e.ctrlKey || e.metaKey) && key === 'y') || ((e.ctrlKey || e.metaKey) && e.shiftKey && key === 'z')) {
          e.preventDefault();
          redo();
        } else if ((e.ctrlKey || e.metaKey) && key === 's') {
          e.preventDefault();
          downloadCanvasPNG(1);
        } else if ((e.ctrlKey || e.metaKey) && key === 'a') {
          e.preventDefault();
          createSelection(0, 0, state.width, state.height);
        } else if ((e.ctrlKey || e.metaKey) && key === 'v') {
          if (localCopiedData) {
            e.preventDefault();
            pasteImageData(localCopiedData);
          }
        } else if ((e.ctrlKey || e.metaKey) && key === 'c') {
          if (state.selection) {
            e.preventDefault();
            localCopiedData = state.selection.imgData;
            statusHint.textContent = `Copied selection (${state.selection.w} x ${state.selection.h} px).`;
          }
        } else if ((e.ctrlKey || e.metaKey) && key === 'x') {
          if (state.selection) {
            e.preventDefault();
            localCopiedData = state.selection.imgData;
            eraseSelection();
            statusHint.textContent = 'Cut selection to clipboard.';
          }
        } else if (key === 'p') {
          selectTool('pencil');
        } else if (key === 'l') {
          selectTool('line');
        } else if (key === 'e') {
          selectTool('eraser');
        } else if (key === 'f') {
          selectTool('fill');
        } else if (key === 'b') {
          selectTool('brush');
        } else if (key === 'i') {
          selectTool('picker');
        } else if (key === 'z') {
          selectTool('zoom');
        } else if (key === 'r') {
          selectTool('rect');
        } else if (key === 'c') {
          selectTool('ellipse');
        } else if (key === 's') {
          selectTool('select');
        } else if (key === 'x') {
          btnSwapFgBg.click();
        } else if (key === 'g') {
          document.getElementById('action-toggle-grid').click();
        }
      });

      function selectTool(toolName) {
        const btn = toolbox.querySelector(`[data-tool="${toolName}"]`);
        if (btn) btn.click();
      }

      // --- Transformations ---
      function flipHorizontal() {
        const target = getActiveLayer();
        const temp = document.createElement('canvas');
        temp.width = state.width;
        temp.height = state.height;
        const tctx = temp.getContext('2d');
        tctx.drawImage(target.canvas, 0, 0);

        target.ctx.clearRect(0, 0, state.width, state.height);
        target.ctx.save();
        target.ctx.scale(-1, 1);
        target.ctx.drawImage(temp, -state.width, 0);
        target.ctx.restore();
        compositeLayers();
        saveHistoryState();
      }

      function flipVertical() {
        const target = getActiveLayer();
        const temp = document.createElement('canvas');
        temp.width = state.width;
        temp.height = state.height;
        const tctx = temp.getContext('2d');
        tctx.drawImage(target.canvas, 0, 0);

        target.ctx.clearRect(0, 0, state.width, state.height);
        target.ctx.save();
        target.ctx.scale(1, -1);
        target.ctx.drawImage(temp, 0, -state.height);
        target.ctx.restore();
        compositeLayers();
        saveHistoryState();
      }

      function rotate90Clockwise() {
        const newW = state.height;
        const newH = state.width;

        state.layers.forEach(l => {
          const temp = document.createElement('canvas');
          temp.width = state.width;
          temp.height = state.height;
          temp.getContext('2d').drawImage(l.canvas, 0, 0);

          l.canvas.width = newW;
          l.canvas.height = newH;
          l.ctx.imageSmoothingEnabled = false;
          l.ctx.save();
          l.ctx.translate(newW, 0);
          l.ctx.rotate(Math.PI / 2);
          l.ctx.drawImage(temp, 0, 0);
          l.ctx.restore();
        });

        state.width = newW;
        state.height = newH;
        paintCanvas.width = newW;
        paintCanvas.height = newH;
        previewCanvas.width = newW;
        previewCanvas.height = newH;
        gridCanvas.width = newW;
        gridCanvas.height = newH;

        compositeLayers();
        updateCanvasDisplaySize();
        drawGrid();
        saveHistoryState();
        statusDimensions.textContent = `${state.width} x ${state.height} px`;
      }

      function invertColors() {
        const targetCtx = getActiveLayerCtx();
        const imgData = targetCtx.getImageData(0, 0, state.width, state.height);
        const data = imgData.data;
        for (let i = 0; i < data.length; i += 4) {
          data[i] = 255 - data[i];
          data[i + 1] = 255 - data[i + 1];
          data[i + 2] = 255 - data[i + 2];
        }
        targetCtx.putImageData(imgData, 0, 0);
        compositeLayers();
        saveHistoryState();
      }

      // --- File Download & Export ---
      function downloadCanvasPNG(scale = 1) {
        const outCanvas = document.createElement('canvas');
        outCanvas.width = state.width * scale;
        outCanvas.height = state.height * scale;
        const octx = outCanvas.getContext('2d');
        octx.imageSmoothingEnabled = false;

        octx.drawImage(paintCanvas, 0, 0, outCanvas.width, outCanvas.height);

        const link = document.createElement('a');
        link.download = `pixel-art-${state.width}x${state.height}${scale > 1 ? '-' + scale + 'x' : ''}.png`;
        link.href = outCanvas.toDataURL('image/png');
        link.click();
      }

      // File Opening
      fileInputImage.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const targetW = Math.min(4096, img.width);
            const targetH = Math.min(4096, img.height);
            resizeCanvas(targetW, targetH, 'transparent', false);
            const targetCtx = getActiveLayerCtx();
            targetCtx.imageSmoothingEnabled = false;
            targetCtx.drawImage(img, 0, 0, targetW, targetH);
            compositeLayers();
            saveHistoryState();
            resetView();
            statusHint.textContent = `Opened image (${targetW} x ${targetH} px)`;
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
        fileInputImage.value = '';
      });

      // --- Menu Action Handlers (All Auto-Close Overlays) ---
      document.getElementById('action-new').addEventListener('click', () => {
        closeAllOverlays();
        modalCanvasSize.classList.remove('hidden');
      });

      document.getElementById('action-open').addEventListener('click', () => {
        closeAllOverlays();
        fileInputImage.click();
      });

      document.getElementById('action-save').addEventListener('click', () => {
        closeAllOverlays();
        downloadCanvasPNG(1);
      });

      document.getElementById('action-export-upscaled').addEventListener('click', () => {
        closeAllOverlays();
        modalExport.classList.remove('hidden');
        updateExportCalc();
      });

      document.getElementById('action-clear-canvas').addEventListener('click', () => {
        closeAllOverlays();
        const targetCtx = getActiveLayerCtx();
        targetCtx.fillStyle = state.bgColor;
        targetCtx.fillRect(0, 0, state.width, state.height);
        compositeLayers();
        saveHistoryState();
      });

      document.getElementById('action-undo').addEventListener('click', () => {
        closeAllOverlays();
        undo();
      });

      document.getElementById('action-redo').addEventListener('click', () => {
        closeAllOverlays();
        redo();
      });

      document.getElementById('action-zoom-fit').addEventListener('click', () => { closeAllOverlays(); resetView(); });
      document.getElementById('action-zoom-5').addEventListener('click', () => { closeAllOverlays(); setZoom(0.05); });
      document.getElementById('action-zoom-10').addEventListener('click', () => { closeAllOverlays(); setZoom(0.1); });
      document.getElementById('action-zoom-25').addEventListener('click', () => { closeAllOverlays(); setZoom(0.25); });
      document.getElementById('action-zoom-50').addEventListener('click', () => { closeAllOverlays(); setZoom(0.5); });
      document.getElementById('action-zoom-100').addEventListener('click', () => { closeAllOverlays(); setZoom(1); });
      document.getElementById('action-zoom-200').addEventListener('click', () => { closeAllOverlays(); setZoom(2); });
      document.getElementById('action-zoom-400').addEventListener('click', () => { closeAllOverlays(); setZoom(4); });
      document.getElementById('action-zoom-800').addEventListener('click', () => { closeAllOverlays(); setZoom(8); });
      document.getElementById('action-zoom-1600').addEventListener('click', () => { closeAllOverlays(); setZoom(16); });
      document.getElementById('action-zoom-3200').addEventListener('click', () => { closeAllOverlays(); setZoom(32); });

      document.getElementById('action-flip-h').addEventListener('click', () => { closeAllOverlays(); flipHorizontal(); });
      document.getElementById('action-flip-v').addEventListener('click', () => { closeAllOverlays(); flipVertical(); });
      document.getElementById('action-rotate-90').addEventListener('click', () => { closeAllOverlays(); rotate90Clockwise(); });
      document.getElementById('action-invert').addEventListener('click', () => { closeAllOverlays(); invertColors(); });
      document.getElementById('action-resize-dialog').addEventListener('click', () => { closeAllOverlays(); modalCanvasSize.classList.remove('hidden'); });

      document.getElementById('action-edit-colors').addEventListener('click', () => {
        closeAllOverlays();
        nativeColorPicker.click();
      });

      document.getElementById('action-swap-colors').addEventListener('click', () => {
        closeAllOverlays();
        btnSwapFgBg.click();
      });

      document.getElementById('action-help-about').addEventListener('click', () => {
        closeAllOverlays();
        modalHelp.classList.remove('hidden');
      });

      document.getElementById('action-select-all').addEventListener('click', () => {
        closeAllOverlays();
        createSelection(0, 0, state.width, state.height);
      });

      let localCopiedData = null;

      document.getElementById('action-copy').addEventListener('click', () => {
        closeAllOverlays();
        if (state.selection) {
          localCopiedData = state.selection.imgData;
        }
      });

      document.getElementById('action-cut').addEventListener('click', () => {
        closeAllOverlays();
        if (state.selection) {
          localCopiedData = state.selection.imgData;
          eraseSelection();
        }
      });

      document.getElementById('action-paste').addEventListener('click', () => {
        closeAllOverlays();
        if (localCopiedData) {
          pasteImageData(localCopiedData);
        } else {
          statusHint.textContent = 'Clipboard is empty. Copy a selection first or paste an image from your clipboard (Ctrl+V).';
        }
      });

      // --- Modals Logic ---
      modalCanvasSize.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          modalCanvasSize.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('bg-blue-100'));
          btn.classList.add('bg-blue-100');
          inputCanvasWidth.value = btn.dataset.w;
          inputCanvasHeight.value = btn.dataset.h;
        });
      });

      btnApplyCanvasSize.addEventListener('click', () => {
        const w = parseInt(inputCanvasWidth.value, 10);
        const h = parseInt(inputCanvasHeight.value, 10);
        const bgType = selectCanvasBg.value;
        let bg = '#ffffff';
        if (bgType === 'transparent') bg = 'transparent';
        else if (bgType === 'black') bg = '#000000';
        else if (bgType === 'current') bg = state.bgColor;

        if (w >= 4 && h >= 4 && w <= 4096 && h <= 4096) {
          resizeCanvas(w, h, bg, false);
          resetView();
          modalCanvasSize.classList.add('hidden');
        }
      });

      btnCancelCanvasSize.addEventListener('click', () => modalCanvasSize.classList.add('hidden'));
      btnCloseCanvasModal.addEventListener('click', () => modalCanvasSize.classList.add('hidden'));

      function updateExportCalc() {
        const expW = state.width * currentExportScale;
        const expH = state.height * currentExportScale;
        exportCalcDimensions.textContent = `${expW} x ${expH} px (${currentExportScale}x)`;
      }

      modalExport.querySelectorAll('.scale-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          modalExport.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('bg-blue-100', 'font-bold'));
          btn.classList.add('bg-blue-100', 'font-bold');
          currentExportScale = parseInt(btn.dataset.scale, 10);
          updateExportCalc();
        });
      });

      btnDownloadExportPng.addEventListener('click', () => {
        downloadCanvasPNG(currentExportScale);
        modalExport.classList.add('hidden');
      });

      btnCancelExport.addEventListener('click', () => modalExport.classList.add('hidden'));
      btnCloseExportModal.addEventListener('click', () => modalExport.classList.add('hidden'));

      btnCloseHelpModal.addEventListener('click', () => modalHelp.classList.add('hidden'));
      btnOkHelp.addEventListener('click', () => modalHelp.classList.add('hidden'));

      // Window Frame buttons
      document.getElementById('btn-win-close').addEventListener('click', () => {
        const targetCtx = getActiveLayerCtx();
        if (state.activeLayerIndex === 0) {
          targetCtx.fillStyle = state.bgColor;
          targetCtx.fillRect(0, 0, state.width, state.height);
        } else {
          targetCtx.clearRect(0, 0, state.width, state.height);
        }
        compositeLayers();
        saveHistoryState();
      });

      document.getElementById('btn-win-min').addEventListener('click', () => {
        setZoom(1);
      });

      document.getElementById('btn-win-max').addEventListener('click', () => {
        resetView();
      });

      // --- Initial Setup: Ensure exact standard presets: Black, White, Red, Yellow, Blue ---
      state.presetColors = ['#000000', '#ffffff', '#ff0000', '#ffff00', '#0000ff'];
      try {
        localStorage.removeItem('pixel_paint_presets');
      } catch (e) {}
      if (btnResetPresets) {
        btnResetPresets.addEventListener('click', () => {
          state.presetColors = ['#000000', '#ffffff', '#ff0000', '#ffff00', '#0000ff'];
          state.selectedPresetIndex = 0;
          state.fgColor = '#000000';
          state.editingPresetIndex = null;
          try {
            localStorage.removeItem('pixel_paint_presets');
          } catch (e) {}
          updateColorDisplay();
          statusHint.textContent = 'Presets reset to Black, White, Red, Yellow, Blue.';
        });
      }

      // Quick Color Bar Listeners
      quickColorSwap.addEventListener('click', (e) => {
        e.stopPropagation();
        const tmp = state.fgColor;
        state.fgColor = state.bgColor;
        state.bgColor = tmp;
        updateColorDisplay();
      });

      presetButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.dataset.index, 10);
          onPresetClick(idx);
        });
      });

      // --- Staged Shape Handle Dragging & Controls ---
      if (btnCommitShape) btnCommitShape.addEventListener('click', commitStagedShape);
      if (btnCancelShape) btnCancelShape.addEventListener('click', cancelStagedShape);

      const shapeHandles = [handle0, handle1, handle2, handle3];
      shapeHandles.forEach((handleEl, idx) => {
        if (!handleEl) return;
        const onHandleDown = (e) => {
          e.stopPropagation();
          e.preventDefault();
          if (!state.stagedShape) return;
          state.draggingHandleIndex = idx;

          const onHandleMove = (ev) => {
            if (state.draggingHandleIndex === null || !state.stagedShape) return;
            const coords = getCanvasCoordinates(ev);
            const s = state.stagedShape;

            if (idx === 0) s.p0 = { x: coords.x, y: coords.y };
            else if (idx === 1) s.p1 = { x: coords.x, y: coords.y };
            else if (idx === 2 && s.p2) s.p2 = { x: coords.x, y: coords.y };
            else if (idx === 3 && s.p3) s.p3 = { x: coords.x, y: coords.y };

            renderStagedShape();
            updateShapeHandles();
            if (s.p0 && s.p1) {
              showLiveDimension(s.p0.x, s.p0.y, s.p1.x, s.p1.y);
            }
          };

          const onHandleUp = () => {
            state.draggingHandleIndex = null;
            window.removeEventListener('pointermove', onHandleMove);
            window.removeEventListener('pointerup', onHandleUp);
            window.removeEventListener('touchmove', onHandleMove);
            window.removeEventListener('touchend', onHandleUp);
          };

          window.addEventListener('pointermove', onHandleMove);
          window.addEventListener('pointerup', onHandleUp);
          window.addEventListener('touchmove', onHandleMove, { passive: false });
          window.addEventListener('touchend', onHandleUp, { passive: false });
        };

        handleEl.addEventListener('pointerdown', onHandleDown);
        handleEl.addEventListener('touchstart', onHandleDown, { passive: false });
      });

      // --- Layers Panel Controls ---
      if (btnToggleLayers) {
        btnToggleLayers.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = layersPanel.classList.contains('hidden');
          if (isHidden) {
            layersPanel.classList.remove('hidden');
            if (layersArrow) layersArrow.textContent = '▲';
            renderLayersList();
          } else {
            layersPanel.classList.add('hidden');
            if (layersArrow) layersArrow.textContent = '▼';
          }
        });
      }

      if (btnCloseLayersPanel) {
        btnCloseLayersPanel.addEventListener('click', () => {
          if (layersPanel) layersPanel.classList.add('hidden');
          if (layersArrow) layersArrow.textContent = '▼';
        });
      }

      if (btnLayerAdd) btnLayerAdd.addEventListener('click', addLayer);
      if (btnLayerDelete) btnLayerDelete.addEventListener('click', deleteLayer);
      if (btnLayerMergeDown) btnLayerMergeDown.addEventListener('click', mergeDown);
      if (btnLayerMergeAll) btnLayerMergeAll.addEventListener('click', mergeAll);

      if (layerOpacitySlider) {
        layerOpacitySlider.addEventListener('input', (e) => {
          const l = getActiveLayer();
          if (l) {
            l.opacity = parseInt(e.target.value, 10) / 100;
            if (layerOpacityVal) layerOpacityVal.textContent = `${e.target.value}%`;
            compositeLayers();
          }
        });
        layerOpacitySlider.addEventListener('change', () => {
          saveHistoryState();
        });
      }

      // Layer Rename Modal Handlers
      if (btnApplyLayerName) {
        btnApplyLayerName.addEventListener('click', () => {
          const newName = inputLayerName.value.trim();
          if (newName && state.renamingLayerIndex !== null && state.layers[state.renamingLayerIndex]) {
            state.layers[state.renamingLayerIndex].name = newName;
            renderLayersList();
          }
          if (modalLayerRename) modalLayerRename.classList.add('hidden');
          state.renamingLayerIndex = null;
        });
      }

      if (btnCancelLayerName) {
        btnCancelLayerName.addEventListener('click', () => {
          if (modalLayerRename) modalLayerRename.classList.add('hidden');
          state.renamingLayerIndex = null;
        });
      }

      if (btnCloseRenameModal) {
        btnCloseRenameModal.addEventListener('click', () => {
          if (modalLayerRename) modalLayerRename.classList.add('hidden');
          state.renamingLayerIndex = null;
        });
      }

      initPalette();
      updateColorDisplay();
      updateBottomToolLabel();
      renderToolOptions();
      resizeCanvas(64, 64, '#ffffff', false);

